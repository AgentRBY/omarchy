#!/bin/bash

# omarchy:summary=Install T3 Code and point it at the Omarchy palette
# omarchy:args=[stable|nightly]
# omarchy:requires-sudo=true

set -e

T3CODE_HOME="${T3CODE_HOME:-$HOME/.t3}"
T3CODE_STATE_DIR="$T3CODE_HOME/userdata"
T3CODE_APPIMAGE="$HOME/.local/share/t3code/T3-Code.AppImage"

# The app's own `t3` launcher appears only after its first launch, so run the
# bundled CLI from the mounted AppImage the same way that launcher does.
t3_cli() {
  local work mount="" mounter status=0
  work=$(mktemp -d)
  "$T3CODE_APPIMAGE" --appimage-mount >"$work/mount" 2>/dev/null &
  mounter=$!
  # The runtime prints its mount point, then stays mounted until killed.
  while kill -0 "$mounter" 2>/dev/null; do
    mount=$(head -n 1 "$work/mount")
    [[ -d $mount ]] && break
    mount=""
    sleep 0.05
  done
  if [[ -n $mount ]]; then
    ELECTRON_RUN_AS_NODE=1 "$mount/t3code" "$mount/resources/app.asar/apps/server/dist/bin.mjs" "$@" || status=$?
  else
    echo "Could not open $T3CODE_APPIMAGE." >&2
    status=1
  fi
  kill "$mounter" 2>/dev/null || true
  wait "$mounter" 2>/dev/null || true
  rm -rf "$work"
  return "$status"
}

channel=${1:-}
if [[ -z $channel ]]; then
  stable=$(omarchy-i18n t3code.stable)
  nightly=$(omarchy-i18n t3code.nightly)
  choice=$(gum choose --header "$(omarchy-i18n t3code.selectChannel)" "$stable" "$nightly")
  if [[ $choice == "$nightly" ]]; then
    channel="nightly"
  else
    channel="stable"
  fi
fi

echo "Installing T3 Code..."
omarchy-install-t3code-app "$channel"

echo "Matching T3 Code to the current theme..."
mkdir -p "$T3CODE_STATE_DIR"

# An updated user's current theme may have been staged before this template existed.
if [[ ! -f $HOME/.local/state/omarchy/current/theme/t3code.json ]]; then
  omarchy-theme-refresh
fi

omarchy-theme-set-t3code

# Selects the published palette before the app's first launch.
t3_cli theme set omarchy --base-dir "$T3CODE_HOME"

echo "Opening T3 Code..."
setsid uwsm-app -- gtk-launch t3code >/dev/null 2>&1 &

echo ""
echo "T3 Code has been installed. It updates itself; switch between Stable and Nightly in its settings."
