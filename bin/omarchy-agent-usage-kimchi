#!/usr/bin/python3
# omarchy:summary=Print the Kimchi usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Kimchi usage into one display-ready JSON record.

The plan, prepaid credits, and spend budgets come from the gateway endpoints
Kimchi's own status line reads (<llm base>/v1/credits and /v1/budget), asked
with the API key Kimchi signs in with. Tokens and prompts come from its pi
session files: one line per message, each assistant reply carrying its model
and token usage. The agents panel only ever reads the JSON this prints.
"""

import argparse
import fcntl
import hashlib
import http.client
import json
import math
import os
import subprocess
import tempfile
import time
import urllib.error
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

AGENT_ID = "kimchi"
AGENT_NAME = "Kimchi"
AUTH_HELP = "Start Kimchi and log in, or set KIMCHI_API_KEY."
REJECTED_HELP = "Kimchi rejected its API key. Log in again in Kimchi, or update KIMCHI_API_KEY."
REGION_LLM_BASE = {"us": "https://llm.kimchi.dev", "eu": "https://llm.eu.kimchi.dev"}
PLAN_LABELS = {"community": "Community", "coder": "Coder", "teams": "Teams", "enterprise": "Enterprise"}
BUDGET_LABELS = {
  "API_KEY": "API key budget",
  "USER": "Budget",
  "TEAM_PER_USER": "Team budget",
  "TEAM_POOLED": "Team pool",
  "ORGANIZATION_SOFT": "Org budget",
  "ORGANIZATION_HARD": "Org budget",
}
SCAN_REUSE_SECONDS = 20
# A limits-only refresh needs fresh credits, not a fresh history scan.
LIMITS_ONLY_REUSE_SECONDS = 900
# A panel opened and shut repeatedly reuses answers this recent instead of
# asking the gateway again; --force skips it.
PROBE_MIN_INTERVAL_SECONDS = 15
# A token count past this is a corrupt field, not a reply.
MAX_TOKENS = 1_000_000_000_000


def read_json(path):
  try:
    return json.loads(Path(path).read_text(encoding="utf-8"))
  except Exception:
    return None


# A temporary file of its own per write, so overlapping runs can't rename
# each other's away.
def write_json(path, payload):
  path = Path(path)
  path.parent.mkdir(parents=True, exist_ok=True)
  fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
  try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
      json.dump(payload, handle)
    os.replace(tmp, path)
  except Exception:
    Path(tmp).unlink(missing_ok=True)
    raise


def cache_root():
  root = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


# A finite, positive number, or 0: cache stamps are read as found.
def number(value):
  if isinstance(value, bool):
    return 0
  try:
    parsed = float(value or 0)
  except (TypeError, ValueError):
    return 0
  return int(parsed) if math.isfinite(parsed) and parsed > 0 else 0


# Token counts from session files are untrusted: anything but a plain,
# plausible count skips the field.
def tokens(value):
  if isinstance(value, bool) or not isinstance(value, (int, float)):
    return 0
  if not math.isfinite(value) or value <= 0 or value >= MAX_TOKENS:
    return 0
  return int(value)


# Kimchi sends dollar amounts as strings, sometimes with a sign or unit.
def usd(value):
  if isinstance(value, bool):
    return None
  if isinstance(value, (int, float)):
    parsed = float(value)
  else:
    text = str(value or "").lower().replace("$", "").replace("usd", "").replace(",", ".").strip()
    try:
      parsed = float(text) if text else None
    except ValueError:
      return None
  return parsed if parsed is not None and math.isfinite(parsed) else None


def parse_time(value):
  if not isinstance(value, str) or not value.strip():
    return None
  try:
    parsed = datetime.fromisoformat(value.strip().replace("Z", "+00:00"))
  except ValueError:
    return None
  return parsed if parsed.tzinfo else parsed.replace(tzinfo=timezone.utc)


# pi stamps entries with ISO strings and messages with epoch milliseconds.
# A stamp that isn't a plausible moment (zero, negative, NaN, far future,
# not a time at all) leaves the reply undated rather than counted as today.
def local_day(value):
  if isinstance(value, bool):
    return None
  if isinstance(value, (int, float)):
    if not math.isfinite(value) or value <= 0:
      return None
    seconds = value / 1000 if value > 10_000_000_000 else value
  else:
    parsed = parse_time(value)
    if parsed is None:
      return None
    seconds = parsed.timestamp()
  # Nothing wrote a Kimchi session before 2000, or from the future.
  if not 946_684_800 <= seconds <= time.time() + 2 * 86_400:
    return None
  try:
    return datetime.fromtimestamp(seconds).astimezone().date().isoformat()
  except (OverflowError, OSError, ValueError):
    return None


# The harness directory Kimchi keeps its sessions under: KIMCHI_CODING_AGENT_DIR
# when set, as the CLI itself reads it, else ~/.config/kimchi/harness. Kimchi
# has no profiles that move it.
def harness_dir():
  return Path(os.environ.get("KIMCHI_CODING_AGENT_DIR") or (Path.home() / ".config" / "kimchi" / "harness"))


# Listed with rg --no-ignore, since a $HOME kept as a git checkout would
# otherwise hide ~/.config from the listing. The flag says whether every
# file could be listed.
def session_files(sessions_root):
  root = Path(sessions_root)
  if not root.is_dir():
    return [], True
  try:
    listed = subprocess.run(
      ["rg", "--files", "--no-ignore", "--hidden", "--glob", "*.jsonl", str(root)],
      capture_output=True, text=True, timeout=60,
    )
  except (OSError, subprocess.TimeoutExpired):
    return [], False
  # rg exits 1 when it finds nothing, and 2 when part of the tree was
  # unreadable while still listing the rest.
  return sorted(Path(line) for line in listed.stdout.splitlines() if line), listed.returncode in (0, 1)


def empty_bucket():
  return {"inputTokens": 0, "outputTokens": 0, "cacheReadInputTokens": 0, "cacheCreationInputTokens": 0}


# Every session file under <harness>/sessions. Only assistant messages carry
# usage. A forked or resumed session repeats its parent's entries, so a reply
# with both an id and a timestamp counts once across every file; one without
# an id always counts. Returns the stats and whether every source was read.
def local_stats(sessions_root):
  now = datetime.now().astimezone()
  today = now.date().isoformat()
  week = [(now.date() - timedelta(days=offset)).isoformat() for offset in range(6, -1, -1)]
  prompts = today_prompts = today_tokens = 0
  sessions, today_sessions, days = set(), set(), set()
  by_day = {day: 0 for day in week}
  today_by_model = {}
  models = {}
  seen = set()
  files, complete = session_files(sessions_root)
  for path in files:
    try:
      lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
      complete = False
      continue
    for line in lines:
      if '"usage"' not in line:
        continue
      try:
        entry = json.loads(line)
      except ValueError:
        continue
      message = entry.get("message") if isinstance(entry, dict) and entry.get("type") == "message" else None
      if not isinstance(message, dict) or message.get("role") != "assistant":
        continue
      stamp = entry.get("timestamp") or message.get("timestamp")
      entry_id = entry.get("id")
      if entry_id and stamp:
        identity = (str(entry_id), str(stamp))
        if identity in seen:
          continue
        seen.add(identity)

      usage = message.get("usage") if isinstance(message.get("usage"), dict) else {}
      uncached = tokens(usage.get("input"))
      output = tokens(usage.get("output"))
      cached = tokens(usage.get("cacheRead"))
      created = tokens(usage.get("cacheWrite"))
      if not (uncached or output or cached or created):
        uncached = tokens(usage.get("totalTokens"))
      total = uncached + output + cached + created
      if not total:
        continue

      model = str(message.get("model") or AGENT_ID)
      prompts += 1
      sessions.add(str(path))
      totals = models.setdefault(model, empty_bucket())
      totals["inputTokens"] += uncached
      totals["outputTokens"] += output
      totals["cacheReadInputTokens"] += cached
      totals["cacheCreationInputTokens"] += created
      # An undated reply still counts in the totals, just on no day.
      day = local_day(stamp)
      if day is None:
        continue
      days.add(day)
      if day in by_day:
        by_day[day] += total
      if day == today:
        today_prompts += 1
        today_sessions.add(str(path))
        today_tokens += total
        today_by_model[model] = today_by_model.get(model, 0) + total

  return {
    "hasLocalStats": bool(sessions),
    "todayPrompts": today_prompts,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": today_tokens,
    "todayTokensByModel": today_by_model,
    "recentDays": [{"date": day, "messageCount": by_day[day]} for day in week],
    "totalPrompts": prompts,
    "totalSessions": len(sessions),
    "activeDays": len(days),
    "activeDates": sorted(days),
    "modelUsage": models,
  }, complete


# A scan is reused on the day it was made only, since one from before
# midnight would count yesterday's sessions as today's. It's rebuilt under a
# lock so overlapping refreshes scan once, and a scan that couldn't read
# every source isn't kept.
def cached_local_stats(sessions_root, max_age):
  digest = hashlib.sha256(str(sessions_root).encode()).hexdigest()[:16]
  cache = cache_root() / f"kimchi-scan-{digest}.json"
  today = datetime.now().astimezone().date().isoformat()

  def fresh():
    cached = read_json(cache)
    if not isinstance(cached, dict) or cached.get("scanDate") != today or not isinstance(cached.get("stats"), dict):
      return None
    age = time.time() - number(cached.get("scannedAt"))
    return cached["stats"] if 0 <= age < max_age else None

  stats = fresh()
  if stats is not None:
    return stats
  with (cache_root() / f"kimchi-scan-{digest}.lock").open("w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    stats = fresh()
    if stats is not None:
      return stats
    stats, complete = local_stats(sessions_root)
    if complete:
      write_json(cache, {"scanDate": today, "scannedAt": time.time(), "stats": stats})
    return stats


# The key and gateway Kimchi itself would use: KIMCHI_API_KEY, KIMCHI_BASE_URL,
# and KIMCHI_REGION over ~/.config/kimchi/config.json, the region's gateway
# when nothing names one.
def gateway():
  config = read_json(Path.home() / ".config" / "kimchi" / "config.json")
  config = config if isinstance(config, dict) else {}
  key = os.environ.get("KIMCHI_API_KEY") or config.get("apiKey") or config.get("api_key") or ""
  base = os.environ.get("KIMCHI_BASE_URL") or config.get("llmEndpoint") or ""
  if not base:
    region = os.environ.get("KIMCHI_REGION") or config.get("region")
    base = REGION_LLM_BASE.get(str(region or ""), REGION_LLM_BASE["us"])
  base = str(base).strip().rstrip("/")
  if base.lower().endswith("/openai/v1"):
    base = base[: -len("/openai/v1")]
  return str(key).strip(), base


def get_json(url, key):
  request = urllib.request.Request(url, headers={"Authorization": f"Bearer {key}", "Accept": "application/json", "User-Agent": "omarchy-agent-usage-kimchi"})
  with urllib.request.urlopen(request, timeout=8) as response:
    return json.loads(response.read())


def plan_label(raw):
  text = str(raw or "").strip().lower().replace("_", "-").replace(" ", "-")
  if text in ("community", "free", "free-tier", "free-slow"):
    return PLAN_LABELS["community"]
  if text in ("starter", "individual"):
    return PLAN_LABELS["coder"]
  if text == "team":
    return PLAN_LABELS["teams"]
  for plan in ("coder", "teams", "enterprise"):
    if text == plan or text.startswith(plan + "-"):
      return PLAN_LABELS[plan]
  return str(raw or "")


# The credits answer names the plan and what's left of the prepaid balance.
# It says how much remains but not how much was bought, so the gauge shows
# the remaining figure alone.
def credits_part(data):
  if data.get("serverless") is False:
    return {}
  tier = next((data[k] for k in ("tier", "tier_name", "tierName") if k in data), "")
  part = {"tierLabel": plan_label(tier)}
  remaining = usd(data.get("remaining"))
  if remaining is not None and remaining >= 0:
    part["balance"] = {"remaining": remaining, "funded": 0, "spent": 0, "currency": "USD", "estimated": False}
  has_credits = next((data[k] for k in ("has_credits", "hasCredits") if k in data), None)
  # The gateway throttles an account with no credits left, and with no funded
  # figure the balance gauge has no way to raise that alarm itself.
  if has_credits is False or (remaining is not None and remaining <= 0):
    part["usageStatusText"] = "Out of credits, rate limited"
  return part


# The panel titles a window by its clock, so a budget period that spans a
# month or a week says so rather than leaving the panel to guess from a label.
def period_title(period):
  start, end = parse_time(period.get("startTime")), parse_time(period.get("endTime"))
  if not (start and end):
    return ""
  days = (end - start).days
  if 27 <= days <= 31:
    return "Monthly"
  if days == 7:
    return "Weekly"
  return ""


# Each spend budget is a limit window: spend against its cap until the
# period ends. A provider capped inside it is its own allowance on the same
# clock, which the panel draws as a tick on that budget's meter; in a period
# the panel has no clock name for, it gets a line of its own. A cap is what
# may be spent, not what was bought, so it never funds the balance gauge.
def budget_part(data):
  period = data.get("period") if isinstance(data.get("period"), dict) else {}
  # The gateway's own period end, or none: a reset time is never made up.
  resets = str(period.get("endTime") or "") if parse_time(period.get("endTime")) else ""
  title = period_title(period)
  limits = []
  for entry in data.get("budgets") or []:
    if not isinstance(entry, dict):
      continue
    cap = usd(entry.get("budgetLimitUsd"))
    spent = usd(entry.get("totalSpendUsd"))
    if not cap or cap <= 0 or spent is None:
      continue
    limit = {"label": BUDGET_LABELS.get(entry.get("scope"), "Budget"), "percent": max(0.0, min(1.0, spent / cap)), "resetsAt": resets}
    if title:
      limit["title"] = title
    limits.append(limit)
    for provider in entry.get("providerBudgets") or []:
      if not isinstance(provider, dict) or not str(provider.get("limitType") or "").endswith("CAPPED"):
        continue
      provider_cap = usd(provider.get("budgetLimitUsd"))
      used = usd(provider.get("usageUsd"))
      name = str(provider.get("provider") or "").strip()
      if not (provider_cap and provider_cap > 0 and used is not None and name):
        continue
      name = name[:1].upper() + name[1:]
      limits.append({
        "label": f"{name} budget",
        "title": f"{name} {title}" if title else f"{name} budget",
        "percent": max(0.0, min(1.0, used / provider_cap)),
        "resetsAt": resets,
      })
  return {"limits": limits}


# Keyed by the API key and the gateway it was asked of, so a machine signed
# in to someone else, or pointed at another region, never shows the last
# one's numbers. One file per endpoint, so a run only ever writes the answer
# it actually got: the budget's limits, and the credits' plan and balance.
CACHE_NAMES = {"budget": "limits", "credits": "credits"}


def billing_cache(key, base, resource):
  digest = hashlib.sha256((base + "\n" + key).encode()).hexdigest()[:16]
  return cache_root() / f"kimchi-{CACHE_NAMES[resource]}-{digest}.json"


def read_part(path, resource):
  cached = read_json(path)
  if not isinstance(cached, dict) and resource == "budget":
    # Budgets were cached as kimchi-budget-<key>.json before they joined the
    # limits cache name every collector shares.
    cached = read_json(path.with_name(path.name.replace("kimchi-limits-", "kimchi-budget-", 1)))
  return cached if isinstance(cached, dict) and number(cached.get("fetchedAtMs")) else None


# A kept budget whose period ended is an untouched allowance, not an unknown
# one: it comes back at zero, with no reset time until the gateway names the
# next period.
def limit_window_open(entry, now):
  resets_at = parse_time(entry.get("resetsAt"))
  return resets_at is None or resets_at > now


def usable_cached_limits(part):
  entries = part.get("limits")
  if not isinstance(entries, list):
    return []
  now = datetime.now(timezone.utc)
  return [
    entry if limit_window_open(entry, now) else dict(entry, percent=0.0, resetsAt="")
    for entry in entries if isinstance(entry, dict)
  ]


# Refreshes can overlap (the panel's own and a limits retry), so an answer
# only replaces one fetched after it.
def remember(path, part):
  current = read_json(path)
  if not isinstance(current, dict) or number(current.get("fetchedAtMs")) <= part["fetchedAtMs"]:
    write_json(path, part)


# The two endpoints answer on their own, and so does each fall back: a part
# that didn't come back is the last one that did, so one endpoint failing
# never blanks or overwrites what the other said. Any part that didn't come
# back fresh marks the record stale, cached or not.
def collect_billing(force):
  result = {"tierLabel": "", "limits": [], "usageStatusText": "", "authHelpText": "", "signedIn": False, "limitsStale": False, "limitsFetchedAt": 0}
  key, base = gateway()
  if not key:
    return result
  result["signedIn"] = True

  parts = {}
  failed = set()
  rejected = unreachable = False
  for resource, parse in (("credits", credits_part), ("budget", budget_part)):
    cache = billing_cache(key, base, resource)
    cached = read_part(cache, resource)
    if cached is not None:
      cached = dict(cached, limits=usable_cached_limits(cached)) if resource == "budget" else cached
      age = time.time() - number(cached.get("fetchedAtMs")) / 1000
      if not force and 0 <= age < PROBE_MIN_INTERVAL_SECONDS:
        parts[resource] = cached
        continue
    try:
      data = get_json(f"{base}/v1/{resource}", key)
      parts[resource] = dict(parse(data if isinstance(data, dict) else {}), fetchedAtMs=round(time.time() * 1000))
      remember(cache, parts[resource])
      continue
    except urllib.error.HTTPError as error:
      rejected = rejected or error.code in (401, 403)
    except (urllib.error.URLError, OSError, http.client.HTTPException):
      # No answer at all: no route, no DNS, a timeout, or a reply cut off.
      unreachable = True
    except Exception:
      pass
    failed.add(resource)
    if cached is not None:
      parts[resource] = cached

  credits = parts.get("credits") or {}
  result["tierLabel"] = credits.get("tierLabel") or ""
  if credits.get("balance"):
    result["balance"] = credits["balance"]
  result["limits"] = (parts.get("budget") or {}).get("limits") or []
  result["limitsStale"] = bool(failed)
  if parts:
    result["limitsFetchedAt"] = min(number(part.get("fetchedAtMs")) for part in parts.values())

  if rejected:
    result["usageStatusText"] = "Sign-in expired"
    result["authHelpText"] = REJECTED_HELP
  elif credits.get("usageStatusText"):
    result["usageStatusText"] = credits["usageStatusText"]
  elif "credits" not in parts:
    result["usageStatusText"] = "Balance unavailable"
    result["authHelpText"] = (
      "Couldn't reach Kimchi's gateway. Local Kimchi stats are still shown." if unreachable
      else "Kimchi's gateway didn't return the credits. Local Kimchi stats are still shown."
    )
  if unreachable and not rejected:
    # Usually the seconds after login before the network is up; the panel
    # tries once more soon instead of waiting out its refresh interval.
    result["retryAdvised"] = True
  return result


def main():
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  args = parser.parse_args()

  scan_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else SCAN_REUSE_SECONDS)
  stats = cached_local_stats(harness_dir() / "sessions", scan_age)
  billing = collect_billing(args.force)
  signed_in = billing.pop("signedIn")
  # Sessions on disk with no key to ask the gateway with: Kimchi is in use
  # here, its plan and credits just can't be read yet.
  if not signed_in and stats.get("hasLocalStats"):
    billing["usageStatusText"] = "Waiting for auth"
    billing["authHelpText"] = AUTH_HELP
  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "ready": signed_in or bool(stats.get("hasLocalStats")),
  }
  record.update(billing)
  record.update(stats)
  print(json.dumps(record, separators=(",", ":")))


if __name__ == "__main__":
  main()
