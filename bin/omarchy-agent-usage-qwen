#!/usr/bin/python3
# omarchy:summary=Print the Qwen Code usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Qwen Code usage into one display-ready JSON record.

Qwen Code records each session as JSONL under
~/.qwen/projects/<project>/chats/<session>.jsonl (QWEN_HOME moves ~/.qwen;
QWEN_RUNTIME_DIR or settings.json's advanced.runtimeOutputDir move the
projects). Every API response it bills lands there as a ui_telemetry record
carrying the model and the provider's token counts, the same records Qwen
Code's own usage statistics are rebuilt from, and every typed prompt as a
user record. Qwen Code reads no quota of its own, so the record carries no
meters. The agents panel only ever reads the JSON this prints.
"""

import argparse
import fcntl
import hashlib
import json
import os
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

AGENT_ID = "qwen"
AGENT_NAME = "Qwen Code"

API_RESPONSE_EVENT = "qwen-code.api_response"

# Qwen Code's own rule (getEventTotalTokenCount): through an OpenAI-style API
# the output count already includes thinking, and through Gemini it doesn't.
THOUGHTS_IN_OUTPUT_AUTH_TYPES = ("openai", "qwen-oauth")

# User records Qwen Code writes for text someone typed: a prompt, or a message
# sent while a turn was still running. Goal, mention, and notification records
# carry a subtype of their own.
PROMPT_SUBTYPES = (None, "mid_turn_user_message")

# A scan this recent is only reused to dedup concurrent collector runs (the
# update command backgrounds one per agent while the panel refreshes on its
# own). --limits-only promises only fresh limits, and Qwen Code has none, so
# it may reuse a scan for 15 minutes.
SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900

CACHE_SCHEMA_VERSION = 1
INDEX_VERSION = 1
INDEX_HEAD_BYTES = 4096

# Counts and times read from disk are untrusted. Anything past these bounds is
# a corrupt or crafted field, not usage.
MAX_TOKENS = 10**12
MIN_EPOCH_SECONDS = 946_684_800  # 2000-01-01
MAX_MODEL_NAME_LEN = 120


def token_count(value):
  """A token field as a whole number, or 0 when it isn't a plausible count.

  bool is an int subclass, and a string, NaN, negative, or absurd value is a
  bad field: it counts as nothing rather than skewing the totals.
  """
  if isinstance(value, bool) or not isinstance(value, (int, float)):
    return 0
  if value != value or value <= 0 or value > MAX_TOKENS:
    return 0
  return int(value)


def epoch_seconds(value):
  """Seconds since the epoch for an ISO string, or None when the value can't
  be a real moment of use."""
  if not isinstance(value, str) or not value.strip():
    return None
  text = value.strip()
  try:
    parsed = datetime.fromisoformat(text[:-1] + "+00:00" if text.endswith("Z") else text)
  except ValueError:
    return None
  if parsed.tzinfo is None:
    parsed = parsed.astimezone()
  seconds = parsed.timestamp()
  # A day of slack past now covers a clock a little behind the writer's.
  if seconds < MIN_EPOCH_SECONDS or seconds > time.time() + 86_400:
    return None
  return seconds


def local_day(seconds):
  return datetime.fromtimestamp(seconds).strftime("%Y-%m-%d")


def obj(value):
  return value if isinstance(value, dict) else {}


def model_label(raw):
  """A model id fit for the record: its last path segment, or None when it
  is too long to be a real id."""
  value = str(raw or "").rstrip("/").split("/")[-1]
  if len(value) > MAX_MODEL_NAME_LEN:
    return None
  return value or "qwen"


def empty_bucket():
  return {
    "inputTokens": 0,
    "outputTokens": 0,
    "cacheReadInputTokens": 0,
    "cacheCreationInputTokens": 0,
  }


# ------------------------------------------------------------- locations


def resolve_dir(value):
  """A directory setting as Qwen Code resolves it, `~` included. A relative
  one resolves against wherever Qwen Code was started, which this collector
  can't know, so it is left out."""
  if not isinstance(value, str) or not value.strip():
    return None
  path = Path(value.strip()).expanduser()
  return path if path.is_absolute() else None


def qwen_home():
  return resolve_dir(os.environ.get("QWEN_HOME")) or (Path.home() / ".qwen")


def runtime_output_dir(home):
  try:
    settings = json.loads((home / "settings.json").read_text(encoding="utf-8"))
  except (OSError, ValueError):
    return None
  return resolve_dir(obj(obj(settings).get("advanced")).get("runtimeOutputDir"))


def runtime_dirs():
  """Every directory whose projects/ may hold chats: QWEN_RUNTIME_DIR or the
  configured runtimeOutputDir, where Qwen Code writes, and the Qwen home,
  where it writes by default and where its own usage rebuild looks."""
  home = qwen_home()
  dirs = []
  for candidate in (resolve_dir(os.environ.get("QWEN_RUNTIME_DIR")), runtime_output_dir(home), home):
    if candidate is not None and candidate not in dirs:
      dirs.append(candidate)
  return dirs


def chat_files():
  files = []
  for base in runtime_dirs():
    try:
      found = sorted((base / "projects").glob("*/chats/*.jsonl"))
    except OSError:
      continue
    # A ledger sits beside its transcript and repeats nothing billable.
    files.extend(path for path in found if not path.name.endswith(".ledger.jsonl") and path not in files)
  return files


# ------------------------------------------------------------- transcripts


def parse_line(raw, session):
  """One transcript line as an index row, or None.

  A prompt is ["p", key, seconds, session]; a billed response is
  ["r", key, seconds, session, model, input, output, cacheRead]. The key
  dedups a record a resumed or branched session carries again.
  """
  if b'"user"' not in raw and API_RESPONSE_EVENT.encode() not in raw:
    return None
  try:
    record = json.loads(raw)
  except ValueError:
    return None
  if not isinstance(record, dict):
    return None
  session = str(record.get("sessionId") or session)
  uuid = str(record.get("uuid") or "")

  if record.get("type") == "user":
    if record.get("subtype") not in PROMPT_SUBTYPES:
      return None
    seconds = epoch_seconds(record.get("timestamp"))
    if seconds is None or not uuid:
      return None
    return ["p", uuid, seconds, session]

  if record.get("type") != "system" or record.get("subtype") != "ui_telemetry":
    return None
  event = obj(obj(record.get("systemPayload")).get("uiEvent"))
  if event.get("event.name") != API_RESPONSE_EVENT:
    return None
  seconds = epoch_seconds(event.get("event.timestamp")) or epoch_seconds(record.get("timestamp"))
  model = model_label(event.get("model"))
  if seconds is None or model is None:
    return None
  # The prompt count includes its cached part; a provider that reports only
  # the cached part reports a fully cached prompt, as Qwen Code reads it.
  cached = token_count(event.get("cached_content_token_count"))
  prompt = token_count(event.get("input_token_count")) or cached
  cached = min(cached, prompt)
  output = token_count(event.get("output_token_count"))
  if str(event.get("auth_type") or "") not in THOUGHTS_IN_OUTPUT_AUTH_TYPES:
    output += token_count(event.get("thoughts_token_count"))
  if prompt + output <= 0:
    return None
  key = str(event.get("response_id") or "") or uuid
  if not key:
    return None
  return ["r", key, seconds, session, model, prompt - cached, output, cached]


def read_digest(path, length):
  digest = hashlib.sha1()
  with path.open("rb") as handle:
    digest.update(handle.read(min(length, INDEX_HEAD_BYTES)))
  return digest.hexdigest()


def parse_file(path, entry):
  """The index entry for one transcript, reusing `entry` where the file only
  grew: Qwen Code appends to a transcript and never rewrites what it wrote."""
  stat = path.stat()
  if entry and entry.get("size") == stat.st_size and entry.get("mtime") == stat.st_mtime_ns:
    return entry
  offset = 0
  rows = []
  if (
    entry
    and isinstance(entry.get("offset"), int)
    and stat.st_size > entry["offset"]
    and entry.get("file") == [stat.st_dev, stat.st_ino]
    and entry.get("head") == read_digest(path, entry["offset"])
  ):
    offset = entry["offset"]
    rows = list(entry.get("rows") or [])
  with path.open("rb") as handle:
    handle.seek(offset)
    for raw in handle:
      if not raw.endswith(b"\n"):
        # A line still being written; pick it up whole next time.
        break
      offset += len(raw)
      row = parse_line(raw, path.stem)
      if row is not None:
        rows.append(row)
  return {
    "size": stat.st_size,
    "mtime": stat.st_mtime_ns,
    "file": [stat.st_dev, stat.st_ino],
    "offset": offset,
    "head": read_digest(path, offset),
    "rows": rows,
  }


def load_index(path):
  try:
    data = json.loads(path.read_text(encoding="utf-8"))
  except Exception:
    return {}
  if isinstance(data, dict) and data.get("version") == INDEX_VERSION and isinstance(data.get("files"), dict):
    return data["files"]
  return {}


def summarize(rows):
  now = datetime.now()
  today = now.strftime("%Y-%m-%d")
  recent_dates = [(now - timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]
  recent = {day: 0 for day in recent_dates}
  today_prompts = 0
  today_total_tokens = 0
  today_sessions = set()
  today_tokens_by_model = {}
  total_prompts = 0
  total_sessions = set()
  active_days = set()
  model_usage = {}
  seen = set()

  for row in rows:
    try:
      kind, key, seconds, session = row[:4]
      day = local_day(float(seconds))
      if kind == "r":
        model = str(row[4])
        input_tokens, output_tokens, cache_read = (int(value) for value in row[5:8])
      elif kind != "p":
        continue
    except (TypeError, ValueError, IndexError, OverflowError, OSError):
      continue
    if (kind, key) in seen:
      continue
    seen.add((kind, key))
    session = str(session)
    total_sessions.add(session)
    active_days.add(day)
    if day == today:
      today_sessions.add(session)
    if kind == "p":
      total_prompts += 1
      if day == today:
        today_prompts += 1
      continue
    total = input_tokens + output_tokens + cache_read
    bucket = model_usage.setdefault(model, empty_bucket())
    bucket["inputTokens"] += input_tokens
    bucket["outputTokens"] += output_tokens
    bucket["cacheReadInputTokens"] += cache_read
    if day in recent:
      # recentDays.messageCount holds tokens, despite the shared legacy name.
      recent[day] += total
    if day == today:
      today_total_tokens += total
      today_tokens_by_model[model] = today_tokens_by_model.get(model, 0) + total

  return {
    "todayPrompts": today_prompts,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": today_total_tokens,
    "todayTokensByModel": today_tokens_by_model,
    "recentDays": [{"date": day, "messageCount": recent[day]} for day in recent_dates],
    "totalPrompts": total_prompts,
    "totalSessions": len(total_sessions),
    # The dates travel too: merging snapshots from several machines needs
    # their union, which a count alone cannot give.
    "activeDays": len(active_days),
    "activeDates": sorted(active_days),
    "modelUsage": model_usage,
  }


def scan(index_file):
  """Every transcript's rows, summarized. Returns (stats, complete); a scan
  that couldn't read a transcript is not cached."""
  previous = load_index(index_file) if index_file else {}
  current = {}
  complete = True
  rows = []
  for path in chat_files():
    key = str(path)
    try:
      current[key] = parse_file(path, previous.get(key))
    except OSError as exc:
      print(f"omarchy-agent-usage-qwen: skipping {path}: {type(exc).__name__}", file=sys.stderr)
      complete = False
      continue
    rows.extend(current[key].get("rows") or [])
  if index_file and current != previous:
    try:
      write_json(index_file, {"version": INDEX_VERSION, "files": current})
    except Exception as exc:
      print(f"omarchy-agent-usage-qwen: could not write transcript index ({exc})", file=sys.stderr)
  return summarize(rows), complete


# ---------------------------------------------------------------- cache


def cache_root():
  root = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def cache_paths():
  # The digest covers every directory the scan reads, so another home or
  # runtime directory never reuses this one's numbers.
  digest = hashlib.sha1("\n".join(str(path) for path in runtime_dirs()).encode("utf-8")).hexdigest()[:16]
  root = cache_root()
  return root / f"qwen-scan-{digest}.json", root / f"qwen-scan-{digest}.lock", root / f"qwen-index-{digest}.json"


def read_fresh_json(path, max_age_seconds):
  if max_age_seconds <= 0:
    return None
  try:
    # A negative age means the mtime is in the future: the clock moved
    # backwards since the write, so the cache's freshness cannot be trusted.
    age = time.time() - path.stat().st_mtime
    if 0 <= age < max_age_seconds:
      return json.loads(path.read_text(encoding="utf-8"))
  except Exception:
    return None
  return None


def write_json(path, payload):
  # A temp name unique to this writer: several collectors can run at once, and
  # a shared temp path means the second replace finds the first one's file
  # already moved away.
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, separators=(",", ":")) + "\n")
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


STATS_KEYS = ("todayPrompts", "todaySessions", "todayTotalTokens", "todayTokensByModel", "recentDays", "totalPrompts", "totalSessions", "activeDays", "activeDates", "modelUsage")


def read_cached_stats(cache_file, max_age_seconds):
  cached = read_fresh_json(cache_file, max_age_seconds)
  if not isinstance(cached, dict) or cached.get("schemaVersion") != CACHE_SCHEMA_VERSION:
    return None
  # today* fields only mean "today" on the day they were scanned.
  if cached.get("scanDate") != datetime.now().strftime("%Y-%m-%d"):
    return None
  stats = cached.get("stats")
  if not isinstance(stats, dict) or not all(key in stats for key in STATS_KEYS):
    return None
  return stats


def cached_local_stats(max_age):
  """Local stats, with the cache as a pure optimization: any cache failure
  degrades to a direct scan and a warning on stderr."""
  try:
    cache_file, lock_file, index_file = cache_paths()
    cached = read_cached_stats(cache_file, max_age)
    if cached is not None:
      return cached
    with lock_file.open("w") as lock:
      fcntl.flock(lock, fcntl.LOCK_EX)
      cached = read_cached_stats(cache_file, max_age)
      if cached is not None:
        return cached
      stats, complete = scan(index_file)
      # An interrupted scan still serves this run, but caching it would hide
      # the missing usage from every reader until the cache expires.
      if complete:
        try:
          write_json(cache_file, {"schemaVersion": CACHE_SCHEMA_VERSION, "scanDate": datetime.now().strftime("%Y-%m-%d"), "stats": stats})
        except Exception as exc:
          print(f"omarchy-agent-usage-qwen: could not write usage cache ({exc})", file=sys.stderr)
      return stats
  except Exception as exc:
    print(f"omarchy-agent-usage-qwen: cache unavailable ({exc}); scanning directly", file=sys.stderr)
    stats, _ = scan(None)
    return stats


def main():
  parser = argparse.ArgumentParser(description="Print the Qwen Code usage record as JSON")
  # --force rescans everything. --limits-only only promises fresh limits, and
  # Qwen Code reads none, so it reuses a scan far longer than a normal run.
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  args = parser.parse_args()

  max_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else SCAN_REUSE_SECONDS)
  stats = cached_local_stats(max_age)

  # There is no quota to read, so nothing waits on a sign-in: the status stays
  # empty and local stats show alone. A machine that never ran Qwen Code
  # prints a record the panel skips.
  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "ready": stats["totalSessions"] > 0,
    "hasLocalStats": True,
    "hasPromptStats": True,
    "tierLabel": "",
    "usageStatusText": "",
    "authHelpText": "",
    "limits": [],
    "limitsStale": False,
    "limitsFetchedAt": 0,
  }
  record.update(stats)
  print(json.dumps(record, separators=(",", ":")))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
