#!/usr/bin/python3
# omarchy:summary=Print the Cursor usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Cursor usage into one display-ready JSON record.

Cursor keeps no token counts on disk, so everything here comes from the same
dashboard RPCs the Cursor CLI itself calls: the plan and the period meters
from GetCurrentPeriodUsage and GetPlanInfo, tokens per model and per day from
GetAggregatedUsageEvents. They are asked with the sign-in the Cursor CLI
stores, or failing that the one the Cursor editor keeps in its state.vscdb.
The agents panel only ever reads the JSON this prints.
"""

from __future__ import annotations

import argparse
import base64
import http.client
import json
import math
import os
import sqlite3
import sys
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from datetime import date, datetime, time, timedelta, timezone
from pathlib import Path
from typing import Any

# The shared collector plumbing ships with the agents panel.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.environ["OMARCHY_PATH"], "shell", "plugins", "agents"))
from collectors import (  # noqa: E402
  PROBE_MIN_INTERVAL_SECONDS,
  HttpError,
  LimitsCache,
  base_record as shared_base_record,
  cached_scan,
  config_home,
  emit,
  empty_bucket,
  empty_stats,
  number,
  open_json,
  read_json,
  scan_cache_paths,
  scan_max_age,
)

AGENT_ID = "cursor"
AGENT_NAME = "Cursor"
AUTH_HELP = "Sign in to the Cursor editor, or run `cursor-agent login`."
API_BASE_URL = "https://api2.cursor.sh"
SERVICE = "aiserver.v1.DashboardService"
REQUEST_TIMEOUT = 20
RECENT_DAYS = 7


class CursorError(Exception):
  def __init__(self, message: str, auth: bool = False, transport: bool = False) -> None:
    super().__init__(message)
    self.auth = auth
    # Nothing answered at all, so the panel should try again soon.
    self.transport = transport


def fraction(value: Any) -> float:
  # Cursor reports whole percentages; the panel's meters take 0..1.
  return min(1.0, max(0.0, finite(value) / 100))


# The Cursor CLI keeps its config beside auth.json and in ~/.cursor, the editor
# under ~/.config/Cursor. Any of them means Cursor is used here, so a missing
# sign-in is worth saying; without them the machine doesn't use Cursor at all.
def cursor_in_use(auth_path: Path) -> bool:
  return any(path.is_dir() for path in (auth_path.parent, config_home() / "Cursor", Path.home() / ".cursor"))


# ------------------------------------------------------------ cursor sign-in
#
# The Grok Bot collector reads the same account the same way, from this same
# block; keep the two identical.


def finite(value: Any) -> float:
  if isinstance(value, bool):
    return 0.0
  try:
    parsed = float(value or 0)
  except (TypeError, ValueError):
    return 0.0
  return parsed if math.isfinite(parsed) else 0.0


def default_auth_path() -> Path:
  return config_home() / "cursor" / "auth.json"


def default_state_db() -> Path:
  return config_home() / "Cursor" / "User" / "globalStorage" / "state.vscdb"


def read_ide_token(state_db: Path) -> str:
  """The sign-in the Cursor editor keeps, for people who never ran the CLI.

  Read-only: the editor may be writing its database right now. No
  immutable=1, so a live database with an active WAL still reads.
  """
  if not state_db.is_file():
    return ""
  try:
    conn = sqlite3.connect(state_db.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
  except sqlite3.Error:
    return ""
  try:
    conn.execute("PRAGMA query_only = ON")
    row = conn.execute("SELECT value FROM ItemTable WHERE key = 'cursorAuth/accessToken' LIMIT 1").fetchone()
  except sqlite3.Error:
    return ""
  finally:
    conn.close()
  value = row[0] if row else None
  if isinstance(value, bytes):
    value = value.decode("utf-8", errors="replace")
  return str(value or "").strip()


def read_cli_token(path: Path) -> str:
  return str(read_json(path).get("accessToken") or "").strip()


def jwt_claims(token: str) -> dict[str, Any]:
  parts = token.split(".")
  if len(parts) != 3:
    return {}
  try:
    claims = json.loads(base64.urlsafe_b64decode(parts[1] + "=" * (-len(parts[1]) % 4)))
  except (ValueError, UnicodeDecodeError):
    return {}
  return claims if isinstance(claims, dict) else {}


# A sign-in token whose expiry has passed. The CLI and the editor each renew
# their own the next time they run; an opaque API key never lapses here.
def token_lapsed(token: str) -> bool:
  expires = finite(jwt_claims(token).get("exp"))
  return 0 < expires <= datetime.now(timezone.utc).timestamp()


def read_token(path: Path | None = None, state_db: Path | None = None) -> str:
  """The key the user exported, the credential the Cursor CLI stores, or the
  editor's sign-in, in that order.

  A sign-in that has lapsed gives way to the next one that hasn't: someone who
  ran the CLI once and now lives in the editor would otherwise wait on a
  token nothing renews. With all of them lapsed, the first one decides.
  """
  key = str(os.environ.get("CURSOR_API_KEY") or "").strip()
  if key:
    return key
  cli = read_cli_token(path or default_auth_path())
  if cli and not token_lapsed(cli):
    return cli
  ide = read_ide_token(state_db or default_state_db())
  if ide and not token_lapsed(ide):
    return ide
  return cli or ide


# Who the token signs in as (the JWT's subject), so a machine signed in to
# someone else never shows the last one's numbers, and a refreshed token keeps
# the same caches. An opaque API key stands for itself. The caches hash it.
def account_key(token: str) -> str:
  return str(jwt_claims(token).get("sub") or "") or token


# ------------------------------------------------------------------ record


def iso(epoch_millis: Any) -> str:
  millis = number(epoch_millis)
  if millis <= 0:
    return ""
  try:
    return datetime.fromtimestamp(millis / 1000, timezone.utc).isoformat()
  except (OverflowError, OSError, ValueError):
    return ""


def base_record(**overrides: Any) -> dict[str, Any]:
  # Dashboard numbers are account-global, not machine-local: every synced
  # device reports the same truth, so aggregation must not sum them. The
  # dashboard reports usage events, never prompt or session counts; the panel
  # keeps those numbers out of today's tooltip when hasPromptStats is false.
  return shared_base_record(AGENT_ID, AGENT_NAME, scope="account", hasPromptStats=False, **overrides)


# A reply cut short came from a server that answered, so it is no reason to
# ask the panel for a sooner retry, unlike a dashboard nothing reached.
def cut_short(error: HttpError) -> bool:
  return isinstance(error.__cause__, http.client.HTTPException)


class CursorClient:
  def __init__(self, token: str, api_base_url: str) -> None:
    self.token = token
    self.api_base_url = api_base_url.rstrip("/")

  def call(self, method: str, payload: dict[str, Any]) -> dict[str, Any]:
    request = urllib.request.Request(
      f"{self.api_base_url}/{SERVICE}/{method}",
      data=json.dumps(payload).encode("utf-8"),
      headers={
        "Content-Type": "application/json",
        "Connect-Protocol-Version": "1",
        "Authorization": f"Bearer {self.token}",
        "x-cursor-client-type": "cli",
      },
      method="POST",
    )
    try:
      parsed = open_json(request, timeout=REQUEST_TIMEOUT)
    except HttpError as error:
      if error.status in (401, 403):
        raise CursorError(AUTH_HELP, auth=True) from error
      if error.status:
        raise CursorError(f"Cursor's dashboard returned status {error.status}.") from error
      if error.transport and cut_short(error):
        raise CursorError("Cursor's dashboard cut its reply short.") from error
      # No route, no DNS, refused, reset or timed out: nothing answered.
      if error.transport:
        raise CursorError("Couldn't reach Cursor's dashboard. Retrying shortly.", transport=True) from error
      raise CursorError("Cursor's dashboard returned malformed JSON.") from error
    if not isinstance(parsed, dict):
      raise CursorError("Cursor's dashboard returned malformed JSON.")
    return parsed

  def period(self) -> dict[str, Any]:
    return self.call("GetCurrentPeriodUsage", {})

  # None when the plan couldn't be asked, so the last known one stands.
  def plan_name(self) -> str | None:
    try:
      plan = self.call("GetPlanInfo", {}).get("planInfo")
    except CursorError:
      return None
    return str(plan.get("planName") or "") if isinstance(plan, dict) else ""

  def aggregations(self, start_millis: int, end_millis: int) -> list[Any]:
    payload = {"startDate": str(start_millis), "endDate": str(end_millis)}
    rows = self.call("GetAggregatedUsageEvents", payload).get("aggregations")
    return rows if isinstance(rows, list) else []


# ------------------------------------------------------------------ tokens


def day_windows(today: date, count: int) -> list[tuple[str, int, int]]:
  """The last `count` local days, oldest first, as (date, startMs, endMs)."""
  windows = []
  for offset in range(count - 1, -1, -1):
    day = today - timedelta(days=offset)
    # Each midnight converts on its own: a day that springs forward or falls
    # back is 23 or 25 hours long, never a fixed 24.
    start = datetime.combine(day, time.min).astimezone()
    end = datetime.combine(day + timedelta(days=1), time.min).astimezone()
    windows.append((day.isoformat(), int(start.timestamp() * 1000), int(end.timestamp() * 1000)))
  return windows


def summarize_day(rows: list[Any]) -> dict[str, dict[str, int]]:
  """One day's aggregations under the token names every collector prints."""
  usage: dict[str, dict[str, int]] = {}
  for row in rows:
    if not isinstance(row, dict):
      continue
    model = str(row.get("modelIntent") or "cursor")
    bucket = usage.setdefault(model, empty_bucket())
    # Connect's JSON writes 64-bit counts as strings, so number() rather than
    # the strict token_count().
    bucket["inputTokens"] += number(row.get("inputTokens"))
    bucket["outputTokens"] += number(row.get("outputTokens"))
    bucket["cacheReadInputTokens"] += number(row.get("cacheReadTokens"))
    bucket["cacheCreationInputTokens"] += number(row.get("cacheWriteTokens"))
  return usage


def summarize_usage(days: list[tuple[str, dict[str, dict[str, int]]]]) -> dict[str, Any]:
  recent_days = []
  active_dates = []
  model_usage: dict[str, dict[str, int]] = {}
  today_by_model: dict[str, int] = {}

  for index, (day, usage) in enumerate(days):
    tokens = 0
    for model, bucket in usage.items():
      carried = model_usage.setdefault(model, empty_bucket())
      for name, value in bucket.items():
        carried[name] += value
      tokens += sum(bucket.values())
    recent_days.append({"date": day, "messageCount": tokens})
    if tokens > 0:
      active_dates.append(day)
    if index == len(days) - 1:
      today_by_model = {model: sum(bucket.values()) for model, bucket in usage.items() if sum(bucket.values()) > 0}

  return {
    "hasLocalStats": bool(model_usage),
    "todayTotalTokens": sum(today_by_model.values()),
    "todayTokensByModel": today_by_model,
    "recentDays": recent_days,
    "activeDays": len(active_dates),
    "activeDates": active_dates,
    "modelUsage": model_usage,
  }


# The token scan is cached per account rather than per data path: Cursor's
# numbers live on its dashboard, and the account is who they belong to.
def stats_cache(key: str) -> Path:
  return scan_cache_paths(AGENT_ID, [key])[0]


def carried_stats(key: str, today: date) -> dict[str, Any]:
  """The last scan of this account, for runs that fetch no fresh tokens.

  Another account's scan never stands in for this one's. A scan from an
  earlier day is moved onto this week's dates, and its today figures are
  cleared, since nothing in it happened today.
  """
  stats = {"hasLocalStats": False, **empty_stats()}
  cached = read_json(stats_cache(key))
  previous = cached.get("stats")
  if not isinstance(previous, dict):
    return stats
  for name in stats:
    if name in previous:
      stats[name] = previous[name]
  if cached.get("scanDate") != today.isoformat():
    week = [window[0] for window in day_windows(today, RECENT_DAYS)]
    kept_days = {str(day): usage for day, usage in previous.get("days") or [] if isinstance(usage, dict)}
    if kept_days:
      # Summed again over the new week, so the day that fell out leaves the
      # model totals and active days along with the chart.
      stats.update(summarize_usage([(day, kept_days.get(day, {})) for day in week]), hasLocalStats=stats["hasLocalStats"])
    else:
      counts = {str(row.get("date")): row.get("messageCount", 0) for row in stats["recentDays"] if isinstance(row, dict)}
      stats["recentDays"] = [{"date": day, "messageCount": counts.get(day, 0)} for day in week]
      stats["activeDates"] = [day for day in stats.get("activeDates") or [] if day in week]
      stats["activeDays"] = len(stats["activeDates"])
    stats["todayTotalTokens"] = 0
    stats["todayTokensByModel"] = {}
  return stats


# This week's tokens: a scan of this account recent enough to reuse, else a
# fresh one, else the last one when the fetch fails.
def week_stats(client: CursorClient, today: date, key: str, max_age_seconds: float) -> dict[str, Any]:
  def scan() -> tuple[dict[str, Any], bool]:
    windows = day_windows(today, RECENT_DAYS)
    with ThreadPoolExecutor(max_workers=4) as pool:
      rows = list(pool.map(lambda window: client.aggregations(window[1], window[2]), windows))
    days = [(window[0], summarize_day(day_rows)) for window, day_rows in zip(windows, rows)]
    # Each day's usage is kept too, so a scan carried past midnight can be
    # summed again over the new week.
    return {**empty_stats(), **summarize_usage(days), "days": days}, True

  try:
    stats = cached_scan(AGENT_ID, [key], max_age_seconds, scan)
  except Exception:
    return carried_stats(key, today)
  return {name: value for name, value in stats.items() if name != "days"}


# ------------------------------------------------------------------ limits


def summarize_limits(period: dict[str, Any]) -> list[dict[str, Any]]:
  """Cursor's own percentages, never a percentage derived from spend.

  The dollar figures do not divide into the allowance: bonus usage the
  providers hand out is spend without an allowance behind it, so
  totalSpend/limit reads well past 100% while Cursor's own meters do not.

  Every meter runs on the billing cycle. The included total is the Monthly
  row; the model meters and the on-demand budget are titled after it, so the
  panel attaches them to that row rather than showing four rows that each
  read "Monthly".
  """
  plan = period.get("planUsage")
  plan = plan if isinstance(plan, dict) else {}
  spend = period.get("spendLimitUsage")
  spend = spend if isinstance(spend, dict) else {}
  resets_at = iso(period.get("billingCycleEnd"))
  limits = []

  for label, title, key in (
    ("Included total", "Monthly", "totalPercentUsed"),
    ("Auto models", "Auto models Monthly", "autoPercentUsed"),
    ("Named models", "Named models Monthly", "apiPercentUsed"),
  ):
    if key in plan:
      limits.append({"label": label, "title": title, "percent": fraction(plan.get(key)), "resetsAt": resets_at})

  limit_cents = number(spend.get("individualLimit"))
  if limit_cents > 0:
    used_cents = number(spend.get("individualUsed"))
    limits.append(dict(on_demand_names(used_cents, limit_cents), percent=min(1.0, used_cents / limit_cents), resetsAt=resets_at, onDemandLimitCents=limit_cents))
  return limits


# The on-demand meter names its dollars, so a kept one that resets to zero
# is renamed with the spend it now stands at.
def on_demand_names(used_cents: float, limit_cents: float) -> dict[str, str]:
  label = f"On-demand ${used_cents / 100:.2f} / ${limit_cents / 100:.2f}"
  return {"label": label, "title": f"{label} Monthly"}


def limits_cache(key: str) -> LimitsCache:
  return LimitsCache(AGENT_ID, key)


# The kept limits as they read now: one whose billing cycle has ended is back
# at zero, with the next cycle's reset unknown until a check succeeds, and an
# on-demand meter among them is renamed for its spend of zero.
def kept_limits(cache: LimitsCache) -> list[dict[str, Any]]:
  raw = cache.data.get("limits")
  raw = [entry for entry in raw if isinstance(entry, dict)] if isinstance(raw, list) else []
  kept = []
  for entry, opened in zip(raw, cache.limits):
    cents = number(entry.get("onDemandLimitCents"))
    if cents > 0 and entry.get("resetsAt") and not opened.get("resetsAt"):
      opened = dict(opened, **on_demand_names(0, cents))
    kept.append(opened)
  return kept


# ---------------------------------------------------------------- assembly


def scan(api_base_url: str, auth_path: Path, limits_only: bool, state_db: Path | None = None, force: bool = False) -> dict[str, Any]:
  token = read_token(auth_path, state_db)
  if not token:
    if cursor_in_use(auth_path):
      return base_record(ready=True, usageStatusText="Waiting for auth", authHelpText=AUTH_HELP)
    return base_record()

  client = CursorClient(token, api_base_url)
  key = account_key(token)
  cache = limits_cache(key)
  kept = kept_limits(cache)
  fetched_at = cache.fetched_at
  kept_tier = str(cache.data.get("tierLabel") or "")
  today = datetime.now().astimezone().date()
  # --limits-only runs while a meter is near its limit, which can last hours,
  # so the tokens it carries are only so old before they are fetched again.
  scan_age = scan_max_age(force, limits_only)

  # A failed check keeps the last good limits, marked stale so the panel
  # gives their age on hover, and the week of tokens already on disk.
  def failed(status: str, detail: str, retry: bool = False) -> dict[str, Any]:
    record = base_record(
      ready=True,
      tierLabel=kept_tier,
      usageStatusText=status,
      authHelpText=detail + (" Showing the last known limits." if kept else ""),
      limits=kept,
      limitsStale=True,
      limitsFetchedAt=fetched_at if kept else 0,
    )
    if retry:
      record["retryAdvised"] = True
    record.update(carried_stats(key, today))
    return record

  if token_lapsed(token):
    return failed(
      "Limits paused",
      "Cursor's access token has lapsed. Open the Cursor editor, or run `cursor-agent`, to renew it; signing in again is not needed.",
    )

  # A panel opened and shut repeatedly must not turn into a request per
  # flick, so an answer this recent is the answer, even one with no meters.
  if not force and isinstance(cache.data.get("limits"), list) and cache.younger_than(PROBE_MIN_INTERVAL_SECONDS):
    record = base_record(ready=True, tierLabel=kept_tier, limits=kept, limitsFetchedAt=fetched_at)
    record.update(week_stats(client, today, key, scan_age))
    return record

  try:
    limits = summarize_limits(client.period())
  except CursorError as error:
    if error.auth:
      return failed("Sign-in expired", "Cursor refused the saved sign-in. " + AUTH_HELP)
    return failed("" if kept else "Cursor limits unavailable", str(error), retry=error.transport)
  except Exception as error:
    print(f"omarchy-agent-usage-cursor: {type(error).__name__}", file=sys.stderr)
    return failed("" if kept else "Cursor limits unavailable", "Cursor's usage check failed.")

  plan = client.plan_name()
  tier = kept_tier if plan is None else plan
  # The cache only backs later runs; failing to keep it never costs this
  # run's live answer.
  record = base_record(ready=True, tierLabel=tier, limits=limits, limitsFetchedAt=cache.save(limits, tierLabel=tier))
  record.update(week_stats(client, today, key, scan_age))
  return record


def main() -> int:
  parser = argparse.ArgumentParser(description="Print the Cursor usage record as JSON")
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  parser.add_argument("--auth-path", default=os.environ.get("CURSOR_AUTH_PATH", ""))
  parser.add_argument("--api-base-url", default=os.environ.get("CURSOR_API_ENDPOINT", API_BASE_URL))
  args = parser.parse_args()

  auth_path = Path(args.auth_path).expanduser() if args.auth_path else default_auth_path()
  try:
    record = scan(args.api_base_url, auth_path, args.limits_only, force=args.force)
  # scan() keeps the last limits through any failed check; only a failure
  # before it knows the account ends up here.
  except Exception as error:
    record = base_record(usageStatusText="Cursor limits unavailable", authHelpText="Cursor's usage check failed.")
    print(f"omarchy-agent-usage-cursor: {type(error).__name__}", file=sys.stderr)
  emit(record)
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
