#!/usr/bin/python3
# omarchy:summary=Print the Antigravity usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Google Antigravity usage into one display-ready JSON record.

The id is agy, the name omarchy-default-agent and omarchy-agent know the CLI
by, so the record and the default agent agree on which agent this is.

Local stats come from Antigravity's history log, conversation summaries, and
conversation transcripts under ~/.gemini/antigravity-cli/, and from the
Antigravity answers pi, omp, OpenClaw, and opencode's Antigravity plugin
recorded; no other collector counts those. The plan and
limits come from the Google Cloud Code API (v1internal:loadCodeAssist and
v1internal:retrieveUserQuotaSummary), asked with the sign-in agy keeps in the
Secret Service keyring (or its antigravity-oauth-token file), or with the
Antigravity sign-in omp, pi, or opencode's Antigravity plugin keeps; a lapsed
omp sign-in is asked through `omp usage`, which renews it. Those stores are
only ever read. The agents panel only ever reads the JSON this prints.
"""

import argparse
import base64
import fcntl
import hashlib
import http.client
import json
import math
import os
import re
import shutil
import sqlite3
import subprocess
import tempfile
import time
import urllib.error
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

AGENT_ID = "agy"
AGENT_NAME = "Antigravity"
AUTH_HELP = "Run `agy` to sign in, or sign in to Antigravity in omp, pi, or opencode."
# How each source of a sign-in is named when it needs attention.
SOURCE_NAMES = {"agy": "`agy`", "omp": "omp", "pi": "pi", "opencode": "opencode"}
PROBE_MIN_INTERVAL_SECONDS = 15
SCAN_REUSE_SECONDS = 20
# A limits-only refresh needs fresh limits, not a fresh history scan.
LIMITS_ONLY_REUSE_SECONDS = 900
DEFAULT_CLOUD_CODE_URL = "https://daily-cloudcode-pa.googleapis.com"
# More tokens than any one step could hold is a damaged field, not usage.
MAX_TOKENS = 1e12


def app_root():
  return Path(os.environ.get("AGY_DIR") or (Path.home() / ".gemini" / "antigravity-cli"))


def cache_root():
  return Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy" / "agent-usage"


def read_json(path):
  try:
    return json.loads(Path(path).read_text(encoding="utf-8"))
  except Exception:
    return None


# A temporary file of its own per write, so overlapping runs can't rename
# each other's away.
def write_json(path, payload):
  path = Path(path)
  path.parent.mkdir(parents=True, exist_ok=True)
  fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
  try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
      json.dump(payload, handle)
    os.replace(tmp, path)
  except Exception:
    Path(tmp).unlink(missing_ok=True)
    raise


# Times on disk are untrusted: a boolean, an epoch at or below zero, one too
# large for a date, NaN, or text that isn't ISO is no time at all, and the
# row it dates stays undated rather than taking the record down.
def parse_time(value):
  if value is None or value == "" or isinstance(value, bool):
    return None
  try:
    if isinstance(value, (int, float)) or str(value).isdigit():
      stamp = float(value)
      if not stamp > 0:
        return None
      parsed = datetime.fromtimestamp(stamp / 1000 if stamp > 1e12 else stamp, timezone.utc)
    else:
      parsed = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
      if not parsed.tzinfo:
        parsed = parsed.replace(tzinfo=timezone.utc)
  except (ValueError, OverflowError, OSError):
    return None
  # Go's zero time marks an uninitialized summary, not dated activity.
  return None if parsed == datetime.min.replace(tzinfo=timezone.utc) else parsed


def local_day(value):
  parsed = parse_time(value)
  if parsed is None:
    return ""
  try:
    return parsed.astimezone().date().isoformat()
  except (ValueError, OverflowError, OSError):
    # Even a parsed date can cross years 1/9999 during local conversion.
    return ""


# The sign-in agy keeps in the keyring: its access token, when that lapses,
# whether a refresh token stands behind it, and which kind of account it is.
# Without a Secret Service, agy keeps the same sign-in in a file of its own.
def login():
  try:
    raw = subprocess.check_output(
      ["secret-tool", "lookup", "service", "gemini", "username", "antigravity"],
      text=True, stderr=subprocess.DEVNULL, timeout=3,
    )
    data = json.loads(raw) if raw.strip() else None
  except Exception:
    data = None
  if not isinstance(data, dict):
    data = read_json(app_root() / "antigravity-oauth-token")
  if not isinstance(data, dict):
    return None

  token = data.get("token") if isinstance(data.get("token"), dict) else {}
  expires = parse_time(token.get("expiry") or data.get("expiry"))
  return {
    "source": "agy",
    "accessToken": str(token.get("access_token") or data.get("access_token") or ""),
    "expiresAt": expires.timestamp() if expires else 0,
    "refresh": str(token.get("refresh_token") or data.get("refresh_token") or ""),
    "authMethod": str(data.get("auth_method") or "consumer"),
    "email": email_of(data.get("id_token")),
  }


# omp, pi, and opencode's Antigravity plugin sign in with the same Google
# client agy uses, so the access tokens they keep reach the same plan and
# quota. Each refreshes its own token while it runs; these are only ever
# read, never refreshed or written back.
def harness_login(source, data):
  if not isinstance(data, dict) or data.get("type", "oauth") != "oauth" or not isinstance(data.get("access"), str) or not data["access"]:
    return None
  expires = parse_time(data.get("expires"))
  return {
    "source": source,
    "accessToken": data["access"],
    "expiresAt": expires.timestamp() if expires else 0,
    "refresh": str(data.get("refresh") or ""),
    "authMethod": "consumer",
    "email": str(data.get("email") or ""),
  }


def omp_logins():
  database = Path.home() / ".omp" / "agent" / "agent.db"
  if not database.is_file():
    return []
  try:
    conn = sqlite3.connect(database.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
    try:
      rows = conn.execute(
        "SELECT data FROM auth_credentials WHERE provider = 'google-antigravity' "
        "AND credential_type = 'oauth' AND disabled_cause IS NULL"
      ).fetchall()
    finally:
      conn.close()
  except sqlite3.Error:
    return []
  logins = []
  for (data,) in rows:
    try:
      entry = harness_login("omp", json.loads(data))
    except (TypeError, ValueError):
      continue
    if entry:
      logins.append(entry)
  return logins


def pi_agent_dir():
  return Path(os.environ.get("PI_CODING_AGENT_DIR") or (Path.home() / ".pi" / "agent"))


def pi_logins():
  auth = read_json(pi_agent_dir() / "auth.json")
  entry = harness_login("pi", auth.get("google-antigravity")) if isinstance(auth, dict) else None
  return [entry] if entry else []


# opencode files the Antigravity plugin's sign-in under its "google"
# provider, which other Google sign-ins share, so it only counts alongside
# the plugin's own accounts file.
def opencode_logins():
  config_home = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
  if not (config_home / "opencode" / "antigravity-accounts.json").is_file():
    return []
  data_home = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share"))
  auth = read_json(data_home / "opencode" / "auth.json")
  entry = harness_login("opencode", auth.get("google")) if isinstance(auth, dict) else None
  return [entry] if entry else []


def logins():
  entry = login()
  return ([entry] if entry else []) + omp_logins() + pi_logins() + opencode_logins()


def email_of(id_token):
  try:
    claims = str(id_token).split(".")[1]
    return str(json.loads(base64.urlsafe_b64decode(claims + "=" * (-len(claims) % 4))).get("email") or "")
  except Exception:
    return ""


# Which Google account a sign-in belongs to, so the limits kept for it are
# its own: the email when the sign-in names one, otherwise its refresh token,
# which outlives the access tokens it mints. Only a digest of either names
# the cache file.
def limits_cache(entry):
  identity = entry.get("email") or entry.get("refresh") or entry.get("accessToken")
  if not identity:
    return None
  return cache_root() / f"agy-limits-{hashlib.sha256(identity.encode()).hexdigest()[:16]}.json"


def token_fresh(entry, now):
  return bool(entry["accessToken"]) and (not entry["expiresAt"] or entry["expiresAt"] > now)


def normalize_tier_label(name, tier_id=""):
  for word in ("ultra", "pro", "free"):
    if word in tier_id.lower() or word in name.lower():
      return word.capitalize()
  if name.lower().startswith("google ai "):
    return name[10:].strip()
  return name or tier_id.replace("-tier", "").capitalize()


# A paid tier names the plan; without one, the current tier does.
def extract_tier(data):
  for key in ("paidTier", "currentTier"):
    tier = data.get(key) if isinstance(data, dict) else None
    if isinstance(tier, dict):
      name = str(tier.get("name") or "").strip()
      tier_id = str(tier.get("id") or "").strip()
      if name or tier_id:
        return normalize_tier_label(name, tier_id)
  return ""


# How much of a bucket is spent, or None when its fraction isn't a number.
def used(bucket):
  remaining = bucket.get("remainingFraction", bucket.get("remaining_fraction", 1.0))
  if isinstance(remaining, bool):
    return None
  try:
    remaining = float(remaining)
  except (TypeError, ValueError):
    return None
  if not math.isfinite(remaining):
    return None
  return round(max(0.0, min(1.0, 1.0 - remaining)), 4)


def reset_of(bucket):
  parsed = parse_time(bucket.get("resetTime") or bucket.get("reset_time"))
  return parsed.isoformat() if parsed else ""


# The Gemini group's 5-hour and weekly buckets are the plan's own limits; the
# other groups (Claude and GPT models) are scoped allowances, shown once
# they have been touched. An answer that lists its buckets without groups
# lists the Gemini ones.
def extract_limits(data):
  if not isinstance(data, dict):
    return []
  groups = [g for g in data.get("groups") or [] if isinstance(g, dict)]
  if not groups and isinstance(data.get("buckets"), list):
    groups = [{"displayName": "Gemini", "buckets": data["buckets"]}]
  if not groups:
    return []
  gemini = next((g for g in groups if "gemini" in str(g.get("displayName") or "").lower()), groups[0])

  limits = []
  session = weekly = None
  for bucket in gemini.get("buckets") or []:
    if not isinstance(bucket, dict) or used(bucket) is None:
      continue
    window = str(bucket.get("window") or "").lower()
    bucket_id = str(bucket.get("bucketId") or "").lower()
    name = str(bucket.get("displayName") or "").lower()
    if window == "5h" or "5h" in bucket_id or "five" in name:
      session = bucket
    elif window == "weekly" or "weekly" in bucket_id or "week" in name:
      weekly = bucket
  if session:
    limits.append({"label": "Session (5-hour)", "title": "Session", "percent": used(session), "resetsAt": reset_of(session)})
  if weekly:
    limits.append({"label": "Weekly (7-day)", "title": "Weekly", "percent": used(weekly), "resetsAt": reset_of(weekly)})

  for group in groups:
    if group is gemini:
      continue
    group_name = str(group.get("displayName") or "").strip()
    short = "Claude/GPT" if "claude" in group_name.lower() else (group_name or "3P")
    for bucket in group.get("buckets") or []:
      if isinstance(bucket, dict) and (used(bucket) or 0) > 0:
        title = f"{short} {'Weekly' if 'week' in str(bucket.get('window') or '').lower() else 'Session'}"
        limits.append({"label": title, "title": title, "percent": used(bucket), "resetsAt": reset_of(bucket)})
  return limits


# The bearer token goes wherever CLOUD_CODE_URL points, so a destination
# named there is taken only over https, and anything else is Google's own.
def post(endpoint, token):
  base = (os.environ.get("CLOUD_CODE_URL") or DEFAULT_CLOUD_CODE_URL).rstrip("/")
  if not base.startswith("https://"):
    base = DEFAULT_CLOUD_CODE_URL
  request = urllib.request.Request(
    f"{base}/v1internal:{endpoint}", data=b"{}",
    headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json", "User-Agent": "antigravity"},
  )
  with urllib.request.urlopen(request, timeout=8) as response:
    return json.loads(response.read().decode("utf-8", errors="replace"))


# A window kept from an earlier check whose reset has passed is back to
# untouched, not unknown, so it reads zero until Google names the next reset.
# A damaged cache entry is skipped rather than taking the collector down.
def usable_cached_limits(cached):
  limits = cached.get("limits") if isinstance(cached, dict) else None
  now = datetime.now(timezone.utc)
  kept = []
  for limit in limits if isinstance(limits, list) else []:
    if not isinstance(limit, dict):
      continue
    resets = parse_time(limit.get("resetsAt"))
    kept.append(dict(limit, percent=0.0, resetsAt="") if resets and resets <= now else limit)
  return kept


def cached_answer(entry):
  path = limits_cache(entry)
  cached = (read_json(path) if path else None) or {}
  return cached if isinstance(cached, dict) else {}


def fetched_at_ms(cached):
  try:
    return max(0, int(cached.get("fetchedAtMs") or 0))
  except (TypeError, ValueError, OverflowError):
    return 0


def lapsed_help(entry, kept):
  name = SOURCE_NAMES[entry["source"]]
  shown = " — showing the last known limits." if kept else "."
  if entry["refresh"]:
    return f"The Antigravity access token {name} keeps has lapsed{shown} Start {name} to refresh it; signing in again is not needed."
  return f"The Antigravity sign-in {name} keeps expired{shown} Start {name} to sign in again."


def refused_help(entry):
  name = SOURCE_NAMES[entry["source"]]
  return f"Google refused the Antigravity sign-in {name} keeps. Start {name} to sign in again."


# The plan and limits, asked of Google with one sign-in after another until
# one answers. Each account keeps its own last good answer, which stands in,
# marked stale, when its check fails.
def collect_limits(entries, force):
  result = {"limits": [], "tierLabel": "", "usageStatusText": "", "authHelpText": "", "live": False, "fetchedAtMs": 0, "retryAdvised": False}
  now = time.time()
  # Each harness refreshes its own token while it runs, so the one lapsing
  # last was refreshed most recently. A token of unknown expiry comes after
  # those, since only Google can say whether it still holds, and a lapsed
  # one last.
  ordered = sorted(entries, key=lambda e: (not token_fresh(e, now), -e["expiresAt"]))
  fresh = [e for e in ordered if token_fresh(e, now)]
  lead = next(iter(fresh or [e for e in ordered if e["accessToken"]] or ordered), None)
  omp = shutil.which("omp") if any(e["source"] == "omp" for e in entries) else None
  omp_entries = [e for e in ordered if e["source"] == "omp"] if omp else []

  def keep(entry):
    cached = cached_answer(entry) if entry else {}
    result.update(limits=usable_cached_limits(cached), tierLabel=str(cached.get("tierLabel") or ""), fetchedAtMs=fetched_at_ms(cached))

  def answered(entry, tier, limits):
    # A plan with no quota windows to report is healthy, with no meters.
    fetched = int(time.time() * 1000)
    result.update(limits=limits, tierLabel=tier, live=True, fetchedAtMs=fetched)
    path = limits_cache(entry)
    if path:
      write_json(path, {"fetchedAtMs": fetched, "limits": limits, "tierLabel": tier})
    return result

  keep(lead)
  if not lead or not lead["accessToken"]:
    result.update(usageStatusText="Waiting for auth", authHelpText=AUTH_HELP)
    return result

  # A panel that is opened and shut repeatedly must not turn into a request
  # per flick; --force is a person asking for fresh numbers.
  if not force:
    for entry in fresh + [e for e in omp_entries if e not in fresh]:
      cached = cached_answer(entry)
      if cached and 0 <= now - fetched_at_ms(cached) / 1000 < PROBE_MIN_INTERVAL_SECONDS:
        keep(entry)
        result["live"] = True
        return result

  refused, failure = [], None
  for entry in fresh:
    try:
      tier = extract_tier(post("loadCodeAssist", entry["accessToken"]))
      limits = extract_limits(post("retrieveUserQuotaSummary", entry["accessToken"]))
    except urllib.error.HTTPError as error:
      # A refused sign-in gives way to the next one; any other status is
      # Google answering for every sign-in alike.
      if error.code in (401, 403):
        refused.append(entry)
        continue
      failure = entry, f"Google's quota service answered with status {error.code}.", False
      break
    except (urllib.error.URLError, OSError, http.client.HTTPException):
      failure = entry, "Couldn't reach Google's quota service. Retrying shortly.", True
      break
    except ValueError:
      failure = entry, "Google's quota service sent an answer that couldn't be read.", False
      break
    return answered(entry, tier, limits)

  if failure:
    entry, help_text, transport = failure
    keep(entry)
    result.update(authHelpText=help_text, retryAdvised=transport)
    if not result["limits"]:
      result["usageStatusText"] = "Antigravity limits unavailable"
    return result

  # No token in hand answered, but omp renews its own sign-in when asked
  # for usage.
  answer = omp_answer(omp, omp_entries) if omp_entries else None
  if answer:
    entry, tier, limits = answer
    return answered(entry, tier or str(cached_answer(entry).get("tierLabel") or ""), limits)

  if refused:
    keep(refused[0])
    result.update(usageStatusText="Sign-in expired", authHelpText=refused_help(refused[0]))
    return result

  # Every harness refreshes its token while it runs; one left to lapse can't
  # be used until that harness starts again, which needs no new sign-in
  # while a refresh token stands behind it.
  result.update(usageStatusText="Limits paused" if lead["refresh"] else "Sign-in expired", authHelpText=lapsed_help(lead, result["limits"]))
  return result


# omp refreshes its own Antigravity sign-in when asked for usage, so its
# limits come from `omp usage` even after the token it keeps has lapsed. The
# report is folded back into the shape Google's quota summary has.
def omp_usage(omp):
  try:
    output = subprocess.run(
      [omp, "usage", "--json", "--provider", "google-antigravity"],
      capture_output=True, text=True, timeout=20, check=True,
    ).stdout
    reports = [r for r in json.loads(output).get("reports") or [] if isinstance(r, dict) and r.get("provider") == "google-antigravity"]
  except (OSError, ValueError, AttributeError, subprocess.SubprocessError):
    return None
  if not reports:
    return None
  groups, seen = {}, set()
  for limit in reports[0].get("limits") or []:
    if not isinstance(limit, dict):
      continue
    window = limit.get("window") if isinstance(limit.get("window"), dict) else {}
    amount = limit.get("amount") if isinstance(limit.get("amount"), dict) else {}
    label = str(limit.get("label") or "")
    # A shared allowance is listed once per model family that draws on it.
    if (label, window.get("id")) in seen:
      continue
    seen.add((label, window.get("id")))
    fraction = amount.get("usedFraction")
    if isinstance(fraction, bool) or not isinstance(fraction, (int, float)):
      continue
    groups.setdefault(label, []).append({"window": str(window.get("id") or ""), "remainingFraction": 1.0 - fraction, "resetTime": window.get("resetsAt")})
  metadata = reports[0].get("metadata") if isinstance(reports[0].get("metadata"), dict) else {}
  quota = {"groups": [{"displayName": name, "buckets": buckets} for name, buckets in groups.items()]}
  return quota, str(metadata.get("email") or "")


# The sign-in `omp usage` answered for, its plan when the token omp just
# renewed can still ask Google for it, and its limits.
def omp_answer(omp, entries):
  answer = omp_usage(omp)
  if not answer:
    return None
  quota, email = answer
  renewed = [e for e in omp_logins() if not email or e["email"] == email]
  entry = (renewed or [e for e in entries if not email or e["email"] == email] or [dict(entries[0], email=email)])[0]
  tier = ""
  if token_fresh(entry, time.time()):
    try:
      tier = extract_tier(post("loadCodeAssist", entry["accessToken"]))
    except (urllib.error.URLError, OSError, http.client.HTTPException, ValueError):
      pass
  return entry, tier, extract_limits(quota)
def model_bucket(models, model):
  return models.setdefault(model, {"inputTokens": 0, "outputTokens": 0, "cacheReadInputTokens": 0, "cacheCreationInputTokens": 0})


# A token count from disk is untrusted: a boolean, a negative, NaN, an
# absurdly large or a non-numeric value counts as nothing, so one bad field
# costs that field rather than the scan.
def number(value):
  if isinstance(value, bool):
    return 0
  try:
    count = float(value or 0)
  except (TypeError, ValueError, OverflowError):
    return 0
  return round(count) if 0 < count < MAX_TOKENS else 0


# A transcript step's tokens as (input, output, cache read, cache write).
# Steps nest Gemini's counts under usage, where the prompt count includes
# the cached part and thinking sits beside the candidates; newer builds put
# input_tokens, output_tokens, cache_read_tokens and cache_write_tokens on the
# step itself. Every reader of those adds the four up, so input here excludes
# the cache reads, the way Anthropic's counts do. None when the step reports
# no usage.
def step_tokens(step):
  usage = step.get("usage")
  for source in ([usage] if isinstance(usage, dict) else []) + [step]:
    if "prompt_token_count" in source or "candidates_token_count" in source:
      prompt = number(source.get("prompt_token_count"))
      cached = min(prompt, number(source.get("cached_content_token_count")))
      output = number(source.get("candidates_token_count")) + number(source.get("thoughts_token_count"))
      return prompt - cached, output, cached, 0
    if any(key in source for key in ("input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens")):
      return (number(source.get("input_tokens")), number(source.get("output_tokens")),
              number(source.get("cache_read_tokens")), number(source.get("cache_write_tokens")))
  return None


# A model step names its model by id; a "Model Selection" step names it the
# way the picker shows it ("Gemini 3.8 Flash (High)"). Both fold to the same
# key, so a conversation's tokens don't split across two spellings.
MODEL_SELECTION = re.compile(r"Model Selection` (?:from .+? )?to (.+?)\.(?:\s|$|<)")


def model_key(name):
  key = re.sub(r"[\s_]+", "-", re.sub(r"[()]", " ", name).strip().lower())
  return re.sub(r"-+", "-", key).strip("-")


def step_model(step):
  for field in ("model", "model_name", "model_id"):
    value = step.get(field)
    if isinstance(value, str) and model_key(value):
      return model_key(value)
  return ""


def selected_model(step):
  content = step.get("content")
  if not isinstance(content, str) or "Model Selection" not in content:
    return ""
  match = MODEL_SELECTION.search(content)
  return model_key(match.group(1)) if match else ""


def history_entries(root, problems):
  try:
    lines = (root / "history.jsonl").read_text(encoding="utf-8", errors="ignore").splitlines()
  except FileNotFoundError:
    return
  except OSError:
    problems.append("history")
    return
  for line in lines:
    try:
      entry = json.loads(line)
    except ValueError:
      continue
    if isinstance(entry, dict):
      yield entry


# Each conversation in the summaries with when it last changed and, where
# agy records it, the conversation it was spawned from.
def conversation_summaries(root, problems):
  summaries = root / "conversation_summaries.db"
  if not summaries.is_file():
    return []
  try:
    conn = sqlite3.connect(summaries.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
    try:
      columns = {row[1] for row in conn.execute("PRAGMA table_info(conversation_summaries)")}
      parent = "parent_conversation_id" if "parent_conversation_id" in columns else "NULL"
      return conn.execute(f"SELECT conversation_id, last_modified_time, {parent} FROM conversation_summaries").fetchall()
    finally:
      conn.close()
  except sqlite3.Error:
    problems.append("summaries")
    return []


# pi's and omp's session trees, each profile's too: `--profile=<name>` moves
# the whole agent tree under <base>/profiles/<name>/. pi moves its agent tree
# with PI_CODING_AGENT_DIR and its sessions alone with
# PI_CODING_AGENT_SESSION_DIR, both expanding a leading ~; either is read as
# well as the default trees, which keep whatever was written before the move.
def pi_session_roots():
  roots = []
  for base in (Path.home() / ".pi", Path.home() / ".omp"):
    roots.append(base / "agent" / "sessions")
    try:
      # Sorted so the scan order does not depend on directory order.
      roots.extend(sorted(child / "agent" / "sessions" for child in (base / "profiles").iterdir() if child.is_dir()))
    except OSError:
      # No profiles directory, or it is unreadable: the default root stands.
      pass
  if os.environ.get("PI_CODING_AGENT_DIR", "").strip():
    roots.append(Path(os.environ["PI_CODING_AGENT_DIR"].strip()).expanduser() / "sessions")
  if os.environ.get("PI_CODING_AGENT_SESSION_DIR", "").strip():
    roots.append(Path(os.environ["PI_CODING_AGENT_SESSION_DIR"].strip()).expanduser())
  return canonical_roots(roots)


# Canonical roots, so an override that aliases a default root through a
# symlink is scanned under one spelling. A root inside another is already
# read with it, so it is dropped rather than counted twice.
def canonical_roots(roots):
  canonical = list(dict.fromkeys(root.resolve() for root in roots))
  return [root for root in canonical if not any(other != root and root.is_relative_to(other) for other in canonical)]


# OpenClaw keeps pi's transcript format, one directory per agent, beside
# pi's and omp's own trees.
def session_roots():
  roots = pi_session_roots()
  openclaw = Path(os.environ.get("OPENCLAW_STATE_DIR") or (Path.home() / ".openclaw"))
  try:
    # Sorted so the scan order doesn't depend on directory order.
    roots.extend(sorted(child / "sessions" for child in (openclaw / "agents").iterdir() if child.is_dir()))
  except OSError:
    pass
  return canonical_roots(roots)


def opencode_database():
  # OPENCODE_DB points opencode at another database, as the CLI itself reads
  # it; a relative name lives beside the default one. Only a build whose
  # channel was literally "v2" wrote opencode-v2.db, so it is a fallback for
  # those installs alone.
  root = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share")) / "opencode"
  configured = os.environ.get("OPENCODE_DB", "").strip()
  if configured:
    path = Path(configured).expanduser()
    return path if path.is_absolute() else root / path
  normal = root / "opencode.db"
  legacy = root / "opencode-v2.db"
  return legacy if not normal.is_file() and legacy.is_file() else normal


# A pi or opencode row's day, read as every collector reading those sources
# reads it: a row with no time at all is today's, and an untrusted time is
# None, so the caller skips that row alone.
def source_day(value):
  if value is None:
    return datetime.now().astimezone().date().isoformat()
  return local_day(value) or None


# pi, omp, and the harnesses that copy their format spell usage camelCase or
# snake_case; the first spelling present wins.
def usage_tokens(usage, *keys):
  for key in keys:
    if key in usage:
      return number(usage.get(key))
  return 0


# Each answer pi, omp, or OpenClaw got through its google-antigravity
# provider: the session it belongs to, its day, its model, and its input,
# output, cache read, and cache write tokens.
def session_messages(problems):
  roots = [root for root in session_roots() if root.is_dir()]
  rg = shutil.which("rg") if roots else None
  if roots and not rg:
    problems.append("rg")
    return
  seen = set()
  for root in roots:
    try:
      proc = subprocess.Popen(
        # --no-ignore: these are data files, not a source tree. A home that
        # is itself a git checkout would otherwise hide every session file
        # behind its ignore rules.
        [rg, "--json", "--no-ignore", "-e", r'"provider"\s*:\s*"google-antigravity"', str(root)],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, errors="replace",
      )
    except OSError:
      problems.append(str(root))
      continue
    for raw in proc.stdout:
      try:
        event = json.loads(raw)
        if event.get("type") != "match":
          continue
        path = event["data"]["path"]["text"]
        entry = json.loads(event["data"]["lines"]["text"])
      except (ValueError, KeyError, TypeError, AttributeError):
        continue
      if not isinstance(entry, dict) or entry.get("type") != "message":
        continue
      message = entry.get("message") if isinstance(entry.get("message"), dict) else {}
      if message.get("role") != "assistant" or message.get("provider") != "google-antigravity":
        continue
      # A fork copies its parent's entries, and they keep their id and time,
      # so each answer counts once. An entry without an id always counts.
      if entry.get("id"):
        key = (str(entry["id"]), str(entry["timestamp"])) if entry.get("timestamp") else (path, str(entry["id"]))
        if key in seen:
          continue
        seen.add(key)
      usage = message.get("usage") if isinstance(message.get("usage"), dict) else {}
      tokens = (
        usage_tokens(usage, "input", "inputTokens", "input_tokens"),
        # pi folds thinking into its own field; both are generated.
        usage_tokens(usage, "output", "outputTokens", "output_tokens") + usage_tokens(usage, "reasoning", "reasoningTokens", "reasoning_tokens"),
        usage_tokens(usage, "cacheRead", "cacheReadTokens", "cache_read", "cache_read_input_tokens"),
        usage_tokens(usage, "cacheWrite", "cacheWriteTokens", "cache_write", "cache_creation_input_tokens"),
      )
      if not any(tokens):
        # Some writers keep only the total; it was still spent.
        tokens = (usage_tokens(usage, "totalTokens", "total_tokens"), 0, 0, 0)
      if not any(tokens):
        continue
      # The first time present decides: none at all is today's, and an
      # untrusted one, zero included, skips only this line.
      stamp = entry.get("timestamp")
      day = source_day(message.get("timestamp") if stamp is None else stamp)
      if day is None:
        continue
      model = message.get("model") if isinstance(message.get("model"), str) else ""
      yield path, day, model_key(model) or "unknown", tokens
    try:
      # rg exits 1 for no match and 2 when it couldn't read something.
      if proc.wait(timeout=1) not in (0, 1):
        problems.append(str(root))
    except subprocess.TimeoutExpired:
      proc.kill()
      problems.append(str(root))


def opencode_columns(conn, table):
  try:
    return {row[1] for row in conn.execute(f"PRAGMA table_info({table})")}
  except sqlite3.Error:
    return set()


# One opencode row as (day, model, counts), or None. The original `message`
# table keeps the role, provider and model at the top level; the V2
# `session_message` table nests the provider and model under `model` and
# keeps the role in its `type` column, with a compaction's tokens spent like
# any reply's. opencode's Antigravity plugin runs under a "google" provider,
# with model ids it prefixes with antigravity- to keep them apart from Gemini
# API ones.
def opencode_row(entry, row_type, created):
  if not isinstance(entry, dict) or (entry.get("role") or row_type) not in ("assistant", "compaction"):
    return None
  info = entry.get("model") if isinstance(entry.get("model"), dict) else {}
  provider = entry.get("providerID") or info.get("providerID")
  model = entry.get("modelID") or info.get("id")
  if not str(provider or "").startswith("google") or not str(model or "").startswith("antigravity-"):
    return None
  tokens = entry.get("tokens") if isinstance(entry.get("tokens"), dict) else {}
  cache = tokens.get("cache") if isinstance(tokens.get("cache"), dict) else {}
  # opencode keeps thinking tokens out of output; both are generated.
  counts = (number(tokens.get("input")), number(tokens.get("output")) + number(tokens.get("reasoning")), number(cache.get("read")), number(cache.get("write")))
  if not any(counts):
    return None
  # The message's own time, else the row's: none at all is today's, and an
  # untrusted one, zero included, skips only this row.
  times = entry.get("time") if isinstance(entry.get("time"), dict) else {}
  stamp = times.get("created")
  day = source_day(created if stamp is None else stamp)
  if day is None:
    return None
  return day, model_key(str(model)), counts


# Every opencode row that may be the Antigravity plugin's, from both stores,
# V2 first, deduplicated by message id: a build that migrated keeps reading,
# and a message in both counts once. Read-only: opencode may be writing right
# now. A scan cut short by a database error keeps what it already read, but
# is reported so it isn't cached.
def opencode_messages(problems):
  database = opencode_database()
  if not database.is_file():
    return
  try:
    conn = sqlite3.connect(database.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
  except sqlite3.Error:
    problems.append("opencode")
    return
  rows = []
  try:
    conn.execute("PRAGMA query_only = ON")
    tables = {name for (name,) in conn.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
    # The LIKE gates skip rows that cannot name an antigravity- model before
    # any parse; opencode_row stays the authority.
    columns = opencode_columns(conn, "session_message") if "session_message" in tables else set()
    if {"id", "session_id", "type", "data"} <= columns:
      created = "m.time_created" if "time_created" in columns else "NULL"
      source = "session_message m"
      fork_filter = ""
      if "time_created" in columns and "session_v2" in tables and {"id", "fork_session_id", "time_created"} <= opencode_columns(conn, "session_v2"):
        # A fork copies its source session's messages under new ids; only
        # what came after the fork was spent in it.
        source += " LEFT JOIN session_v2 s ON s.id = m.session_id"
        fork_filter = " AND (s.fork_session_id IS NULL OR m.time_created >= s.time_created)"
      for row in conn.execute(
        f"SELECT m.id, m.session_id, m.type, {created}, m.data FROM {source}"
        " WHERE m.type IN ('assistant', 'compaction') AND m.data LIKE '%antigravity-%'" + fork_filter
      ):
        rows.append(row)
    columns = opencode_columns(conn, "message") if "message" in tables else set()
    if {"session_id", "data"} <= columns:
      row_id = "id" if "id" in columns else "rowid"
      for message_id, session, raw in conn.execute(f"SELECT {row_id}, session_id, data FROM message WHERE data LIKE '%antigravity-%'"):
        rows.append((message_id, session, "", None, raw))
  except sqlite3.Error:
    problems.append("opencode")
  finally:
    conn.close()
  seen = set()
  for message_id, session, row_type, created, raw in rows:
    try:
      row = opencode_row(json.loads(raw), str(row_type or ""), created)
    except (ValueError, TypeError, AttributeError):
      continue
    if row is None or str(message_id) in seen:
      continue
    seen.add(str(message_id))
    day, model, counts = row
    # One key per session id across both stores: a migrated session is one.
    yield "opencode:" + str(session), day, model, counts


# Hermes reaches Antigravity only through plugins that run agy itself, so its
# sign-in and transcripts are agy's own, which local_stats reads already.
def harness_messages(problems):
  yield from session_messages(problems)
  yield from opencode_messages(problems)


# Every prompt from history.jsonl, every conversation from it and from the
# conversation summaries, and the tokens each model step in a transcript
# reports. Steps that report no usage add no tokens; steps without a usable
# date still count toward the lifetime totals. Antigravity driven from
# another harness adds each answer it recorded as a prompt, the way the
# Codex collector counts them, with every token it reports.
def local_stats(root, problems=None):
  problems = [] if problems is None else problems
  today = datetime.now().astimezone().date()
  week = [(today - timedelta(days=offset)).isoformat() for offset in range(6, -1, -1)]
  today = today.isoformat()
  by_day = {day: 0 for day in week}
  prompts = today_prompts = today_tokens = 0
  days, sessions, today_sessions = set(), set(), set()
  today_by_model, models = {}, {}

  # A subagent's conversation is part of the one that spawned it, so it
  # counts toward that conversation rather than as a session of its own.
  summaries = conversation_summaries(root, problems)
  parents = {str(conversation): str(parent) for conversation, _, parent in summaries if conversation and parent}

  def session_of(conversation):
    conversation, seen = str(conversation), set()
    while conversation in parents and conversation not in seen:
      seen.add(conversation)
      conversation = parents[conversation]
    return conversation

  for entry in history_entries(root, problems):
    day = local_day(entry.get("timestamp"))
    if not day:
      continue
    prompts += 1
    days.add(day)
    conversation = entry.get("conversationId") or entry.get("conversation_id") or entry.get("sessionId")
    if conversation:
      sessions.add(session_of(conversation))
    if day == today:
      today_prompts += 1
      if conversation:
        today_sessions.add(session_of(conversation))

  for conversation, modified, _ in summaries:
    if conversation:
      sessions.add(session_of(conversation))
      if local_day(modified) == today:
        today_sessions.add(session_of(conversation))

  for transcript in (root / "brain").glob("*/.system_generated/logs/transcript.jsonl"):
    try:
      lines = transcript.read_text(encoding="utf-8", errors="ignore").splitlines()
    except OSError:
      problems.append(str(transcript))
      continue
    # The model a conversation runs on carries from step to step until a
    # step names another one.
    current = ""
    for line in lines:
      try:
        step = json.loads(line)
      except ValueError:
        continue
      if not isinstance(step, dict):
        continue
      current = step_model(step) or selected_model(step) or current
      tokens = step_tokens(step)
      if not tokens or not any(tokens):
        continue
      model = current or "unknown"
      bucket = model_bucket(models, model)
      bucket["inputTokens"] += tokens[0]
      bucket["outputTokens"] += tokens[1]
      bucket["cacheReadInputTokens"] += tokens[2]
      bucket["cacheCreationInputTokens"] += tokens[3]
      total = sum(tokens)
      day = local_day(step.get("created_at") or step.get("timestamp"))
      if day:
        days.add(day)
      if day in by_day:
        by_day[day] += total
      if day == today:
        today_tokens += total
        today_by_model[model] = today_by_model.get(model, 0) + total

  for session, day, model, counts in harness_messages(problems):
    total = sum(counts)
    prompts += 1
    sessions.add(session)
    bucket = model_bucket(models, model)
    bucket["inputTokens"] += counts[0]
    bucket["outputTokens"] += counts[1]
    bucket["cacheReadInputTokens"] += counts[2]
    bucket["cacheCreationInputTokens"] += counts[3]
    if day:
      days.add(day)
    if day in by_day:
      by_day[day] += total
    if day == today:
      today_prompts += 1
      today_sessions.add(session)
      today_tokens += total
      today_by_model[model] = today_by_model.get(model, 0) + total

  return {
    "hasLocalStats": prompts > 0 or bool(sessions) or bool(models),
    "todayPrompts": today_prompts,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": today_tokens,
    "todayTokensByModel": today_by_model,
    "recentDays": [{"date": day, "messageCount": by_day[day]} for day in week],
    "totalPrompts": prompts,
    "totalSessions": len(sessions),
    "activeDays": len(days),
    "activeDates": sorted(days),
    "modelUsage": models,
  }


# A scan is reused for max_age seconds, and only on the day it was made: one
# from before midnight would count yesterday's prompts as today's. The scan
# is rebuilt under a lock so overlapping runs don't each walk the history,
# and one that couldn't read every source isn't kept.
def cached_local_stats(root, max_age):
  sources = [str(root), str(opencode_database())] + [str(path) for path in session_roots()]
  digest = hashlib.sha256("\n".join(sources).encode()).hexdigest()[:16]
  cache = cache_root() / f"agy-scan-{digest}.json"
  today = datetime.now().astimezone().date().isoformat()

  def reusable():
    cached = read_json(cache)
    if not isinstance(cached, dict) or cached.get("scanDate") != today or not isinstance(cached.get("stats"), dict):
      return None
    try:
      age = time.time() - float(cached.get("at"))
    except (TypeError, ValueError):
      return None
    return cached["stats"] if 0 <= age < max_age else None

  stats = reusable() if max_age > 0 else None
  if stats is not None:
    return stats
  cache.parent.mkdir(parents=True, exist_ok=True)
  with open(cache.with_suffix(".lock"), "w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    stats = reusable() if max_age > 0 else None
    if stats is not None:
      return stats
    problems = []
    stats = local_stats(root, problems)
    if not problems:
      write_json(cache, {"scanDate": today, "at": time.time(), "stats": stats})
    return stats


def main():
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  args = parser.parse_args()

  if args.force:
    scan_age = 0
  elif args.limits_only:
    scan_age = LIMITS_ONLY_REUSE_SECONDS
  else:
    scan_age = SCAN_REUSE_SECONDS
  stats = cached_local_stats(app_root(), scan_age)

  # Nobody signed in to Antigravity here and no local history: no limits and
  # no plan, and the panel skips the record.
  entries = logins()
  ready = bool(entries) or bool(stats.get("hasLocalStats"))
  limits = collect_limits(entries, args.force) if ready else {
    "limits": [], "tierLabel": "", "usageStatusText": "", "authHelpText": "", "live": False, "fetchedAtMs": 0, "retryAdvised": False,
  }
  tier = limits["tierLabel"]
  agy = next((e for e in entries if e["source"] == "agy"), None)
  if not tier and agy and agy["authMethod"] == "enterprise":
    tier = "Enterprise"
  elif not tier and agy and agy["authMethod"] in ("cloud", "vertex"):
    tier = "Cloud"

  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "ready": ready,
    "tierLabel": tier,
    "usageStatusText": limits["usageStatusText"],
    "authHelpText": limits["authHelpText"],
    "limits": limits["limits"],
    "limitsStale": not limits["live"],
    "limitsFetchedAt": limits["fetchedAtMs"],
    "retryAdvised": limits["retryAdvised"],
  }
  record.update(stats)
  print(json.dumps(record, separators=(",", ":")))


if __name__ == "__main__":
  main()
