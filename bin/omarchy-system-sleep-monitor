#!/bin/bash

# omarchy:summary=Monitor sleep preparation and lock before suspend
# omarchy:group=system
# omarchy:hidden=true

# A resume can light the panels with no input, no output change and no event
# the lock hears. This monitor has to exit to release the sleep inhibitor, so a
# watcher of its own, outside this service, waits for the wake and tells the
# lock to look. It is started and listening before the inhibitor is released.
schedule_resume_refresh() {
  timeout --kill-after=0.1s 1s systemd-run --user --quiet --collect \
    --property=RuntimeMaxSec=1d \
    "$OMARCHY_PATH/bin/omarchy-system-sleep-monitor" --resume >/dev/null 2>&1 || true
}

consume_resume_events() {
  local line

  while IFS= read -r line; do
    if [[ $line == *"boolean false"* ]]; then
      "$OMARCHY_PATH/bin/omarchy-shell" -q lock refreshDisplays
      return 0
    fi
  done
}

consume_sleep_events() {
  local line sleep_lock
  sleep_lock="$OMARCHY_PATH/bin/omarchy-system-sleep-lock"

  while IFS= read -r line; do
    if [[ $line == *"boolean true"* ]]; then
      "$sleep_lock"
      schedule_resume_refresh
      return 0
    fi
  done
}

monitor_sleep_events() {
  local consumer=$1 monitor_fd monitor_pid status

  coproc SLEEP_EVENTS {
    exec dbus-monitor --system \
      "type='signal',sender='org.freedesktop.login1',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'"
  }
  monitor_fd=${SLEEP_EVENTS[0]}
  monitor_pid=$SLEEP_EVENTS_PID

  cleanup_monitor() {
    kill "$monitor_pid" 2>/dev/null || true
    wait "$monitor_pid" 2>/dev/null || true
  }
  trap cleanup_monitor EXIT

  "$consumer" <&"$monitor_fd"
  status=$?
  cleanup_monitor
  trap - EXIT

  return "$status"
}

case ${1:-} in
  --consume)
    consume_sleep_events
    exit 0
    ;;
  --inhibited)
    monitor_sleep_events consume_sleep_events
    exit 0
    ;;
  --resume)
    monitor_sleep_events consume_resume_events
    exit 0
    ;;
esac

sleep_monitor="$OMARCHY_PATH/bin/omarchy-system-sleep-monitor"

exec systemd-inhibit \
  --what=sleep \
  --mode=delay \
  --who=Omarchy \
  --why="Lock screen before suspend" \
  "$sleep_monitor" --inhibited
