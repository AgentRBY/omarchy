#!/usr/bin/python3
# omarchy:summary=Print the Grok Bot usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Grok Bot usage into one display-ready JSON record.

Grok Bot runs on a Cursor account, but its weekly allowance is metered apart
from Cursor's own plan: the dashboard's GetSandUsageStatus RPC (Sand is Grok
Bot's internal name) says how much of this week's included usage is gone and
when it resets. It is asked as the same account the Cursor collector reads,
found the same way, so the two never describe different people. Grok Bot
keeps nothing countable on disk, so the record carries the limit alone, and
an account without a Grok Bot allowance gives an unused record, which the
panel skips. The agents panel only ever reads the JSON this prints.
"""

import argparse
import base64
import hashlib
import http.client
import json
import math
import os
import sqlite3
import tempfile
import urllib.error
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

AGENT_ID = "grokbot"
AGENT_NAME = "Grok Bot"
AUTH_HELP = "Sign in to the Cursor editor, or run `cursor-agent login`, with your Grok Bot account."
USAGE_URL = "https://api2.cursor.sh/aiserver.v1.DashboardService/GetSandUsageStatus"
# Repeated panel opens reuse an answer this recent instead of asking again;
# --force (a person pressing refresh) always asks.
PROBE_MIN_INTERVAL_SECONDS = 15


def config_home():
  return Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))


def cache_root():
  return Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy" / "agent-usage"


def now_ms():
  return int(datetime.now(timezone.utc).timestamp() * 1000)


def finite(value):
  if isinstance(value, bool):
    return 0.0
  try:
    parsed = float(value or 0)
  except (TypeError, ValueError):
    return 0.0
  return parsed if math.isfinite(parsed) else 0.0


def read_json(path):
  try:
    data = json.loads(Path(path).read_text(encoding="utf-8"))
  except (OSError, ValueError):
    return {}
  return data if isinstance(data, dict) else {}


# A temporary file of its own per write, so overlapping runs can't rename
# each other's away.
def write_json(path, payload):
  path.parent.mkdir(parents=True, exist_ok=True)
  fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
  try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
      json.dump(payload, handle)
    os.replace(tmp, path)
  except Exception:
    Path(tmp).unlink(missing_ok=True)
    raise


def parse_time(value):
  try:
    parsed = datetime.fromisoformat(str(value or "").replace("Z", "+00:00"))
  except ValueError:
    return None
  return parsed if parsed.tzinfo else parsed.replace(tzinfo=timezone.utc)


# The editor's sign-in, read-only: the editor may be writing its database
# right now. No immutable=1, so a live database with an active WAL still reads.
def read_ide_token(state_db):
  if not state_db.is_file():
    return ""
  try:
    conn = sqlite3.connect(state_db.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
  except sqlite3.Error:
    return ""
  try:
    conn.execute("PRAGMA query_only = ON")
    row = conn.execute("SELECT value FROM ItemTable WHERE key = 'cursorAuth/accessToken' LIMIT 1").fetchone()
  except sqlite3.Error:
    return ""
  finally:
    conn.close()
  value = row[0] if row else ""
  if isinstance(value, bytes):
    value = value.decode("utf-8", errors="replace")
  return str(value or "").strip()


def read_cli_token(path):
  data = read_json(path)
  return str(data.get("accessToken") or "").strip()


def jwt_claims(token):
  parts = token.split(".")
  if len(parts) != 3:
    return {}
  try:
    claims = json.loads(base64.urlsafe_b64decode(parts[1] + "=" * (-len(parts[1]) % 4)))
  except (ValueError, UnicodeDecodeError):
    return {}
  return claims if isinstance(claims, dict) else {}


# A sign-in token whose expiry has passed. The CLI and the editor each renew
# their own the next time they run; an opaque API key never lapses here.
def token_lapsed(token):
  expires = finite(jwt_claims(token).get("exp"))
  return 0 < expires <= datetime.now(timezone.utc).timestamp()


# The same account the Cursor collector reads, found the same way: the key
# the user exported, the credential the Cursor CLI stores, or the editor's
# sign-in. A lapsed sign-in gives way to the next one that hasn't lapsed;
# with all of them lapsed, the first one decides.
def read_token():
  key = str(os.environ.get("CURSOR_API_KEY") or "").strip()
  if key:
    return key
  cli = read_cli_token(config_home() / "cursor" / "auth.json")
  if cli and not token_lapsed(cli):
    return cli
  ide = read_ide_token(config_home() / "Cursor" / "User" / "globalStorage" / "state.vscdb")
  if ide and not token_lapsed(ide):
    return ide
  return cli or ide


# Who the token signs in as (the JWT's subject), so a machine signed in to
# someone else never shows the last one's limit, and a refreshed token keeps
# the same cache. An opaque API key keys by its own hash.
def account_key(token):
  subject = str(jwt_claims(token).get("sub") or "")
  return hashlib.sha256((subject or token).encode("utf-8")).hexdigest()[:16]


def fetch_status(token):
  request = urllib.request.Request(
    USAGE_URL,
    data=b"{}",
    headers={
      "Content-Type": "application/json",
      "Connect-Protocol-Version": "1",
      "Authorization": f"Bearer {token}",
      "x-cursor-client-type": "cli",
    },
    method="POST",
  )
  with urllib.request.urlopen(request, timeout=15) as response:
    status = json.loads(response.read() or b"{}")
  if not isinstance(status, dict):
    raise ValueError("not an object")
  return status


# The answer is protobuf JSON, which leaves out a field holding zero or
# false: no included limit means no Grok Bot allowance on this account, and
# a week with nothing used yet has no percentage at all.
def weekly_limits(status):
  if status.get("hasNonZeroIncludedLimit") is not True:
    return []
  resets = parse_time(status.get("nextResetTimestampUtc"))
  return [{
    "label": "Weekly",
    "percent": max(0.0, min(1.0, finite(status.get("usagePercent")) / 100)),
    "resetsAt": resets.isoformat() if resets else "",
  }]


# A kept week that has ended is a fresh allowance, so it comes back at zero
# with no reset time until a check says when the next one ends. One with no
# known end is kept as it is.
def open_limits(limits):
  now = datetime.now(timezone.utc)
  kept = []
  for limit in limits if isinstance(limits, list) else []:
    if not isinstance(limit, dict):
      continue
    resets = parse_time(limit.get("resetsAt")) if limit.get("resetsAt") else None
    kept.append(limit if resets is None or resets > now else dict(limit, percent=0.0, resetsAt=""))
  return kept


def empty_recent_days():
  """The last seven local days ending today, each with no messages."""
  today = datetime.now().astimezone().date()
  return [{"date": (today - timedelta(days=offset)).isoformat(), "messageCount": 0} for offset in range(6, -1, -1)]


def empty_record():
  return {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "ready": False,
    "hasLocalStats": False,
    "hasPromptStats": False,
    "tierLabel": "",
    "usageStatusText": "",
    "authHelpText": "",
    "limits": [],
    "limitsStale": False,
    "limitsFetchedAt": 0,
    "todayPrompts": 0,
    "todaySessions": 0,
    "todayTotalTokens": 0,
    "todayTokensByModel": {},
    "recentDays": empty_recent_days(),
    "totalPrompts": 0,
    "totalSessions": 0,
    "activeDays": 0,
    "activeDates": [],
    "modelUsage": {},
  }


def collect(force=False):
  record = empty_record()
  # Without a sign-in there is no telling whether this account has Grok Bot
  # at all, so the machine reads as not using it; the Cursor collector is the
  # one that asks for a sign-in.
  token = read_token()
  if not token:
    return record

  cache = cache_root() / f"grokbot-limits-{account_key(token)}.json"
  cached = read_json(cache)
  kept = open_limits(cached.get("limits"))
  fetched_at = max(0, round(finite(cached.get("fetchedAtMs"))))
  kept_tier = str(cached.get("tierLabel") or "")

  # A panel opened and shut repeatedly must not turn into a request per
  # flick, so an answer this recent is the answer.
  age = now_ms() - fetched_at
  if not force and fetched_at > 0 and isinstance(cached.get("limits"), list) and 0 <= age < PROBE_MIN_INTERVAL_SECONDS * 1000:
    record.update(ready=bool(kept), tierLabel=kept_tier, limits=kept, limitsFetchedAt=fetched_at)
    return record

  retry = False
  if token_lapsed(token):
    status = "Limits paused"
    detail = "Cursor's access token has lapsed. Open the Cursor editor, or run `cursor-agent`, to renew it; signing in again is not needed."
  else:
    try:
      answer = fetch_status(token)
      limits = weekly_limits(answer)
    except urllib.error.HTTPError as error:
      if error.code in (401, 403):
        status, detail = "Sign-in expired", "Cursor refused the saved sign-in. " + AUTH_HELP
      else:
        status, detail = "", f"Cursor's dashboard returned status {error.code}."
    # A reply cut short or one that isn't the expected JSON came from a
    # server that answered.
    except (http.client.HTTPException, ValueError, TypeError, AttributeError):
      status, detail = "", "Cursor's dashboard sent a reply that couldn't be read."
    # No route, no DNS, refused, reset or timed out: nothing answered, so the
    # panel tries again soon.
    except OSError:
      status, detail, retry = "", "Couldn't reach Cursor's dashboard. Retrying shortly.", True
    else:
      tier = str(answer.get("grokPlanLabel") or "")
      fetched_at = now_ms()
      record.update(ready=bool(limits), tierLabel=tier, limits=limits, limitsFetchedAt=fetched_at)
      # The cache only backs later runs; failing to keep it never costs this
      # run's live answer.
      try:
        write_json(cache, {"fetchedAtMs": fetched_at, "tierLabel": tier, "limits": limits})
      except OSError:
        pass
      return record

  # A failed check keeps the last good limit, marked stale so the panel
  # gives its age on hover. With nothing kept the record stays unused, so a
  # Cursor account that never had Grok Bot doesn't appear on a blip.
  record.update(
    ready=bool(kept),
    tierLabel=kept_tier if kept else "",
    usageStatusText=status or ("" if kept else "Grok Bot limits unavailable"),
    authHelpText=detail + (" Showing the last known limit." if kept else ""),
    limits=kept,
    limitsStale=True,
    limitsFetchedAt=fetched_at if kept else 0,
  )
  if retry:
    record["retryAdvised"] = True
  return record


def main():
  parser = argparse.ArgumentParser(description="Print the Grok Bot usage record as JSON")
  parser.add_argument("--force", action="store_true")
  # Grok Bot has no local scan to reuse, so a near-limit refresh is a normal
  # run; the flag keeps the invocation every collector takes.
  parser.add_argument("--limits-only", action="store_true")
  args = parser.parse_args()
  print(json.dumps(collect(force=args.force), separators=(",", ":")))


if __name__ == "__main__":
  main()
