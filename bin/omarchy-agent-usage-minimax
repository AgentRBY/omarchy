#!/usr/bin/python3
# omarchy:summary=Print the MiniMax Token Plan usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect MiniMax usage into a display-ready JSON record.

The 5-hour session and weekly windows come from MiniMax's Token Plan API with
the key MiniMax's own `mmx` CLI, opencode, or pi saved. Each credential's last
good limits are cached, so a failed check keeps showing them, marked stale,
rather than dropping the section.

Local stats come from MiniMax Code's own session files, and from pi/omp and
opencode sessions that ran on a MiniMax provider. The agents panel only ever
reads the JSON this prints.
"""

from __future__ import annotations

import argparse
import base64
import contextlib
import fcntl
import hashlib
import json
import math
import os
import sqlite3
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any, Iterator

AGENT_ID = "minimax"
AGENT_NAME = "MiniMax"
DEFAULT_BASE_URL = "https://api.minimax.io"
CN_BASE_URL = "https://api.minimaxi.com"
AUTH_HELP = "Set MINIMAX_API_KEY, or sign in to MiniMax in opencode, to show Token Plan limits."
AUTH_HELP_BAD_KEY = "MiniMax rejected the saved credentials. Set MINIMAX_API_KEY, or sign in to MiniMax again with `mmx` or opencode."
# The plan the quota endpoint describes: only a Token Plan has these windows.
TIER_LABEL = "Token Plan"
# The pi/omp and opencode provider names MiniMax bills, by region. Exact
# names: a custom gateway in front of MiniMax is not this account.
PROVIDERS = ("minimax", "minimax-cn", "minimax-coding-plan", "minimax-cn-coding-plan")
# A scan this recent is only reused to dedup concurrent collector runs (the
# update command backgrounds one per agent while the panel refreshes on its
# own). --limits-only promises only fresh limits, so it may reuse a scan for
# up to 15 minutes.
SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900
# The panel opens and shuts fire a probe each; a recent probe result is reused
# for this window rather than turning every flick into a request.
PROBE_MIN_INTERVAL_SECONDS = 15
# Bounds for numbers read from session files. A timestamp outside them, or a
# token count above the cap, is corruption rather than usage.
EARLIEST_SECONDS = 946_684_800  # 2000-01-01
LATEST_SECONDS = 4_102_444_800  # 2100-01-01
MAX_TOKENS = 10_000_000_000
# base_resp codes MiniMax answers a bad key with: 1004 is an authentication
# failure, 2049 an invalid API key.
AUTH_STATUS_CODES = {1004, 2049}
# The quota rows for MiniMax's media models ride on allowances of their own
# (video and image generation, speech, vision) and are not the coding plan.
MEDIA_MODEL_WORDS = ("video", "image", "audio", "vision")


class MiniMaxError(Exception):
  def __init__(self, message: str, transport: bool = False, rejected: bool = False) -> None:
    super().__init__(message)
    self.transport = transport
    self.rejected = rejected


def recent_dates() -> list[str]:
  now = datetime.now()
  return [(now - timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]


def empty_stats() -> dict[str, Any]:
  return {
    "todayPrompts": 0,
    "todaySessions": 0,
    "todayTotalTokens": 0,
    "todayTokensByModel": {},
    "recentDays": [{"date": day, "messageCount": 0} for day in recent_dates()],
    "totalPrompts": 0,
    "totalSessions": 0,
    "activeDays": 0,
    "activeDates": [],
    "modelUsage": {},
  }


def base_record(**overrides: Any) -> dict[str, Any]:
  record: dict[str, Any] = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "ready": False,
    "hasLocalStats": False,
    "hasPromptStats": True,
    "tierLabel": "",
    "usageStatusText": "",
    "authHelpText": "",
    "limits": [],
    "limitsStale": False,
    "limitsFetchedAt": 0,
  }
  record.update(empty_stats())
  record.update(overrides)
  return record


def cache_root() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def read_json(path: Path) -> Any:
  try:
    return json.loads(path.read_text(encoding="utf-8"))
  except Exception:
    return None


# A temporary file of its own per write, so overlapping runs can't rename
# each other's away.
def write_json(path: Path, payload: Any) -> None:
  path.parent.mkdir(parents=True, exist_ok=True)
  fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
  try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
      json.dump(payload, handle)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
  except Exception:
    Path(tmp).unlink(missing_ok=True)
    raise


def limits_cache_paths(api_key: str, base_url: str) -> tuple[Path, Path]:
  # Keyed by the credential and the host it signs in to: another key, or the
  # same key in the other region, never shows this one's allowance.
  digest = hashlib.sha256(f"{base_url.rstrip('/')}\0{api_key}".encode("utf-8")).hexdigest()[:16]
  root = cache_root()
  return root / f"minimax-limits-{digest}.json", root / f"minimax-limits-{digest}.lock"


def mmx_config_dir() -> Path:
  return Path(os.path.expandvars(os.path.expanduser(os.environ.get("MMX_CONFIG_DIR", "~/.mmx"))))


def mmx_config() -> dict[str, Any]:
  config_dir = mmx_config_dir()
  parsed = read_json(config_dir / "config.json")
  if isinstance(parsed, dict):
    return parsed

  # Older mmx releases documented YAML configuration. Only read the one scalar
  # we need, avoiding a runtime YAML dependency in the base installation.
  try:
    for line in (config_dir / "config.yaml").read_text(encoding="utf-8").splitlines():
      key, separator, value = line.partition(":")
      if separator and key.strip() == "api_key":
        return {"api_key": value.strip().strip("'\"")}
  except Exception:
    pass
  return {}


def config_key(config: dict[str, Any]) -> str:
  value = config.get("api_key") or config.get("apiKey")
  if isinstance(value, str) and value.strip():
    return value.strip()

  oauth = config.get("oauth")
  if isinstance(oauth, dict):
    token = oauth.get("access_token")
    if isinstance(token, str) and token.strip():
      return token.strip()
  return ""


def config_base_url(config: dict[str, Any]) -> str:
  oauth = config.get("oauth")
  if isinstance(oauth, dict):
    resource_url = oauth.get("resource_url")
    if isinstance(resource_url, str) and resource_url.strip():
      return resource_url.strip()
    if oauth.get("region") == "cn":
      return CN_BASE_URL
  value = config.get("base_url")
  if isinstance(value, str) and value.strip():
    return value.strip()
  if config.get("region") == "cn" or os.environ.get("MINIMAX_REGION") == "cn":
    return CN_BASE_URL
  return DEFAULT_BASE_URL


def opencode_data_dir() -> Path:
  return Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local/share")) / "opencode"


def pi_agent_dir() -> Path:
  configured = os.environ.get("PI_CODING_AGENT_DIR", "").strip()
  return Path(os.path.expanduser(configured)) if configured else Path.home() / ".pi" / "agent"


def saved_key(path: Path, providers: tuple[str, ...]) -> tuple[str, str]:
  """(key, provider) for the first provider `path` holds a literal key for."""
  parsed = read_json(path)
  if not isinstance(parsed, dict):
    return "", ""
  for provider in providers:
    entry = parsed.get(provider)
    if isinstance(entry, dict):
      value = entry.get("key") or entry.get("apiKey") or entry.get("token")
      # A pi `$VAR` or `!command` entry is resolved by pi alone.
      if isinstance(value, str) and value.strip() and not value.strip().startswith(("!", "$")):
        return value.strip(), provider
  return "", ""


def credentials() -> tuple[str, str]:
  config = mmx_config()
  api_key = os.environ.get("MINIMAX_API_KEY", "").strip() or config_key(config)
  base_url = config_base_url(config)
  if not api_key:
    # The key opencode or pi signed in to MiniMax with; a China-region
    # provider's key only answers on the China host.
    for path in (opencode_data_dir() / "auth.json", pi_agent_dir() / "auth.json", Path.home() / ".omp" / "agent" / "auth.json"):
      api_key, provider = saved_key(path, ("minimax", "minimax-coding", "minimax-token-plan") + PROVIDERS[1:])
      if api_key:
        if provider.startswith("minimax-cn"):
          base_url = CN_BASE_URL
        break
  return api_key, os.environ.get("MINIMAX_BASE_URL", "").strip() or base_url


def number(value: Any) -> float | None:
  # Booleans are ints to Python; neither they nor NaN or infinity are numbers
  # the quota API meant.
  if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
    return None
  return float(value)


def reset_at(entry: dict[str, Any], end_key: str, remains_key: str) -> str:
  try:
    end_ms = number(entry.get(end_key))
    if end_ms and end_ms > 0:
      return datetime.fromtimestamp(end_ms / 1000, timezone.utc).isoformat()
    # Without an end time MiniMax still says how long the window has left,
    # which places its own reset rather than guessing one.
    remains_ms = number(entry.get(remains_key))
    if remains_ms and remains_ms > 0:
      return (datetime.now(timezone.utc) + timedelta(milliseconds=remains_ms)).isoformat()
  except (OverflowError, OSError, ValueError):
    pass
  return ""


def used_fraction(remaining: Any) -> float | None:
  percent = number(remaining)
  if percent is None:
    return None
  return max(0.0, min(1.0, 1.0 - percent / 100.0))


def is_media_row(row: dict[str, Any]) -> bool:
  name = str(row.get("model_name") or "").strip().lower()
  return any(word in name for word in MEDIA_MODEL_WORDS)


def quota_limits(payload: dict[str, Any]) -> list[dict[str, Any]]:
  rows = payload.get("model_remains")
  if not isinstance(rows, list):
    raise MiniMaxError("MiniMax returned no Token Plan quotas")

  # "general" is the language/agent quota. Without it the first row that
  # isn't a media model's stands for the plan.
  rows = [row for row in rows if isinstance(row, dict)]
  general = next((row for row in rows if row.get("model_name") == "general"), None)
  if general is None:
    general = next((row for row in rows if not is_media_row(row)), None)
  if general is None:
    raise MiniMaxError("MiniMax returned no usable Token Plan quota")

  limits = []
  interval = used_fraction(general.get("current_interval_remaining_percent"))
  weekly = used_fraction(general.get("current_weekly_remaining_percent"))
  if interval is not None:
    limits.append({
      "label": "Session (5-hour)",
      "percent": interval,
      "resetsAt": reset_at(general, "end_time", "remains_time"),
    })
  if weekly is not None:
    limits.append({
      "label": "Weekly (7-day)",
      "percent": weekly,
      "resetsAt": reset_at(general, "weekly_end_time", "weekly_remains_time"),
    })
  if not limits:
    raise MiniMaxError("MiniMax returned no percentage-based Token Plan quotas")
  return limits


class NoRedirect(urllib.request.HTTPRedirectHandler):
  # A redirect would carry the bearer to whatever host it names.
  def redirect_request(self, req, fp, code, msg, headers, newurl):  # noqa: ANN001
    return None


def urlopen(request: urllib.request.Request, timeout: float) -> Any:
  return urllib.request.build_opener(NoRedirect()).open(request, timeout=timeout)


def fetch_quota(api_key: str, base_url: str) -> dict[str, Any]:
  endpoint = base_url.rstrip("/") + "/v1/token_plan/remains"
  request = urllib.request.Request(
    endpoint,
    headers={"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"},
  )
  try:
    with urlopen(request, timeout=12) as response:
      payload = json.load(response)
  except urllib.error.HTTPError as error:
    if error.code in (401, 403):
      raise MiniMaxError(AUTH_HELP_BAD_KEY, rejected=True) from error
    if 300 <= error.code < 400:
      raise MiniMaxError("MiniMax's quota endpoint redirected elsewhere; the key was not sent on.") from error
    raise MiniMaxError(f"MiniMax's quota endpoint returned HTTP {error.code}.") from error
  except OSError as error:
    # URLError, timeouts and resets alike: no answer from any server.
    raise MiniMaxError("Couldn't reach the MiniMax API. Retrying shortly.", transport=True) from error
  except ValueError as error:
    raise MiniMaxError("MiniMax returned an invalid quota response.") from error

  if not isinstance(payload, dict):
    raise MiniMaxError("MiniMax returned an invalid quota response.")
  base_response = payload.get("base_resp")
  if isinstance(base_response, dict):
    code = number(base_response.get("status_code"))
    if code not in (None, 0):
      if int(code) in AUTH_STATUS_CODES:
        raise MiniMaxError(AUTH_HELP_BAD_KEY, rejected=True)
      message = str(base_response.get("status_msg") or "MiniMax rejected the quota request")[:200]
      raise MiniMaxError(message)
  return payload


# A kept window whose reset has passed comes back at zero: the allowance it
# measured has been renewed, so it is untouched rather than unknown. One with
# no reset time, or one that will not parse, is kept as it is.
def usable_cached_limits(limits: Any) -> list[dict[str, Any]]:
  now = datetime.now(timezone.utc)
  kept = []
  for limit in limits if isinstance(limits, list) else []:
    if not isinstance(limit, dict):
      continue
    try:
      resets = datetime.fromisoformat(str(limit.get("resetsAt") or "").replace("Z", "+00:00"))
    except ValueError:
      resets = None
    if resets and resets.tzinfo is None:
      resets = resets.replace(tzinfo=timezone.utc)
    kept.append(dict(limit, percent=0.0, resetsAt="") if resets and resets <= now else limit)
  return kept


def cached_answer(cache_file: Path) -> tuple[list[dict[str, Any]], int]:
  cached = read_json(cache_file)
  cached = cached if isinstance(cached, dict) else {}
  fetched_ms = number(cached.get("fetchedAtMs"))
  return usable_cached_limits(cached.get("limits")), max(0, int(fetched_ms or 0))


def recent_probe(fetched_ms: int) -> bool:
  # A negative age is a stamp from the future: the clock moved back since it
  # was written, so it proves nothing about freshness.
  age = time.time() - fetched_ms / 1000
  return 0 <= age < PROBE_MIN_INTERVAL_SECONDS


@contextlib.contextmanager
def probe_lock(path: Path) -> Iterator[None]:
  # One probe at a time per credential; a lock that can't be taken only costs
  # a duplicate request, so the probe runs unlocked rather than not at all.
  try:
    handle = path.open("a")
  except OSError:
    yield
    return
  with handle:
    try:
      fcntl.flock(handle, fcntl.LOCK_EX)
    except OSError:
      pass
    yield


def collect_limits(api_key: str, base_url: str, force: bool) -> dict[str, Any]:
  """Fresh limits when a probe is due, else the last known ones.

  `live` says whether the limits are this check's (or a probe recent enough
  to stand in for one), and `fetchedAtMs` when they were measured.
  """
  result = {"limits": [], "usageStatusText": "", "authHelpText": "", "retryAdvised": False, "live": False, "fetchedAtMs": 0}
  cache_file, lock_file = limits_cache_paths(api_key, base_url)

  # --force is a person asking for fresh numbers, so it skips the reuse
  # window; the interval absorbs repeated panel opens, not a refresh press.
  fallback, fetched_ms = cached_answer(cache_file)
  if fallback and not force and recent_probe(fetched_ms):
    result.update(limits=fallback, live=True, fetchedAtMs=fetched_ms)
    return result

  with probe_lock(lock_file):
    if not force:
      # Another run may have probed while this one waited for the lock.
      fallback, fetched_ms = cached_answer(cache_file)
      if fallback and recent_probe(fetched_ms):
        result.update(limits=fallback, live=True, fetchedAtMs=fetched_ms)
        return result
    try:
      limits = quota_limits(fetch_quota(api_key, base_url))
    except MiniMaxError as error:
      failure = error
    except Exception as error:
      # An answer shaped like nothing expected is still a failed check: the
      # kept limits stand.
      failure = MiniMaxError(f"MiniMax's quota check failed ({type(error).__name__}).")
    else:
      result.update(limits=limits, live=True, fetchedAtMs=int(time.time() * 1000))
      try:
        write_json(cache_file, {"fetchedAtMs": result["fetchedAtMs"], "limits": limits})
      except OSError as exc:
        print(f"omarchy-agent-usage-minimax: could not write limits cache ({exc})", file=sys.stderr)
      return result

  # A transport failure reached no server — typically the seconds after login
  # before the network is up — so ask the shell to retry sooner.
  result["retryAdvised"] = failure.transport
  result["authHelpText"] = str(failure)
  if fallback:
    result.update(limits=fallback, fetchedAtMs=fetched_ms)
  if failure.rejected:
    result["usageStatusText"] = "Sign-in expired"
  elif not fallback:
    result["usageStatusText"] = "MiniMax limits unavailable"
  return result


# --------------------------------------------------------------------------
# Local session stats
# --------------------------------------------------------------------------

def token_count(value: Any) -> int:
  # Booleans are ints to Python, and a NaN or negative count would poison
  # every sum it reaches, so anything but a plain finite count reads as none.
  if isinstance(value, bool) or not isinstance(value, (int, float)):
    return 0
  if not math.isfinite(value) or value < 0 or value > MAX_TOKENS:
    return 0
  return int(value)


def local_day(value: Any) -> str | None:
  """The local date of an untrusted timestamp, or None when it isn't one."""
  if isinstance(value, bool):
    return None
  if isinstance(value, (int, float)):
    if not math.isfinite(value):
      return None
    # MiniMax Code, pi, and opencode timestamps are milliseconds.
    seconds = value / 1000 if value > 10_000_000_000 else value
    if not EARLIEST_SECONDS <= seconds < LATEST_SECONDS:
      return None
    return datetime.fromtimestamp(seconds).strftime("%Y-%m-%d")
  if not isinstance(value, str) or not value.strip():
    return None
  try:
    parsed = datetime.fromisoformat(value.strip().replace("Z", "+00:00"))
  except ValueError:
    return None
  if parsed.tzinfo is not None:
    parsed = parsed.astimezone()
  if not 2000 <= parsed.year < 2100:
    return None
  return parsed.strftime("%Y-%m-%d")


def empty_bucket() -> dict[str, int]:
  return {
    "inputTokens": 0,
    "outputTokens": 0,
    "cacheReadInputTokens": 0,
    "cacheCreationInputTokens": 0,
  }


class Stats:
  """Token and activity totals shared by every local source.

  Sessions and days are sets, so a day active in two sources counts once
  toward activeDays.
  """

  def __init__(self) -> None:
    self.today = datetime.now().strftime("%Y-%m-%d")
    self.recent_dates = recent_dates()
    self.recent = {day: 0 for day in self.recent_dates}
    self.today_prompts = 0
    self.today_tokens = 0
    self.today_sessions: set[str] = set()
    self.today_by_model: dict[str, int] = {}
    self.total_prompts = 0
    self.sessions: set[str] = set()
    self.active_dates: set[str] = set()
    self.model_usage: dict[str, dict[str, int]] = {}

  def touch(self, session: str, day: str) -> None:
    self.sessions.add(session)
    self.active_dates.add(day)
    if day == self.today:
      self.today_sessions.add(session)

  def prompt(self, session: str, day: str) -> None:
    self.touch(session, day)
    self.total_prompts += 1
    if day == self.today:
      self.today_prompts += 1

  def tokens(self, session: str, day: str, model: str, inp: int, out: int, cread: int, cwrite: int) -> None:
    self.touch(session, day)
    total = inp + out + cread + cwrite
    bucket = self.model_usage.setdefault(model, empty_bucket())
    bucket["inputTokens"] += inp
    bucket["outputTokens"] += out
    bucket["cacheReadInputTokens"] += cread
    bucket["cacheCreationInputTokens"] += cwrite
    if day in self.recent:
      self.recent[day] += total
    if day == self.today:
      self.today_tokens += total
      self.today_by_model[model] = self.today_by_model.get(model, 0) + total

  def record(self) -> dict[str, Any]:
    return {
      "todayPrompts": self.today_prompts,
      "todaySessions": len(self.today_sessions),
      "todayTotalTokens": self.today_tokens,
      "todayTokensByModel": self.today_by_model,
      "recentDays": [{"date": day, "messageCount": self.recent[day]} for day in self.recent_dates],
      "totalPrompts": self.total_prompts,
      "totalSessions": len(self.sessions),
      "activeDays": len(self.active_dates),
      "activeDates": sorted(self.active_dates),
      "modelUsage": self.model_usage,
    }


def pi_style_tokens(usage: dict[str, Any]) -> tuple[int, int, int, int]:
  inp = token_count(usage.get("input"))
  out = token_count(usage.get("output"))
  cread = token_count(usage.get("cacheRead"))
  cwrite = token_count(usage.get("cacheWrite"))
  if not (inp or out):
    # Only a total: MiniMax's input excludes the cache tokens, which keep
    # their own buckets.
    inp = max(0, token_count(usage.get("totalTokens")) - cread - cwrite)
  return inp, out, cread, cwrite


# pi, omp, and the harnesses that copy their format spell usage camelCase or
# snake_case; the first spelling present wins.
def usage_tokens(usage: dict[str, Any], *keys: str) -> int:
  for key in keys:
    if key in usage:
      return token_count(usage.get(key))
  return 0


def pi_tokens(usage: dict[str, Any]) -> tuple[int, int, int, int]:
  # Read under every spelling the other collectors reading pi accept, with
  # thinking, which pi keeps in its own field, counted as output.
  inp = usage_tokens(usage, "input", "inputTokens", "input_tokens")
  out = usage_tokens(usage, "output", "outputTokens", "output_tokens") + usage_tokens(usage, "reasoning", "reasoningTokens", "reasoning_tokens")
  cread = usage_tokens(usage, "cacheRead", "cacheReadTokens", "cache_read", "cache_read_input_tokens")
  cwrite = usage_tokens(usage, "cacheWrite", "cacheWriteTokens", "cache_write", "cache_creation_input_tokens")
  if not (inp or out):
    # Only a total: MiniMax's input excludes the cache tokens, which keep
    # their own buckets.
    inp = max(0, usage_tokens(usage, "totalTokens", "total_tokens") - cread - cwrite)
  return inp, out, cread, cwrite


# A pi or opencode row's day, read as every collector reading those sources
# reads it: a row with no time at all is today's, and an untrusted time is
# None, so the caller skips that row alone.
def source_day(value: Any) -> str | None:
  return datetime.now().strftime("%Y-%m-%d") if value is None else local_day(value)


def mcode_data_dir() -> Path:
  for name in ("MINIMAX_DATA_DIR", "MAVIS_DATA_DIR"):
    value = os.environ.get(name, "").strip()
    if value:
      return Path(os.path.abspath(os.path.expanduser(value)))
  return Path.home() / ".minimax"


def scan_mcode(stats: Stats) -> bool:
  """Add MiniMax Code's own sessions: user messages are prompts, assistant usage is tokens."""
  root = mcode_data_dir() / "v2" / "sessions"
  if not root.is_dir():
    return True
  complete = True
  for path in sorted(root.rglob("messages.jsonl")):
    # One directory per session; its messages carry no session id of their own.
    session = "mcode:" + str(path.parent)
    try:
      with path.open("r", encoding="utf-8", errors="replace") as handle:
        for raw in handle:
          try:
            entry = json.loads(raw)
          except ValueError:
            continue
          message = entry.get("message") if isinstance(entry, dict) else None
          if not isinstance(message, dict):
            continue
          day = local_day(message.get("timestamp")) or local_day(entry.get("timestamp"))
          if day is None:
            continue
          if message.get("role") == "user":
            stats.prompt(session, day)
            continue
          usage = message.get("usage")
          if message.get("role") != "assistant" or not isinstance(usage, dict):
            continue
          inp, out, cread, cwrite = pi_style_tokens(usage)
          if not (inp or out or cread or cwrite):
            continue
          model = str(message.get("model") or entry.get("model") or "minimax").strip() or "minimax"
          stats.tokens(session, day, model, inp, out, cread, cwrite)
    except OSError:
      complete = False
  return complete


# pi's and omp's session trees, each profile's too: `--profile=<name>` moves
# the whole agent tree under <base>/profiles/<name>/. pi moves its agent tree
# with PI_CODING_AGENT_DIR and its sessions alone with
# PI_CODING_AGENT_SESSION_DIR, both expanding a leading ~; either is read as
# well as the default trees, which keep whatever was written before the move.
def pi_session_roots() -> list[Path]:
  roots: list[Path] = []
  for base in (Path.home() / ".pi", Path.home() / ".omp"):
    roots.append(base / "agent" / "sessions")
    try:
      # Sorted so the scan order does not depend on directory order.
      roots.extend(sorted(child / "agent" / "sessions" for child in (base / "profiles").iterdir() if child.is_dir()))
    except OSError:
      # No profiles directory, or it is unreadable: the default root stands.
      pass
  if os.environ.get("PI_CODING_AGENT_DIR", "").strip():
    roots.append(Path(os.environ["PI_CODING_AGENT_DIR"].strip()).expanduser() / "sessions")
  if os.environ.get("PI_CODING_AGENT_SESSION_DIR", "").strip():
    roots.append(Path(os.environ["PI_CODING_AGENT_SESSION_DIR"].strip()).expanduser())
  # Canonical roots, so an override that aliases a default root through a
  # symlink is scanned under one spelling. A root inside another is already
  # read with it, so it is dropped rather than counted twice.
  canonical = list(dict.fromkeys(root.resolve() for root in roots))
  return [root for root in canonical if not any(other != root and root.is_relative_to(other) for other in canonical)]


def matching_lines(root: Path, pattern: str) -> tuple[list[tuple[str, str]], bool]:
  """(path, line) for each session line matching `pattern`, and whether every file was read."""
  try:
    proc = subprocess.run(
      # --no-ignore: these are data files, not a source tree. When $HOME is
      # itself a git checkout (a common dotfiles setup), its ignore rules
      # would otherwise hide every session file and count zero usage.
      ["rg", "--json", "--no-ignore", "--hidden", "--glob", "*.jsonl", "-e", pattern, str(root)],
      stdout=subprocess.PIPE,
      stderr=subprocess.DEVNULL,
      text=True,
      errors="replace",
      check=False,
    )
  except OSError:
    return [], False
  lines = []
  for raw in proc.stdout.splitlines():
    try:
      event = json.loads(raw)
      if event.get("type") != "match":
        continue
      data = event["data"]
      text = data["lines"].get("text")
      if text is None:
        # rg hands back lines that are not valid UTF-8 as base64.
        text = base64.b64decode(data["lines"]["bytes"]).decode("utf-8", errors="replace")
      lines.append((data["path"].get("text") or "", text))
    except Exception:
      continue
  # 1 is "no match"; 2 means some file could not be read.
  return lines, proc.returncode in (0, 1)


def scan_pi(stats: Stats) -> bool:
  """Add pi/omp assistant turns that ran on a MiniMax provider."""
  complete = True
  # A forked session copies its parent's messages, ids and timestamps alike,
  # so (id, timestamp) counts each once across files. A line with an id but
  # no timestamp dedups within its file only; a line with no id always counts.
  seen: set[tuple[str, ...]] = set()
  pattern = r'"provider"\s*:\s*"(' + "|".join(PROVIDERS) + r')"'
  for root in pi_session_roots():
    if not root.is_dir():
      continue
    lines, read_all = matching_lines(root, pattern)
    complete = complete and read_all
    for path, line in lines:
      try:
        entry = json.loads(line)
      except ValueError:
        continue
      if not isinstance(entry, dict) or entry.get("type") != "message":
        continue
      message = entry.get("message")
      if not isinstance(message, dict) or message.get("role") != "assistant":
        continue
      if str(message.get("provider") or "") not in PROVIDERS:
        continue
      usage = message.get("usage")
      if not isinstance(usage, dict):
        continue
      inp, out, cread, cwrite = pi_tokens(usage)
      if not (inp or out or cread or cwrite):
        continue
      # The first time present decides: none at all is today's, and an
      # untrusted one, zero included, skips only this line.
      stamp = entry.get("timestamp")
      day = source_day(message.get("timestamp") if stamp is None else stamp)
      if day is None:
        continue
      message_id = entry.get("id")
      timestamp = entry.get("timestamp")
      if isinstance(message_id, str) and message_id:
        key = ("entry", message_id, str(timestamp)) if timestamp else ("path", path, message_id)
        if key in seen:
          continue
        seen.add(key)
      # pi counts each assistant turn as the prompt that asked for it.
      stats.prompt(path, day)
      stats.tokens(path, day, str(message.get("model") or "minimax"), inp, out, cread, cwrite)
  return complete


def opencode_db() -> Path:
  # OPENCODE_DB points opencode at another database, as the CLI itself reads
  # it; a relative name lives beside the default one. Only a build whose
  # channel was literally "v2" wrote opencode-v2.db, so it is a fallback for
  # those installs alone.
  root = opencode_data_dir()
  configured = os.environ.get("OPENCODE_DB", "").strip()
  if configured:
    path = Path(configured).expanduser()
    return path if path.is_absolute() else root / path
  normal = root / "opencode.db"
  legacy = root / "opencode-v2.db"
  return legacy if not normal.is_file() and legacy.is_file() else normal


def opencode_columns(conn: sqlite3.Connection, table: str) -> set[str]:
  try:
    return {row[1] for row in conn.execute(f"PRAGMA table_info({table})")}
  except sqlite3.Error:
    return set()


def opencode_row(stats: Stats, message_id: str, session_id: Any, entry: Any, row_type: str, created: Any, seen: set[str]) -> None:
  # Shared by both message stores. The original `message` table keeps the
  # provider and model at the top level; the V2 `session_message` table nests
  # them under `model` and keeps the role in its `type` column, with a
  # compaction's tokens spent like any reply's.
  if not isinstance(entry, dict):
    return
  if (entry.get("role") or row_type) not in ("assistant", "compaction"):
    return
  model = entry.get("model")
  provider = entry.get("providerID") or (model.get("providerID") if isinstance(model, dict) else "")
  if str(provider or "") not in PROVIDERS:
    return
  tokens = entry.get("tokens") if isinstance(entry.get("tokens"), dict) else {}
  cache = tokens.get("cache") if isinstance(tokens.get("cache"), dict) else {}
  inp = token_count(tokens.get("input"))
  # opencode keeps thinking tokens out of output; both are generated.
  out = token_count(tokens.get("output")) + token_count(tokens.get("reasoning"))
  cread = token_count(cache.get("read"))
  cwrite = token_count(cache.get("write"))
  if not (inp or out or cread or cwrite):
    return
  # A migrated message can sit in both stores under the same id.
  if message_id in seen:
    return
  seen.add(message_id)
  # The message's own time, else the row's: none at all is today's, and an
  # untrusted one, zero included, skips only this row.
  timing = entry.get("time") if isinstance(entry.get("time"), dict) else {}
  stamp = timing.get("created")
  day = source_day(created if stamp is None else stamp)
  if day is None:
    return
  session = "opencode:" + str(session_id)
  raw_model = entry.get("modelID") or ((model.get("modelID") or model.get("id")) if isinstance(model, dict) else model)
  name = str(raw_model or "").rstrip("/").split("/")[-1] or "minimax"
  stats.prompt(session, day)
  stats.tokens(session, day, name, inp, out, cread, cwrite)


def scan_opencode_session_messages(stats: Stats, conn: sqlite3.Connection, tables: set[str], seen: set[str]) -> None:
  # The V2 store. The LIKE gate skips rows whose JSON cannot name a MiniMax
  # provider before any parse.
  columns = opencode_columns(conn, "session_message")
  if not {"id", "session_id", "type", "data"} <= columns:
    return
  created = "m.time_created" if "time_created" in columns else "NULL"
  source = "session_message m"
  fork_filter = ""
  if "time_created" in columns and "session_v2" in tables and {"id", "fork_session_id", "time_created"} <= opencode_columns(conn, "session_v2"):
    # A fork copies its source session's messages under new ids; only what
    # came after the fork was spent in it.
    source += " LEFT JOIN session_v2 s ON s.id = m.session_id"
    fork_filter = " AND (s.fork_session_id IS NULL OR m.time_created >= s.time_created)"
  for message_id, session_id, row_type, time_created, raw in conn.execute(
    f"SELECT m.id, m.session_id, m.type, {created}, m.data FROM {source}"
    " WHERE m.type IN ('assistant', 'compaction')"
    " AND m.data LIKE '%\"providerID\"%:%\"minimax%'" + fork_filter
  ):
    # One row that still fails must not take the scan down with it.
    try:
      opencode_row(stats, str(message_id), session_id, json.loads(raw), str(row_type or ""), time_created, seen)
    except Exception:
      continue


def scan_opencode_messages(stats: Stats, conn: sqlite3.Connection, seen: set[str]) -> None:
  # The original store, one row per chat message. The json_extract
  # conditions are the authority; the LIKE gates are pure acceleration that
  # skip rows whose JSON cannot name a MiniMax provider.
  columns = opencode_columns(conn, "message")
  if not {"session_id", "data"} <= columns:
    return
  message_id = "id" if "id" in columns else "rowid"
  placeholders = ",".join("?" for _ in PROVIDERS)
  rows = conn.execute(
    f"SELECT {message_id}, session_id, data FROM message"
    " WHERE data LIKE '%\"role\"%:%\"assistant\"%'"
    " AND data LIKE '%\"providerID\"%:%\"minimax%'"
    " AND CASE WHEN json_valid(data) THEN json_extract(data, '$.role') END = 'assistant'"
    f" AND CASE WHEN json_valid(data) THEN json_extract(data, '$.providerID') END IN ({placeholders})",
    PROVIDERS,
  )
  for row_id, session_id, raw in rows:
    try:
      opencode_row(stats, str(row_id), session_id, json.loads(raw), "", None, seen)
    except Exception:
      continue


def scan_opencode(stats: Stats) -> bool:
  """Add opencode messages on a MiniMax provider, from both of its stores.

  Read-only: opencode may be writing right now.
  """
  db = opencode_db()
  if not db.is_file():
    return True
  try:
    conn = sqlite3.connect(db.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
  except sqlite3.Error:
    return False
  try:
    conn.execute("PRAGMA query_only = ON")
    tables = {name for (name,) in conn.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
    # Both stores, V2 first, deduplicated by message id: a build that
    # migrated keeps reading, and a message in both counts once.
    seen: set[str] = set()
    if "session_message" in tables:
      scan_opencode_session_messages(stats, conn, tables, seen)
    if "message" in tables:
      scan_opencode_messages(stats, conn, seen)
  except sqlite3.Error:
    return False
  finally:
    conn.close()
  return True


def scan_sessions() -> tuple[dict[str, Any], bool]:
  stats = Stats()
  # Every source runs, so one unreadable source still leaves the others.
  complete = [scan_mcode(stats), scan_pi(stats), scan_opencode(stats)]
  return stats.record(), all(complete)


def cached_local_stats(max_age_seconds: float) -> dict[str, Any]:
  """Local stats, with the cache as a pure optimization."""
  sources = [mcode_data_dir(), opencode_db(), *pi_session_roots()]
  digest = hashlib.sha1("\0".join(str(path) for path in sources).encode("utf-8")).hexdigest()[:16]
  try:
    root = cache_root()
  except OSError:
    return scan_sessions()[0]
  cache_file, lock_file = root / f"minimax-scan-{digest}.json", root / f"minimax-scan-{digest}.lock"

  # A scan only answers for the day it ran on: its today* counts would be
  # yesterday's after midnight.
  def reusable() -> dict[str, Any] | None:
    cached = read_json(cache_file)
    if not isinstance(cached, dict) or cached.get("scanDate") != datetime.now().strftime("%Y-%m-%d"):
      return None
    scanned_ms = number(cached.get("scannedAtMs")) or 0
    age = time.time() - scanned_ms / 1000
    stats = cached.get("stats")
    return stats if 0 <= age < max_age_seconds and isinstance(stats, dict) else None

  stats = reusable()
  if stats is not None:
    return stats
  with probe_lock(lock_file):
    stats = reusable()
    if stats is not None:
      return stats
    stats, complete = scan_sessions()
    # A scan that missed a source would stand in for a real one until the
    # next rescan; only a complete one is kept.
    if complete:
      try:
        write_json(cache_file, {"scanDate": datetime.now().strftime("%Y-%m-%d"), "scannedAtMs": int(time.time() * 1000), "stats": stats})
      except OSError as exc:
        print(f"omarchy-agent-usage-minimax: could not write scan cache ({exc})", file=sys.stderr)
    return stats


# --------------------------------------------------------------------------
# Record
# --------------------------------------------------------------------------

# Nobody using MiniMax here: an empty record, which the panel skips. With a
# key, a failed check keeps the last good limits, marked stale; without one,
# local usage still shows and the limits wait for a key.
def collect(api_key: str, base_url: str, force: bool = False, stats: dict[str, Any] | None = None) -> dict[str, Any]:
  record = base_record()
  if stats:
    record.update(stats)
  has_stats = bool(record["modelUsage"]) or record["totalPrompts"] > 0
  record["hasLocalStats"] = has_stats

  if not api_key:
    if has_stats:
      record.update(ready=True, usageStatusText="Waiting for auth", authHelpText=AUTH_HELP)
    return record

  limits = collect_limits(api_key, base_url, force)
  record.update(
    ready=True,
    tierLabel=TIER_LABEL if limits["limits"] else "",
    limits=limits["limits"],
    limitsStale=bool(limits["limits"]) and not limits["live"],
    limitsFetchedAt=limits["fetchedAtMs"],
    usageStatusText=limits["usageStatusText"],
    authHelpText=limits["authHelpText"],
  )
  if limits["retryAdvised"]:
    record["retryAdvised"] = True
  return record


def main() -> int:
  parser = argparse.ArgumentParser(description="Print the MiniMax usage record as JSON")
  # --force rescans and re-probes, ignoring both caches. --limits-only reuses
  # a recent local scan (only the limits probe must be fresh); a bare run
  # reuses a scan only long enough to dedup concurrent collector runs.
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  parser.add_argument("--base-url")
  args = parser.parse_args()

  try:
    scan_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else SCAN_REUSE_SECONDS)
    stats = cached_local_stats(scan_age)
  except Exception as error:
    # Local stats are an addition; their failure must not cost the limits.
    print(f"omarchy-agent-usage-minimax: local scan failed ({type(error).__name__})", file=sys.stderr)
    stats = None

  try:
    api_key, saved_base_url = credentials()
    record = collect(api_key, args.base_url or saved_base_url, args.force, stats)
  except Exception as error:
    record = base_record(usageStatusText="MiniMax limits unavailable", authHelpText="MiniMax usage scan failed.")
    print(f"omarchy-agent-usage-minimax: {type(error).__name__}", file=sys.stderr)
  print(json.dumps(record, separators=(",", ":"), sort_keys=True))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
