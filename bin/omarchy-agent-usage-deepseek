#!/usr/bin/python3
# omarchy:summary=Print the DeepSeek usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect DeepSeek usage into one display-ready JSON record.

Local stats come from pi/omp session files whose assistant messages ran on the
deepseek provider, from opencode sessions that ran on a deepseek provider, and
from DeepSeek Harness (dsh) session logs on its DeepSeek routes. DeepSeek
billing is prepaid, so the record carries the live credit balance from
GET https://api.deepseek.com/user/balance when a key is available, plus the
optional funded/spent detail derived from ~/.config/omarchy/agents/deepseek.json
(the same shape the fireworks collector uses). The agents panel only ever reads
the JSON this prints.

Token accounting deliberately matches pi's own totals: input + output +
cacheRead + cacheWrite, with the separate "reasoning" field left out, exactly
like the codex collector treats pi sessions.
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import math
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from datetime import datetime, timedelta, timezone
from decimal import Decimal, InvalidOperation
from pathlib import Path
from typing import Any

try:
  from compression import zstd
except ImportError:
  zstd = None

AGENT_ID = "deepseek"
AGENT_NAME = "DeepSeek"
API_BASE_URL = "https://api.deepseek.com"

# A panel opened and closed repeatedly must not become one request per flick.
PROBE_MIN_INTERVAL_SECONDS = 15

# A scan this recent is only reused to dedup concurrent collector runs (the
# update command backgrounds one per agent while the panel refreshes on its
# own). --limits-only promises only a fresh balance, so it may reuse a scan
# for up to 15 minutes.
SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900

# DeepSeek Harness bills DeepSeek through these two provider routes: an API
# key, and a DeepSeek account sign-in. Its other routes (pi-ai's providers)
# belong to whoever bills them.
DSH_PROVIDERS = ("deepseek-official", "deepseek-account")

# One canonical session log generation: session.jsonl, session.v4.jsonl, and
# their Zstandard twins.
DSH_LOG_NAME = re.compile(r"session(?:\.v([1-9][0-9]*))?\.jsonl(\.zstd)?")


class DeepSeekError(Exception):
  def __init__(self, message: str, transport: bool = False, refused: bool = False) -> None:
    super().__init__(message)
    self.transport = transport
    self.refused = refused


# Counts and times read from disk or the network are untrusted: a boolean,
# NaN, negative, or absurdly large value reads as nothing, never as a number
# that would swamp the totals. The ceiling sits well above any epoch
# millisecond time.
NUMBER_CEILING = 10 ** 15


def number(value: Any) -> int:
  if isinstance(value, bool):
    return 0
  try:
    n = float(value or 0)
  except (TypeError, ValueError, OverflowError):
    return 0
  if not math.isfinite(n) or n < 0 or n >= NUMBER_CEILING:
    return 0
  return round(n)


def obj(value: Any) -> dict[str, Any]:
  return value if isinstance(value, dict) else {}


# pi, omp, and the harnesses that copy their format spell usage camelCase or
# snake_case; the first spelling present wins.
def usage_tokens(usage: dict[str, Any], *keys: str) -> int:
  for key in keys:
    if key in usage:
      return number(usage.get(key))
  return 0


def model_name(raw: Any) -> str:
  value = str(raw or AGENT_ID)
  return value if value else AGENT_ID


# The local day a message was spent on, or None when its timestamp can't be
# trusted, so the caller skips that row rather than the whole scan. A message
# with no timestamp at all is today's.
def local_day(value: Any) -> str | None:
  if value is None:
    return datetime.now().strftime("%Y-%m-%d")
  if isinstance(value, str) and value.strip().isdigit():
    value = int(value.strip())
  if isinstance(value, bool):
    return None
  if isinstance(value, (int, float)):
    seconds = number(value)
    if seconds <= 0:
      return None
    # pi message timestamps are milliseconds; other clients use seconds.
    if seconds > 10_000_000_000:
      seconds = seconds / 1000
    try:
      return datetime.fromtimestamp(seconds).strftime("%Y-%m-%d")
    except (OverflowError, OSError, ValueError):
      return None
  try:
    dt = datetime.fromisoformat(str(value).strip().replace("Z", "+00:00"))
  except ValueError:
    return None
  if dt.tzinfo is not None:
    dt = dt.astimezone()
  return dt.strftime("%Y-%m-%d")


def runtime_env() -> dict[str, str]:
  home = str(Path.home())
  path_parts = [
    os.environ.get("PATH", ""),
    f"{home}/.local/bin",
    f"{home}/.npm-global/bin",
    f"{home}/.local/share/mise/shims",
  ]
  env = os.environ.copy()
  env["PATH"] = os.pathsep.join(part for part in path_parts if part)
  return env


ENV = runtime_env()


def find_command(name: str) -> str | None:
  return shutil.which(name, path=ENV.get("PATH"))


def empty_bucket() -> dict[str, int]:
  return {
    "inputTokens": 0,
    "outputTokens": 0,
    "cacheReadInputTokens": 0,
    "cacheCreationInputTokens": 0,
  }


class Stats:
  """Token and activity totals shared by every local source.

  Sessions and days are sets, so a day active in both pi and opencode counts
  once toward activeDays.
  """

  def __init__(self) -> None:
    now = datetime.now()
    self.today = now.strftime("%Y-%m-%d")
    self.recent_dates = [
      (now - timedelta(days=offset)).strftime("%Y-%m-%d")
      for offset in range(6, -1, -1)
    ]
    self.recent = {day: 0 for day in self.recent_dates}
    self.today_prompts = 0
    self.today_total_tokens = 0
    self.today_sessions: set[str] = set()
    self.today_tokens_by_model: dict[str, int] = {}
    self.total_prompts = 0
    self.total_sessions: set[str] = set()
    self.active_days: set[str] = set()
    self.model_usage: dict[str, dict[str, int]] = {}

  def add(self, session: str, day: str, model: str, input_tokens: int, output_tokens: int, cache_read: int, cache_write: int) -> None:
    bucket = self.model_usage.setdefault(model, empty_bucket())
    bucket["inputTokens"] += input_tokens
    bucket["outputTokens"] += output_tokens
    bucket["cacheReadInputTokens"] += cache_read
    bucket["cacheCreationInputTokens"] += cache_write

    total_tokens = input_tokens + output_tokens + cache_read + cache_write
    self.total_prompts += 1
    self.total_sessions.add(session)
    self.active_days.add(day)
    if day in self.recent:
      self.recent[day] += total_tokens
    if day == self.today:
      self.today_prompts += 1
      self.today_sessions.add(session)
      self.today_total_tokens += total_tokens
      self.today_tokens_by_model[model] = self.today_tokens_by_model.get(model, 0) + total_tokens

  def record(self) -> dict[str, Any]:
    return {
      "todayPrompts": self.today_prompts,
      "todaySessions": len(self.today_sessions),
      "todayTotalTokens": self.today_total_tokens,
      "todayTokensByModel": self.today_tokens_by_model,
      "recentDays": [{"date": day, "messageCount": self.recent[day]} for day in self.recent_dates],
      "totalPrompts": self.total_prompts,
      "totalSessions": len(self.total_sessions),
      "activeDays": len(self.active_days),
      "activeDates": sorted(self.active_days),
      "modelUsage": self.model_usage,
    }


# ------------------------------------------------------------- pi and omp

# pi's and omp's session trees, each profile's too: `--profile=<name>` moves
# the whole agent tree under <base>/profiles/<name>/. pi moves its agent tree
# with PI_CODING_AGENT_DIR and its sessions alone with
# PI_CODING_AGENT_SESSION_DIR, both expanding a leading ~; either is read as
# well as the default trees, which keep whatever was written before the move.
def pi_session_roots() -> list[Path]:
  roots: list[Path] = []
  for base in (Path.home() / ".pi", Path.home() / ".omp"):
    roots.append(base / "agent" / "sessions")
    try:
      # Sorted so the scan order does not depend on directory order.
      roots.extend(sorted(child / "agent" / "sessions" for child in (base / "profiles").iterdir() if child.is_dir()))
    except OSError:
      # No profiles directory, or it is unreadable: the default root stands.
      pass
  if os.environ.get("PI_CODING_AGENT_DIR", "").strip():
    roots.append(Path(os.environ["PI_CODING_AGENT_DIR"].strip()).expanduser() / "sessions")
  if os.environ.get("PI_CODING_AGENT_SESSION_DIR", "").strip():
    roots.append(Path(os.environ["PI_CODING_AGENT_SESSION_DIR"].strip()).expanduser())
  # Canonical roots, so an override that aliases a default root through a
  # symlink is scanned under one spelling. A root inside another is already
  # read with it, so it is dropped rather than counted twice.
  canonical = list(dict.fromkeys(root.resolve() for root in roots))
  return [root for root in canonical if not any(other != root and root.is_relative_to(other) for other in canonical)]


def scan_pi_sessions(stats: Stats) -> bool:
  """Add pi/omp session messages that ran on the deepseek provider.

  Returns whether every root was read in full, so a partial scan is never
  cached as the whole story.
  """
  roots = [root for root in pi_session_roots() if root.is_dir()]
  if not roots:
    return True
  rg = find_command("rg")
  if not rg:
    print("omarchy-agent-usage-deepseek: rg is missing; pi and omp sessions were not scanned", file=sys.stderr)
    return False

  seen_messages: set[tuple[str, str]] = set()
  complete = True
  for root in roots:
    try:
      proc = subprocess.Popen(
        # --no-ignore: a home that is itself a git checkout would otherwise
        # hide every session file behind its ignore rules.
        [rg, "--json", "--no-ignore", "-e", r'"provider"\s*:\s*"deepseek"', str(root)],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        errors="replace",
        env=ENV,
      )
    except OSError:
      return False

    assert proc.stdout is not None
    for raw in proc.stdout:
      try:
        event = json.loads(raw)
        if event.get("type") != "match":
          continue
        line = event.get("data", {}).get("lines", {}).get("text", "")
        path = event.get("data", {}).get("path", {}).get("text", "pi-session")
        entry = json.loads(line)
        add_pi_entry(stats, entry, path, seen_messages)
      except Exception:
        # One odd line costs that line, never the scan.
        continue

    try:
      # rg exits 1 for no match and 2 when it couldn't read something.
      if proc.wait(timeout=1) not in (0, 1):
        complete = False
    except Exception:
      proc.kill()
      complete = False
  return complete


def add_pi_entry(stats: Stats, entry: Any, path: str, seen_messages: set[tuple[str, str]]) -> None:
  if not isinstance(entry, dict) or entry.get("type") != "message":
    return
  message = obj(entry.get("message"))
  if message.get("role") != "assistant":
    return
  if str(message.get("provider") or "") != "deepseek":
    return
  # A fork copies its parent's entries with their id and timestamp, so the
  # pair names a message across files; an id alone only within its file.
  # Without an id, each line is its own.
  message_id = entry.get("id")
  if message_id:
    timestamp = entry.get("timestamp")
    key = (str(message_id), str(timestamp)) if timestamp else (path, str(message_id))
    if key in seen_messages:
      return
    seen_messages.add(key)

  usage = obj(message.get("usage"))
  if not usage:
    return
  input_tokens = usage_tokens(usage, "input", "inputTokens", "input_tokens")
  output_tokens = usage_tokens(usage, "output", "outputTokens", "output_tokens")
  cache_read = usage_tokens(usage, "cacheRead", "cacheReadTokens", "cache_read", "cache_read_input_tokens")
  cache_write = usage_tokens(usage, "cacheWrite", "cacheWriteTokens", "cache_write", "cache_creation_input_tokens")
  if not (input_tokens or output_tokens or cache_read or cache_write):
    # Some writers keep only the total; it was still spent.
    input_tokens = usage_tokens(usage, "totalTokens", "total_tokens")
    if not input_tokens:
      return

  # The first time present decides: none at all is today's, and an
  # untrusted one, zero included, skips only this line.
  stamp = entry.get("timestamp")
  day = local_day(message.get("timestamp") if stamp is None else stamp)
  if day is None:
    return
  stats.add(path, day, model_name(message.get("model")), input_tokens, output_tokens, cache_read, cache_write)


# --------------------------------------------------------------- opencode

def opencode_db_path() -> Path:
  # OPENCODE_DB points opencode at another database, as the CLI itself reads
  # it; a relative name lives beside the default one. Only a build whose
  # channel was literally "v2" wrote opencode-v2.db, so it is a fallback for
  # those installs alone.
  data_home = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share"))
  root = data_home / "opencode"
  configured = os.environ.get("OPENCODE_DB", "").strip()
  if configured:
    path = Path(configured).expanduser()
    return path if path.is_absolute() else root / path
  normal = root / "opencode.db"
  legacy = root / "opencode-v2.db"
  return legacy if not normal.is_file() and legacy.is_file() else normal


def opencode_columns(conn: sqlite3.Connection, table: str) -> set[str]:
  try:
    return {row[1] for row in conn.execute(f"PRAGMA table_info({table})")}
  except sqlite3.Error:
    return set()


def opencode_row(stats: Stats, message_id: str, session_id: Any, entry: Any, row_type: str, created: Any, seen: set[str]) -> None:
  # Shared by both message stores. The original `message` table keeps the
  # provider and model at the top level; the V2 `session_message` table nests
  # them under `model` and keeps the role in its `type` column, with a
  # compaction's tokens spent like any reply's.
  if not isinstance(entry, dict):
    return
  if (entry.get("role") or row_type) not in ("assistant", "compaction"):
    return
  model = entry.get("model")
  provider = entry.get("providerID") or (model.get("providerID") if isinstance(model, dict) else "")
  if str(provider or "") != "deepseek":
    return
  tokens = obj(entry.get("tokens"))
  cache = obj(tokens.get("cache"))
  input_tokens = number(tokens.get("input"))
  # opencode keeps thinking tokens out of output; both are generated.
  output_tokens = number(tokens.get("output")) + number(tokens.get("reasoning"))
  cache_read = number(cache.get("read"))
  cache_write = number(cache.get("write"))
  if not (input_tokens or output_tokens or cache_read or cache_write):
    return
  # A migrated message can sit in both stores under the same id.
  if message_id in seen:
    return
  seen.add(message_id)
  # The message's own time, else the row's: none at all is today's, and
  # an untrusted one, zero included, skips only this row.
  stamp = obj(entry.get("time")).get("created")
  day = local_day(created if stamp is None else stamp)
  if day is None:
    return
  raw_model = entry.get("modelID") or ((model.get("modelID") or model.get("id")) if isinstance(model, dict) else model)
  name = model_name(str(raw_model or "").rstrip("/").split("/")[-1])
  stats.add("opencode:" + str(session_id), day, name, input_tokens, output_tokens, cache_read, cache_write)


def scan_opencode_session_messages(stats: Stats, conn: sqlite3.Connection, tables: set[str], seen: set[str]) -> None:
  # The V2 store. The LIKE gate skips rows whose JSON cannot name the
  # provider before any parse.
  columns = opencode_columns(conn, "session_message")
  if not {"id", "session_id", "type", "data"} <= columns:
    return
  created = "m.time_created" if "time_created" in columns else "NULL"
  source = "session_message m"
  fork_filter = ""
  if "time_created" in columns and "session_v2" in tables and {"id", "fork_session_id", "time_created"} <= opencode_columns(conn, "session_v2"):
    # A fork copies its source session's messages under new ids; only what
    # came after the fork was spent in it.
    source += " LEFT JOIN session_v2 s ON s.id = m.session_id"
    fork_filter = " AND (s.fork_session_id IS NULL OR m.time_created >= s.time_created)"
  for message_id, session_id, row_type, time_created, raw in conn.execute(
    f"SELECT m.id, m.session_id, m.type, {created}, m.data FROM {source}"
    " WHERE m.type IN ('assistant', 'compaction')"
    " AND m.data LIKE '%\"providerID\"%:%\"deepseek\"%'" + fork_filter
  ):
    # One row that still fails must not take the scan down with it.
    try:
      opencode_row(stats, str(message_id), session_id, json.loads(raw), str(row_type or ""), time_created, seen)
    except Exception:
      continue


def scan_opencode_messages(stats: Stats, conn: sqlite3.Connection, seen: set[str]) -> None:
  # The original store, one row per chat message. The json_extract
  # conditions are the authority; the LIKE gates are pure acceleration that
  # skip rows whose JSON cannot contain the pair.
  columns = opencode_columns(conn, "message")
  if not {"session_id", "data"} <= columns:
    return
  message_id = "id" if "id" in columns else "rowid"
  for row_id, session_id, raw in conn.execute(
    f"SELECT {message_id}, session_id, data FROM message"
    " WHERE data LIKE '%\"role\"%:%\"assistant\"%'"
    " AND data LIKE '%\"providerID\"%:%\"deepseek\"%'"
    " AND CASE WHEN json_valid(data) THEN json_extract(data, '$.role') END = 'assistant'"
    " AND CASE WHEN json_valid(data) THEN json_extract(data, '$.providerID') END = 'deepseek'"
  ):
    try:
      opencode_row(stats, str(row_id), session_id, json.loads(raw), "", None, seen)
    except Exception:
      continue


def scan_opencode_sessions(stats: Stats) -> bool:
  """Add opencode messages on a deepseek provider, from both of its stores.

  Read-only: opencode may be writing right now. A scan cut short by a
  database error keeps what it already read, but says it is incomplete.
  """
  db = opencode_db_path()
  if not db.is_file():
    return True

  try:
    conn = sqlite3.connect(db.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
  except sqlite3.Error:
    return False
  try:
    conn.execute("PRAGMA query_only = ON")
    tables = {name for (name,) in conn.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
    # Both stores, V2 first, deduplicated by message id: a build that
    # migrated keeps reading, and a message in both counts once.
    seen: set[str] = set()
    if "session_message" in tables:
      scan_opencode_session_messages(stats, conn, tables, seen)
    if "message" in tables:
      scan_opencode_messages(stats, conn, seen)
  except sqlite3.Error:
    return False
  finally:
    conn.close()
  return True


# -------------------------------------------------------- DeepSeek Harness
#
# dsh keeps one append-only event log per session under
# $DSH_HOME/sessions/<project>/<session>/, Zstandard-compressed by default.
# Each billed model attempt settles as an assistant/message (or a log-only
# assistant/attempt) carrying the provider's usage; the request/header before
# it names the provider route and model.


def dsh_home() -> Path:
  # An empty or blank DSH_HOME reads as unset, as dsh itself treats it.
  configured = os.environ.get("DSH_HOME", "").strip()
  return Path(configured).expanduser() if configured else Path.home() / ".dsh"


def dsh_session_logs(root: Path) -> list[Path]:
  # The newest generation in each session directory is the current log;
  # older ones are kept only as migration history.
  newest: dict[Path, tuple[int, Path]] = {}
  for path in root.rglob("session*.jsonl*"):
    match = DSH_LOG_NAME.fullmatch(path.name)
    if not match or not path.is_file():
      continue
    version = int(match.group(1) or 0)
    current = newest.get(path.parent)
    if current is None or version > current[0]:
      newest[path.parent] = (version, path)
  return [path for _, path in sorted(newest.values(), key=lambda item: str(item[1]))]


def dsh_log_lines(path: Path) -> tuple[list[bytes], bool]:
  """The complete records of one log, and whether all of it could be read.

  A torn final line or frame from a crash mid-write is dropped, as dsh's own
  reader does, without making the scan incomplete.
  """
  data = path.read_bytes()
  if path.name.endswith(".zstd"):
    if zstd is None:
      print("omarchy-agent-usage-deepseek: this Python has no Zstandard support; DeepSeek Harness sessions were not scanned", file=sys.stderr)
      return [], False
    chunks = []
    while data:
      decompressor = zstd.ZstdDecompressor()
      try:
        chunks.append(decompressor.decompress(data))
      except zstd.ZstdError:
        break
      if not decompressor.eof:
        break
      data = decompressor.unused_data
    data = b"".join(chunks)
  lines = data.split(b"\n")
  # Whatever follows the last newline is an unfinished record.
  return lines[:-1], True


def dsh_usage_sample(event: dict[str, Any]) -> dict[str, Any] | None:
  data = obj(event.get("data"))
  if event.get("type") == "assistant/message" and isinstance(data.get("usage"), dict):
    return data["usage"]
  stream = data.get("stream")
  if not isinstance(stream, list):
    return None
  for record in reversed(stream):
    chunk = obj(obj(record).get("chunk"))
    if obj(record).get("type") == "chunk" and chunk.get("type") == "usage":
      return obj(chunk.get("usage"))
  return None


def scan_dsh_log(stats: Stats, path: Path) -> bool:
  lines, complete = dsh_log_lines(path)
  if not lines:
    return complete
  try:
    header = obj(json.loads(lines[0]))
  except ValueError:
    return complete
  if header.get("type") != "session":
    return complete
  events = []
  for line in lines[1:]:
    try:
      event = json.loads(line)
    except ValueError:
      continue
    if isinstance(event, dict):
      events.append(event)

  # A fork's log opens with a copy of its parent's history; the last
  # `session/end-seed` marked inherited is where its own spending begins.
  start = 0
  if header.get("isSeeded") is True:
    for index, event in enumerate(events):
      if event.get("type") == "session/end-seed" and obj(event.get("data")).get("inherited") is True:
        start = index + 1

  session = "dsh:" + str(header.get("id") or path.parent.name)
  provider, model = "", ""
  # One slot per billed attempt. A settlement replaces the streaming sample
  # of the same turn and step, until a retry starts a new attempt, the same
  # fold dsh's own token meter runs.
  slots: list[list[Any]] = []
  last: tuple[Any, Any] | None = None
  for index, event in enumerate(events):
    kind = event.get("type")
    data = obj(event.get("data"))
    if kind == "request/header":
      config = obj(obj(data.get("header")).get("config"))
      provider, model = str(config.get("provider") or ""), str(config.get("model") or "")
      continue
    if kind == "llm/retry-started":
      if last == (data.get("turn"), data.get("step")):
        last = None
      continue
    if kind not in ("assistant/message", "assistant/attempt"):
      continue
    usage = dsh_usage_sample(event)
    if usage is None:
      continue
    slot = (data.get("turn"), data.get("step"))
    sample = [
      number(usage.get("inputTokens")),
      number(usage.get("outputTokens")),
      number(usage.get("cacheReadTokens")),
      number(usage.get("cacheWriteTokens")),
    ]
    entry = [index >= start and provider in DSH_PROVIDERS, local_day(event.get("time")), model, sample]
    if last == slot and slots:
      slots[-1] = entry
    else:
      slots.append(entry)
    last = slot

  for counted, day, slot_model, (input_tokens, output_tokens, cache_read, cache_write) in slots:
    if counted and day is not None and (input_tokens or output_tokens or cache_read or cache_write):
      stats.add(session, day, model_name(slot_model), input_tokens, output_tokens, cache_read, cache_write)
  return complete


def scan_dsh_sessions(stats: Stats) -> bool:
  root = dsh_home() / "sessions"
  if not root.is_dir():
    return True
  complete = True
  try:
    logs = dsh_session_logs(root)
  except OSError:
    return False
  for path in logs:
    try:
      complete = scan_dsh_log(stats, path) and complete
    except OSError:
      complete = False
  return complete


# ------------------------------------------------------------- scan cache

def cache_root() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def read_json(path: Path) -> dict[str, Any]:
  try:
    value = json.loads(path.read_text(encoding="utf-8"))
  except Exception:
    return {}
  return value if isinstance(value, dict) else {}


def read_fresh_json(path: Path, max_age_seconds: float) -> dict[str, Any] | None:
  if max_age_seconds <= 0 or not path.exists():
    return None
  try:
    # A negative age means the mtime is in the future: the clock moved
    # backwards since the write, so the scan's freshness cannot be trusted.
    age = time.time() - path.stat().st_mtime
    if 0 <= age < max_age_seconds:
      return read_json(path)
  except OSError:
    return None
  return None


def write_json(path: Path, payload: dict[str, Any]) -> None:
  # A temp name unique to this writer: several collectors can run at once,
  # and a shared temp path means the second replace finds the first one's
  # file already moved away.
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, separators=(",", ":")) + "\n")
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


def scan_cache_paths() -> tuple[Path, Path]:
  # The digest covers every data path the scan reads.
  sources = [str(opencode_db_path()), str(dsh_home())] + [str(root) for root in pi_session_roots()]
  digest = hashlib.sha1("\n".join(sources).encode("utf-8")).hexdigest()[:16]
  root = cache_root()
  return root / f"deepseek-scan-{digest}.json", root / f"deepseek-scan-{digest}.lock"


def run_local_scans() -> tuple[dict[str, Any], bool]:
  stats = Stats()
  complete = scan_pi_sessions(stats)
  complete = scan_opencode_sessions(stats) and complete
  complete = scan_dsh_sessions(stats) and complete
  return stats.record(), complete


# today* fields only mean "today" on the day they were scanned, so a scan
# from another local date is a miss whatever its file time says.
def read_cached_stats(cache_file: Path, max_age: float) -> dict[str, Any] | None:
  cached = read_fresh_json(cache_file, max_age)
  if not cached or cached.get("schemaVersion") != 1 or cached.get("scanDate") != datetime.now().strftime("%Y-%m-%d"):
    return None
  stats = cached.get("stats")
  if not isinstance(stats, dict) or not all(key in stats for key in ("todayPrompts", "todayTotalTokens", "recentDays", "activeDates", "modelUsage")):
    return None
  return stats


def cached_local_stats(max_age: float) -> dict[str, Any]:
  # The cache is an optimization: any failure of its own degrades to a
  # direct scan.
  try:
    cache_file, lock_file = scan_cache_paths()
    cached = read_cached_stats(cache_file, max_age)
    if cached is not None:
      return cached
    with lock_file.open("w") as lock:
      fcntl.flock(lock, fcntl.LOCK_EX)
      cached = read_cached_stats(cache_file, max_age)
      if cached is not None:
        return cached
      stats, complete = run_local_scans()
      # An interrupted scan still serves this run, but caching it would hide
      # the missing usage from every reader until the cache expires.
      if complete:
        write_json(cache_file, {"schemaVersion": 1, "scanDate": datetime.now().strftime("%Y-%m-%d"), "stats": stats})
      return stats
  except Exception as exc:
    print(f"omarchy-agent-usage-deepseek: cache unavailable ({exc}); scanning directly", file=sys.stderr)
    stats, _ = run_local_scans()
    return stats


# -------------------------------------------------------------- credentials

def read_key_from_dict(parsed: Any, provider: str) -> str:
  if not isinstance(parsed, dict):
    return ""
  entry = parsed.get(provider)
  if isinstance(entry, str):
    return entry.strip()
  if not isinstance(entry, dict):
    return ""
  return str(entry.get("key") or entry.get("apiKey") or entry.get("api_key") or "").strip()


def read_json_key(path: Path, provider: str) -> str:
  try:
    return read_key_from_dict(json.loads(path.read_text()), provider)
  except (OSError, ValueError):
    return ""


def unquote(value: str) -> str:
  value = value.strip()
  if value[:1] in ("'", '"'):
    end = value.find(value[0], 1)
    return value[1:end] if end > 0 else ""
  # An unquoted scalar ends where a comment begins.
  return value.split(" #", 1)[0].strip()


def read_dsh_credentials_key(path: Path) -> str:
  """DEEPSEEK_API_KEY from dsh's managed `.credentials.yaml`.

  Only the one plain scalar is needed, so this reads the line rather than
  pulling in a YAML parser: `refs:` holds it in the current layout, and the
  pre-release layout kept it at the top level.
  """
  try:
    text = path.read_text(encoding="utf-8")
  except (OSError, UnicodeDecodeError):
    return ""
  section = ""
  for line in text.splitlines():
    if not line.strip() or line.lstrip().startswith("#"):
      continue
    if not line[0].isspace():
      section = line.split(":", 1)[0].strip()
      if section == "DEEPSEEK_API_KEY":
        return unquote(line.split(":", 1)[1])
      continue
    if section == "refs":
      name, _, value = line.strip().partition(":")
      if name.strip() == "DEEPSEEK_API_KEY":
        return unquote(value)
  return ""


def read_dotenv_key(path: Path) -> str:
  try:
    text = path.read_text(encoding="utf-8")
  except (OSError, UnicodeDecodeError):
    return ""
  for line in text.splitlines():
    line = line.strip()
    if line.startswith("export "):
      line = line[len("export "):].strip()
    name, sep, value = line.partition("=")
    if sep and name.strip() == "DEEPSEEK_API_KEY":
      return unquote(value)
  return ""


def api_key() -> str:
  # The environment first, then the agents that keep a DeepSeek key, read
  # only: pi, opencode, and dsh's managed store with its `.env` fallback.
  env_key = str(os.environ.get("DEEPSEEK_API_KEY", "")).strip()
  if env_key:
    return env_key
  data_home = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share"))
  for read in (
    lambda: read_json_key(Path.home() / ".pi" / "agent" / "auth.json", "deepseek"),
    lambda: read_json_key(data_home / "opencode" / "auth.json", "deepseek"),
    lambda: read_dsh_credentials_key(dsh_home() / ".credentials.yaml"),
    lambda: read_dotenv_key(dsh_home() / ".env"),
  ):
    key = read()
    if key:
      return key
  return ""


def config_path() -> Path:
  config_home = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
  return config_home / "omarchy" / "agents" / "deepseek.json"


def read_config() -> dict[str, Any]:
  try:
    parsed = json.loads(config_path().read_text())
    return parsed if isinstance(parsed, dict) else {}
  except (OSError, ValueError):
    return {}


# ----------------------------------------------------------------- balance

def money(value: Any) -> Decimal:
  if isinstance(value, bool):
    return Decimal("0")
  try:
    amount = Decimal(str(value or "0"))
  except InvalidOperation:
    return Decimal("0")
  return amount if amount.is_finite() else Decimal("0")


def fetch_balance(api_base_url: str, key: str) -> dict[str, Any]:
  """GET /user/balance: total_balance, granted_balance, topped_up_balance."""
  url = api_base_url.rstrip("/") + "/user/balance"
  request = urllib.request.Request(
    url,
    headers={"Authorization": "Bearer " + key, "Accept": "application/json"},
  )
  try:
    with urllib.request.urlopen(request, timeout=15) as response:
      body = response.read()
  except urllib.error.HTTPError as error:
    if error.code in (401, 403):
      raise DeepSeekError("DeepSeek rejected the saved API key. Set a current one in DEEPSEEK_API_KEY or the agent that holds it.", refused=True)
    raise DeepSeekError(f"DeepSeek's balance endpoint returned HTTP {error.code}.")
  except Exception as error:
    # No answer at all: no route, no DNS, a timeout. Worth a retry soon.
    raise DeepSeekError("Couldn't reach the DeepSeek API. Retrying shortly.", transport=True) from error

  try:
    payload = json.loads(body.decode("utf-8", errors="replace"))
  except ValueError as error:
    raise DeepSeekError("DeepSeek returned an invalid balance response.") from error
  if not isinstance(payload, dict):
    raise DeepSeekError("DeepSeek returned an invalid balance response.")
  infos = payload.get("balance_infos")
  if not isinstance(infos, list) or not infos or not isinstance(infos[0], dict):
    raise DeepSeekError("DeepSeek's balance response carried no balance_infos.")
  first = infos[0]

  return {
    "remaining": money(first.get("total_balance")),
    "granted": money(first.get("granted_balance")),
    "toppedUp": money(first.get("topped_up_balance")),
    "currency": str(first.get("currency") or "CNY"),
  }


def balance_record(remaining: Decimal, currency: str) -> dict[str, Any]:
  config = read_config()
  funded = money(config.get("fundedAmount"))
  if funded < 0:
    funded = Decimal("0")
  spent = max(Decimal("0"), funded - remaining) if funded > 0 else Decimal("0")
  return {
    "remaining": float(max(Decimal("0"), remaining)),
    "funded": float(funded),
    "spent": float(spent),
    "currency": str(currency or "CNY"),
    # funded/spent derive from the configured fundedAmount, not DeepSeek's
    # own ledger, so they are labelled estimates; remaining is live.
    "estimated": funded > 0,
  }


# One cache per key and endpoint, so a machine signed in to another account
# never shows the last one's balance.
def balance_cache_path(key: str, api_base_url: str) -> Path:
  digest = hashlib.sha256((api_base_url.rstrip("/") + "\n" + key).encode("utf-8")).hexdigest()[:16]
  return cache_root() / f"deepseek-limits-{digest}.json"


def collect_balance(key: str, api_base_url: str, force: bool) -> dict[str, Any]:
  result: dict[str, Any] = {"balance": None, "stale": False, "fetchedAtMs": 0, "usageStatusText": "", "authHelpText": "", "retryAdvised": False}
  cache = None
  cached: dict[str, Any] = {}
  try:
    cache = balance_cache_path(key, api_base_url)
    cached = read_json(cache)
  except OSError as exc:
    print(f"omarchy-agent-usage-deepseek: could not read the balance cache ({exc})", file=sys.stderr)
  kept = obj(cached.get("balance"))
  fetched_at = number(cached.get("fetchedAtMs"))

  # A panel opened and closed repeatedly must not become one request per
  # flick, so a recent answer is reused; --force skips the wait.
  if kept and not force and 0 <= time.time() - fetched_at / 1000 < PROBE_MIN_INTERVAL_SECONDS:
    result.update(balance=balance_record(money(kept.get("remaining")), str(kept.get("currency") or "")), fetchedAtMs=fetched_at)
    return result

  try:
    live = fetch_balance(api_base_url, key)
  except DeepSeekError as error:
    result["retryAdvised"] = error.transport
    result["authHelpText"] = str(error)
    if kept:
      # The last good balance, marked stale with when it was read, beats an
      # empty section while DeepSeek can't be asked.
      result.update(balance=balance_record(money(kept.get("remaining")), str(kept.get("currency") or "")), stale=True, fetchedAtMs=fetched_at)
    if error.refused:
      result["usageStatusText"] = "Sign-in expired"
    elif not kept:
      result["usageStatusText"] = "Balance unavailable"
    return result

  # Rounded down: rounded up, a run in the same millisecond would find the
  # answer in the future and ask again.
  fetched_at = int(time.time() * 1000)
  if cache is not None:
    try:
      write_json(cache, {"fetchedAtMs": fetched_at, "limits": [], "balance": {"remaining": str(live["remaining"]), "currency": live["currency"]}})
    except OSError as exc:
      print(f"omarchy-agent-usage-deepseek: could not write the balance cache ({exc})", file=sys.stderr)
  result.update(balance=balance_record(live["remaining"], live["currency"]), fetchedAtMs=fetched_at)
  return result


# ------------------------------------------------------------------ record

def base_record(stats: dict[str, Any] | None = None) -> dict[str, Any]:
  record: dict[str, Any] = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "ready": False,
    "hasLocalStats": True,
    # Prompt and session counts are real: every pi session message carries
    # them, so today's tooltip may show "N prompts · M sessions".
    "hasPromptStats": True,
    "tierLabel": "",
    "usageStatusText": "",
    "authHelpText": "",
    "limits": [],
    "limitsStale": False,
    "limitsFetchedAt": 0,
  }
  record.update(stats if stats is not None else Stats().record())
  return record


def collect(api_base_url: str, max_age: float, force: bool) -> dict[str, Any]:
  record = base_record(cached_local_stats(max_age))
  record["ready"] = number(record.get("totalPrompts")) > 0

  # Without a key the record carries local stats only, with no plan, so the
  # panel leaves out the balance section, and skips the record altogether on
  # a machine that has never used DeepSeek.
  key = api_key()
  if not key:
    return record
  record.update(ready=True, tierLabel="Prepaid")
  balance = collect_balance(key, api_base_url, force)
  if balance["balance"] is not None:
    record["balance"] = balance["balance"]
  record.update(
    usageStatusText=balance["usageStatusText"],
    authHelpText=balance["authHelpText"],
    limitsStale=balance["stale"],
    limitsFetchedAt=balance["fetchedAtMs"],
  )
  if balance["retryAdvised"]:
    record["retryAdvised"] = True
  return record


def main() -> int:
  parser = argparse.ArgumentParser(description="Print the DeepSeek usage record as JSON")
  # --force rescans everything and asks DeepSeek past the reuse window.
  # --limits-only (the panel's quick refresh) may reuse a scan for 15
  # minutes, but asks for the balance like a normal run.
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  parser.add_argument("--api-base-url", default=os.environ.get("DEEPSEEK_API_BASE_URL", API_BASE_URL))
  args = parser.parse_args()

  max_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else SCAN_REUSE_SECONDS)
  try:
    record = collect(args.api_base_url, max_age, args.force)
  except Exception as error:
    # A bug, not a state the panel should explain: an empty record keeps
    # the panel steady, and stderr says what broke.
    record = base_record()
    print(f"omarchy-agent-usage-deepseek: {type(error).__name__}: {error}", file=sys.stderr)
  print(json.dumps(record, separators=(",", ":")))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
