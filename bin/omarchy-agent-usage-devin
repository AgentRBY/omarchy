#!/usr/bin/python3
# omarchy:summary=Print the Devin usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Devin usage into one display-ready JSON record.

Token stats come from the Devin CLI session database at
$XDG_DATA_HOME/devin/cli/sessions.db, where each assistant message carries
metadata.metrics with its input/output/cache token counts and the model that
generated it, and from pi/omp sessions and opencode's message database (both
of its stores) that ran on the devin provider.

The daily and weekly quota comes from the user-status cache the Devin CLI
writes at $XDG_CACHE_HOME/devin/cli/user_status.*.bin every time it starts:
the GetUserStatus answer it fetched, base64 protobuf. The collector reads that
cache, the same data the CLI's /usage command renders, and makes no network
call of its own. The agents panel only ever reads the JSON this prints.
"""

import argparse
import base64
import fcntl
import hashlib
import json
import math
import os
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

AGENT_ID = "devin"
AGENT_NAME = "Devin"
PROVIDER = "devin"
AUTH_HELP = "Run `devin auth login` so Devin can record its quota."
REFRESH_HELP = "Devin hasn't recorded its quota since it was signed in. Start Devin to refresh it."

# A scan this recent is only reused to dedup concurrent collector runs (the
# update command backgrounds one per agent while the panel refreshes on its
# own). --limits-only promises only fresh limits, so it may reuse a scan for
# up to 15 minutes. The quota is a file read, so it is read on every run.
SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900

# The quota comes from a cache the CLI writes when it starts, never from a
# check of ours, and cloud sessions keep spending it meanwhile. Numbers this
# recent still describe the account; older ones are reported stale, with
# their age.
LIMITS_CURRENT_ENOUGH_SECONDS = 900

# The plan tiers GetUserStatus numbers, named as Devin names them. Only asked
# when the plan carries no name of its own.
TEAMS_TIER = {
  1: "Teams", 2: "Pro", 3: "Enterprise Saas", 4: "Hybrid", 5: "Enterprise Self Hosted",
  6: "Waitlist Pro", 7: "Teams Ultimate", 9: "Trial", 10: "Enterprise Self Serve",
  12: "Devin Enterprise", 14: "Devin Teams", 15: "Devin Teams V2", 16: "Devin Pro",
  17: "Devin Max", 18: "Max", 19: "Devin Free", 20: "Devin Trial",
}

# Past this a token count or timestamp from disk is garbage, not usage.
MAX_TOKENS = 10_000_000_000
EARLIEST_EPOCH = 946_684_800  # 2000-01-01
LATEST_EPOCH = 4_102_444_800  # 2100-01-01


# --------------------------------------------------------------- utilities


def obj(value):
  return value if isinstance(value, dict) else {}


# Token counts and timestamps on disk are untrusted: a boolean, NaN, infinite,
# negative, huge or non-numeric value reads as nothing.
def number(value):
  if isinstance(value, bool) or not isinstance(value, (int, float)):
    return 0
  if not math.isfinite(value) or value < 0 or value > MAX_TOKENS:
    return 0
  return int(value)


def epoch_seconds(value):
  if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
    return None
  # Session timestamps are seconds or milliseconds.
  seconds = value / 1000 if value > 100_000_000_000 else value
  if not EARLIEST_EPOCH <= seconds < LATEST_EPOCH:
    return None
  return seconds


def parse_time(value):
  """A timestamp from disk as an aware datetime, or None when it won't read."""
  seconds = epoch_seconds(value)
  if seconds is not None:
    return datetime.fromtimestamp(seconds, timezone.utc)
  if not isinstance(value, str) or not value.strip():
    return None
  try:
    parsed = datetime.fromisoformat(value.strip().replace("Z", "+00:00"))
  except ValueError:
    return None
  if parsed.tzinfo is None:
    parsed = parsed.astimezone()
  if epoch_seconds(parsed.timestamp()) is None:
    return None
  return parsed


# A pi or opencode row's day, read as every collector reading those sources
# reads it: a row with no time at all is today's, and an untrusted time is
# None, so the caller skips that row alone.
def source_day(value):
  return datetime.now().strftime("%Y-%m-%d") if value is None else local_day(value)


# pi, omp, and the harnesses that copy their format spell usage camelCase or
# snake_case; the first spelling present wins.
def usage_tokens(usage, *keys):
  for key in keys:
    if key in usage:
      return number(usage.get(key))
  return 0


def local_day(value):
  parsed = parse_time(value)
  return parsed.astimezone().strftime("%Y-%m-%d") if parsed else None


def iso_from_unix(value):
  seconds = epoch_seconds(value)
  return datetime.fromtimestamp(seconds, timezone.utc).isoformat() if seconds else ""


def model_name(raw):
  return str(raw or "").strip() or AGENT_ID


def runtime_env():
  home = str(Path.home())
  path_parts = [
    os.environ.get("PATH", ""),
    f"{home}/.local/bin",
    f"{home}/.npm-global/bin",
    f"{home}/.local/share/mise/shims",
  ]
  env = os.environ.copy()
  env["PATH"] = os.pathsep.join(part for part in path_parts if part)
  return env


ENV = runtime_env()


def find_command(name):
  return shutil.which(name, path=ENV.get("PATH"))


def data_home():
  return Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share"))


def xdg_cache_home():
  return Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache"))


def cache_root():
  root = xdg_cache_home() / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def read_json(path):
  try:
    return json.loads(path.read_text(encoding="utf-8"))
  except Exception:
    return None


def read_fresh_json(path, max_age_seconds):
  if max_age_seconds <= 0:
    return None
  try:
    # A negative age means the mtime is in the future: the clock moved
    # backwards since the write, so the cache's freshness cannot be trusted.
    age = time.time() - path.stat().st_mtime
  except OSError:
    return None
  return read_json(path) if 0 <= age < max_age_seconds else None


def write_json(path, payload):
  # A temp name unique to this writer: several collectors can run at once, and
  # a shared temp path means the second replace finds the first one's file
  # already moved away.
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, separators=(",", ":")) + "\n")
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


# ------------------------------------------------------------------- stats


def empty_bucket():
  return {"inputTokens": 0, "outputTokens": 0, "cacheReadInputTokens": 0, "cacheCreationInputTokens": 0}


class Stats:
  """Token and activity totals shared by every local source. Sessions and days
  are sets, so a day active in two sources counts once toward activeDays."""

  def __init__(self):
    now = datetime.now()
    self.today = now.strftime("%Y-%m-%d")
    self.recent_dates = [(now - timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]
    self.recent = {day: 0 for day in self.recent_dates}
    self.today_prompts = 0
    self.today_total_tokens = 0
    self.today_sessions = set()
    self.today_tokens_by_model = {}
    self.total_prompts = 0
    self.total_sessions = set()
    self.active_days = set()
    self.model_usage = {}

  # A session of None is settled later, with add_session.
  def add_session(self, session, today):
    if session is not None:
      self.total_sessions.add(session)
      if today:
        self.today_sessions.add(session)

  def add_prompt(self, session, day):
    self.total_prompts += 1
    if day == self.today:
      self.today_prompts += 1
    self.add_session(session, day == self.today)

  def add(self, session, day, model, input_tokens, output_tokens, cache_read, cache_write, prompt=True):
    total = input_tokens + output_tokens + cache_read + cache_write
    if total <= 0:
      return
    if prompt:
      self.add_prompt(session, day)
    self.add_session(session, day == self.today)
    self.active_days.add(day)
    bucket = self.model_usage.setdefault(model, empty_bucket())
    bucket["inputTokens"] += input_tokens
    bucket["outputTokens"] += output_tokens
    bucket["cacheReadInputTokens"] += cache_read
    bucket["cacheCreationInputTokens"] += cache_write
    if day in self.recent:
      # recentDays.messageCount holds tokens, despite the legacy name.
      self.recent[day] += total
    if day == self.today:
      self.today_total_tokens += total
      self.today_tokens_by_model[model] = self.today_tokens_by_model.get(model, 0) + total

  def record(self):
    return {
      "todayPrompts": self.today_prompts,
      "todaySessions": len(self.today_sessions),
      "todayTotalTokens": self.today_total_tokens,
      "todayTokensByModel": self.today_tokens_by_model,
      "recentDays": [{"date": day, "messageCount": self.recent[day]} for day in self.recent_dates],
      "totalPrompts": self.total_prompts,
      "totalSessions": len(self.total_sessions),
      "activeDays": len(self.active_days),
      "activeDates": sorted(self.active_days),
      "modelUsage": self.model_usage,
    }


# ------------------------------------------------------------- Devin CLI


def data_dir():
  return Path(os.environ.get("DEVIN_DATA_DIR") or (data_home() / "devin" / "cli"))


def credentials_path():
  return data_dir().parent / "credentials.toml"


def session_databases():
  """The CLI's own database, or failing that the older layout some builds
  wrote straight under $XDG_DATA_HOME/devin. Never both: a machine that moved
  to the newer layout may still have the old files, holding the same work."""
  primary = data_dir() / "sessions.db"
  if primary.is_file():
    return [primary]
  root = data_home() / "devin"
  return [path for path in (root / "cli_sessions.db", root / "sessions.db") if path.is_file()]


def table_columns(conn, table):
  return {row[1] for row in conn.execute(f"PRAGMA table_info({table})")}


def scan_message_nodes(conn, stats, prefix):
  # Every assistant message records what it spent under metadata.metrics.
  # The LIKE gate skips rows that cannot hold metrics before any parse.
  for session_id, created_at, raw in conn.execute(
    "SELECT session_id, created_at, chat_message FROM message_nodes WHERE chat_message LIKE '%\"metrics\"%'"
  ):
    try:
      metadata = obj(obj(json.loads(raw)).get("metadata"))
    except (TypeError, ValueError):
      continue
    metrics = obj(metadata.get("metrics"))
    day = local_day(created_at)
    if not metrics or day is None:
      continue
    # Prompts are counted from prompt_history, where each one is a row.
    stats.add(
      prefix + str(session_id), day, model_name(metadata.get("generation_model")),
      number(metrics.get("input_tokens")), number(metrics.get("output_tokens")),
      number(metrics.get("cache_read_tokens")), number(metrics.get("cache_creation_tokens")),
      prompt=False,
    )


def scan_prompt_history(conn, stats, prefix):
  for session_id, timestamp in conn.execute("SELECT session_id, timestamp FROM prompt_history"):
    day = local_day(timestamp)
    if day is not None:
      stats.add_prompt(prefix + str(session_id), day)


def scan_session_totals(conn, stats, prefix, tables):
  # The older layout keeps one lifetime total per session and no split by
  # kind, so the tokens land on the day the session was last active and in
  # inputTokens, the one bucket that cannot overstate a split it doesn't have.
  for session_id, model, created_at, last_activity_at, total_tokens in conn.execute(
    "SELECT id, model, created_at, last_activity_at, total_tokens FROM sessions"
  ):
    day = local_day(last_activity_at) or local_day(created_at)
    if day is not None:
      stats.add(prefix + str(session_id), day, model_name(model), number(total_tokens), 0, 0, 0, prompt=False)
  if "messages" in tables and {"role", "timestamp", "session_id"} <= table_columns(conn, "messages"):
    for session_id, role, timestamp in conn.execute("SELECT session_id, role, timestamp FROM messages WHERE role = 'assistant'"):
      day = local_day(timestamp)
      if day is not None:
        stats.add_prompt(prefix + str(session_id), day)


def scan_devin_database(path, stats):
  """Add one session database. Returns whether it was read to the end."""
  try:
    # Read-only: Devin may be writing right now.
    conn = sqlite3.connect(path.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
  except sqlite3.Error:
    return False
  prefix = "devin:" + path.name + ":"
  try:
    conn.execute("PRAGMA query_only = ON")
    tables = {name for (name,) in conn.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
    known = False
    if "message_nodes" in tables and {"session_id", "created_at", "chat_message"} <= table_columns(conn, "message_nodes"):
      known = True
      scan_message_nodes(conn, stats, prefix)
    if "prompt_history" in tables and {"session_id", "timestamp"} <= table_columns(conn, "prompt_history"):
      known = True
      scan_prompt_history(conn, stats, prefix)
    if not known and "sessions" in tables and {"id", "model", "created_at", "last_activity_at", "total_tokens"} <= table_columns(conn, "sessions"):
      known = True
      scan_session_totals(conn, stats, prefix, tables)
    if not known:
      # A layout this collector doesn't know: reading it again won't help.
      print(f"omarchy-agent-usage-devin: {path} has no session tables this collector reads", file=sys.stderr)
  except sqlite3.Error as error:
    # Transient lock, schema migration, corruption: the numbers stop here,
    # incomplete.
    print(f"omarchy-agent-usage-devin: {path}: {error}", file=sys.stderr)
    return False
  finally:
    conn.close()
  return True


# --------------------------------------------------------------- pi and omp


def pi_pattern():
  return r'"provider"\s*:\s*"devin"'


def accept_pi(message):
  return str(message.get("provider") or "") == PROVIDER


# pi's and omp's session trees, each profile's too: `--profile=<name>` moves
# the whole agent tree under <base>/profiles/<name>/. pi moves its agent tree
# with PI_CODING_AGENT_DIR and its sessions alone with
# PI_CODING_AGENT_SESSION_DIR, both expanding a leading ~; either is read as
# well as the default trees, which keep whatever was written before the move.
def pi_session_roots():
  roots = []
  for base in (Path.home() / ".pi", Path.home() / ".omp"):
    roots.append(base / "agent" / "sessions")
    try:
      # Sorted so the scan order does not depend on directory order.
      roots.extend(sorted(child / "agent" / "sessions" for child in (base / "profiles").iterdir() if child.is_dir()))
    except OSError:
      # No profiles directory, or it is unreadable: the default root stands.
      pass
  if os.environ.get("PI_CODING_AGENT_DIR", "").strip():
    roots.append(Path(os.environ["PI_CODING_AGENT_DIR"].strip()).expanduser() / "sessions")
  if os.environ.get("PI_CODING_AGENT_SESSION_DIR", "").strip():
    roots.append(Path(os.environ["PI_CODING_AGENT_SESSION_DIR"].strip()).expanduser())
  # Canonical roots, so an override that aliases a default root through a
  # symlink is scanned under one spelling. A root inside another is already
  # read with it, so it is dropped rather than counted twice.
  canonical = list(dict.fromkeys(root.resolve() for root in roots))
  return [root for root in canonical if not any(other != root and root.is_relative_to(other) for other in canonical)]


def pi_parent_session(path):
  # A fork names the session it was cut from in its header line.
  try:
    with open(path, encoding="utf-8", errors="replace") as handle:
      header = json.loads(handle.readline())
  except (OSError, ValueError):
    return None
  parent = header.get("parentSession") if isinstance(header, dict) else None
  return os.path.abspath(os.path.expanduser(parent)) if isinstance(parent, str) and parent else None


def scan_pi_sessions(stats):
  """Add the pi/omp assistant messages this collector counts. Returns whether
  every root was read."""
  roots = [root for root in pi_session_roots() if root.is_dir()]
  if not roots:
    return True
  rg = find_command("rg") or "rg"
  try:
    proc = subprocess.Popen(
      # --no-ignore: these are data files, not a source tree. A $HOME that is
      # a git checkout would otherwise hide every session behind its ignores.
      [rg, "--json", "--no-ignore", "-e", pi_pattern(), *map(str, roots)],
      stdout=subprocess.PIPE,
      stderr=subprocess.DEVNULL,
      text=True,
      errors="replace",
      env=ENV,
    )
  except OSError:
    return False

  counted = set()
  owned = {}
  today_owned = {}
  assert proc.stdout is not None
  for raw in proc.stdout:
    try:
      event = json.loads(raw)
      if event.get("type") != "match":
        continue
      path = os.path.abspath(event["data"]["path"]["text"])
      line_number = event["data"].get("line_number")
      entry = json.loads(event["data"]["lines"]["text"])
    except Exception:
      continue
    if not isinstance(entry, dict) or entry.get("type") != "message":
      continue
    message = obj(entry.get("message"))
    if message.get("role") != "assistant" or not accept_pi(message):
      continue
    usage = obj(message.get("usage"))
    input_tokens = usage_tokens(usage, "input", "inputTokens", "input_tokens")
    # pi folds thinking into its own field; both are generated.
    output_tokens = usage_tokens(usage, "output", "outputTokens", "output_tokens") + usage_tokens(usage, "reasoning", "reasoningTokens", "reasoning_tokens")
    cache_read = usage_tokens(usage, "cacheRead", "cacheReadTokens", "cache_read", "cache_read_input_tokens")
    cache_write = usage_tokens(usage, "cacheWrite", "cacheWriteTokens", "cache_write", "cache_creation_input_tokens")
    if not (input_tokens or output_tokens or cache_read or cache_write):
      # Some writers keep only the total; it was still spent.
      input_tokens = usage_tokens(usage, "totalTokens", "total_tokens")
    timestamp = entry.get("timestamp")
    # The first time present decides: none at all is today's, and an
    # untrusted one, zero included, skips only this line.
    day = source_day(message.get("timestamp") if timestamp is None else timestamp)
    if day is None or not (input_tokens or output_tokens or cache_read or cache_write):
      continue
    # A fork repeats its parent's messages with their ids and timestamps, so
    # the pair says two lines are one message. An id alone is only unique
    # within its file, and a line without one always counts.
    message_id = str(entry.get("id") or "")
    if message_id and timestamp is not None:
      key = ("entry", message_id, str(timestamp))
    elif message_id:
      key = ("path", path, message_id)
    else:
      key = ("line", path, line_number)
    owned.setdefault(path, set()).add(key)
    if day == stats.today:
      today_owned.setdefault(path, set()).add(key)
    if key in counted:
      continue
    counted.add(key)
    stats.add(None, day, model_name(message.get("model")), input_tokens, output_tokens, cache_read, cache_write)

  try:
    code = proc.wait(timeout=5)
  except subprocess.TimeoutExpired:
    proc.kill()
    return False

  # A message belongs to the oldest session holding it, so a fork is a
  # session of its own only for what it added, whichever file rg read first.
  parents = {}
  for path, keys in owned.items():
    inherited = set()
    visited = {path}
    parent = parents.setdefault(path, pi_parent_session(path))
    while parent and parent not in visited:
      visited.add(parent)
      inherited |= owned.get(parent, set())
      parent = parents.setdefault(parent, pi_parent_session(parent))
    if keys - inherited:
      stats.add_session(path, bool(today_owned.get(path, set()) - inherited))
  # rg exits 1 when nothing matched and 2 when a file couldn't be read.
  return code in (0, 1)


# ---------------------------------------------------------------- opencode


def opencode_db():
  # The database opencode itself reads, as the opencode collector finds it:
  # OPENCODE_DB when set (a relative name lives beside the default one), and
  # opencode-v2.db only for the builds that wrote nothing else.
  root = data_home() / "opencode"
  configured = os.environ.get("OPENCODE_DB", "").strip()
  if configured:
    path = Path(configured).expanduser()
    return path if path.is_absolute() else root / path
  normal = root / "opencode.db"
  legacy = root / "opencode-v2.db"
  return legacy if not normal.is_file() and legacy.is_file() else normal


def add_opencode_row(stats, message_id, session_id, entry, row_type, created, seen):
  # The original `message` table keeps the provider and model at the top
  # level; V2's `session_message` nests them under `model` and keeps the role
  # in its `type` column, with a compaction's tokens spent like a reply's.
  if not isinstance(entry, dict) or (entry.get("role") or row_type) not in ("assistant", "compaction"):
    return
  nested = obj(entry.get("model"))
  if str(entry.get("providerID") or nested.get("providerID") or "") != PROVIDER:
    return
  tokens = obj(entry.get("tokens"))
  cache = obj(tokens.get("cache"))
  input_tokens = number(tokens.get("input"))
  # opencode keeps thinking tokens out of output; both are generated.
  output_tokens = number(tokens.get("output")) + number(tokens.get("reasoning"))
  cache_read = number(cache.get("read"))
  cache_write = number(cache.get("write"))
  if not (input_tokens or output_tokens or cache_read or cache_write):
    return
  # A message migrated into both stores counts once.
  if message_id in seen:
    return
  seen.add(message_id)
  # The message's own time, else the row's: none at all is today's, and an
  # untrusted one, zero included, skips only this row.
  stamp = obj(entry.get("time")).get("created")
  day = source_day(created if stamp is None else stamp)
  if day is None:
    return
  model = entry.get("modelID") or nested.get("id") or nested.get("modelID")
  stats.add("opencode:" + str(session_id), day, model_name(model), input_tokens, output_tokens, cache_read, cache_write)


def scan_opencode_db(stats):
  """Add the devin rows from both of opencode's message stores, deduplicated
  by message id. Returns whether the scan ran to completion."""
  db = opencode_db()
  if not db.is_file():
    return True
  try:
    # Read-only: opencode may be writing right now.
    conn = sqlite3.connect(db.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
  except sqlite3.Error:
    return False
  # The LIKE gate is pure acceleration; the Python filter stays the authority
  # for the rows that reach it.
  gate = "LIKE '%\"providerID\"%:%\"devin\"%'"
  try:
    conn.execute("PRAGMA query_only = ON")
    tables = {name for (name,) in conn.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
    seen = set()
    # V2 first: a build that migrated keeps reading, and a message in both
    # stores counts once.
    columns = table_columns(conn, "session_message") if "session_message" in tables else set()
    if {"id", "session_id", "type", "data"} <= columns:
      created = "m.time_created" if "time_created" in columns else "NULL"
      source = "session_message m"
      fork_filter = ""
      if "time_created" in columns and "session_v2" in tables and {"id", "fork_session_id", "time_created"} <= table_columns(conn, "session_v2"):
        # A fork copies its source session's messages under new ids; only
        # what came after the fork was spent in it.
        source += " LEFT JOIN session_v2 s ON s.id = m.session_id"
        fork_filter = " AND (s.fork_session_id IS NULL OR m.time_created >= s.time_created)"
      for message_id, session_id, row_type, time_created, raw in conn.execute(
        f"SELECT m.id, m.session_id, m.type, {created}, m.data FROM {source}"
        f" WHERE m.type IN ('assistant', 'compaction') AND m.data {gate}" + fork_filter
      ):
        # One row that still fails must not take the scan down with it.
        try:
          add_opencode_row(stats, str(message_id), session_id, json.loads(raw), str(row_type or ""), time_created, seen)
        except Exception:
          continue
    columns = table_columns(conn, "message") if "message" in tables else set()
    if {"session_id", "data"} <= columns:
      row_id = "id" if "id" in columns else "rowid"
      for message_id, session_id, raw in conn.execute(
        f"SELECT {row_id}, session_id, data FROM message"
        f" WHERE data LIKE '%\"role\"%:%\"assistant\"%' AND data {gate}"
      ):
        try:
          add_opencode_row(stats, str(message_id), session_id, json.loads(raw), "", None, seen)
        except Exception:
          continue
  except sqlite3.Error as error:
    # Transient lock, schema migration, corruption: the numbers stop here,
    # incomplete.
    print(f"omarchy-agent-usage-devin: {db}: {error}", file=sys.stderr)
    return False
  finally:
    conn.close()
  return True


# -------------------------------------------------------------- scan cache


def scan_cache_paths():
  digest = hashlib.sha1("\n".join([
    str(Path.home()), str(data_dir()), str(data_home()), *map(str, pi_session_roots()), str(opencode_db()),
  ]).encode("utf-8")).hexdigest()[:16]
  root = cache_root()
  return root / f"devin-scan-{digest}.json", root / f"devin-scan-{digest}.lock"


def run_local_scans():
  stats = Stats()
  complete = scan_pi_sessions(stats)
  for path in session_databases():
    complete = scan_devin_database(path, stats) and complete
  complete = scan_opencode_db(stats) and complete
  return stats.record(), complete


def read_cached_stats(cache_file, max_age):
  cached = read_fresh_json(cache_file, max_age)
  if not isinstance(cached, dict) or cached.get("schemaVersion") != 2:
    return None
  # today* fields only mean "today" on the day they were scanned.
  if cached.get("scanDate") != datetime.now().strftime("%Y-%m-%d"):
    return None
  stats = cached.get("stats")
  return stats if isinstance(stats, dict) and set(Stats().record()) <= set(stats) else None


def cached_local_stats(max_age):
  """Local stats, with the cache as a pure optimization: any cache-layer
  failure degrades to a direct scan and a warning on stderr."""
  try:
    cache_file, lock_file = scan_cache_paths()
    cached = read_cached_stats(cache_file, max_age)
    if cached is not None:
      return cached
    with lock_file.open("w") as lock:
      fcntl.flock(lock, fcntl.LOCK_EX)
      cached = read_cached_stats(cache_file, max_age)
      if cached is not None:
        return cached
      stats, complete = run_local_scans()
      # A scan that couldn't read everything serves this run, but caching it
      # would hide the missing usage from every reader until it expires.
      if complete:
        write_json(cache_file, {"schemaVersion": 2, "scanDate": datetime.now().strftime("%Y-%m-%d"), "stats": stats})
      return stats
  except Exception as exc:
    print(f"omarchy-agent-usage-devin: cache unavailable ({exc}); scanning directly", file=sys.stderr)
    return run_local_scans()[0]


# ------------------------------------------------------------------ quota
#
# GetUserStatus is protobuf, and the record needs a handful of its fields, so
# they are walked by hand rather than through generated code. In the cached
# UserStatus, field 10 is the plan tier and field 13 the PlanStatus; inside
# that, field 1 is the PlanInfo, 3 the plan's end, 5-7 the credits used,
# 14/15 the daily/weekly percent remaining and 17/18 their reset times.


def decode_varint(data, pos):
  result = 0
  shift = 0
  while True:
    byte = data[pos]
    result |= (byte & 0x7F) << shift
    pos += 1
    if not byte & 0x80:
      return result, pos
    shift += 7
    if shift > 63:
      raise ValueError("varint too long")


def proto_fields(data):
  """field number -> first value: an int for a varint, bytes for a message."""
  found = {}
  pos = 0
  try:
    while pos < len(data):
      tag, pos = decode_varint(data, pos)
      number_, wire = tag >> 3, tag & 0x07
      if wire == 0:
        value, pos = decode_varint(data, pos)
      elif wire == 1:
        value, pos = None, pos + 8
      elif wire == 2:
        length, pos = decode_varint(data, pos)
        value, pos = bytes(data[pos:pos + length]), pos + length
      elif wire == 5:
        value, pos = None, pos + 4
      else:
        break
      if value is not None:
        found.setdefault(number_, value)
  except (IndexError, ValueError):
    pass
  return found


def message(fields, number_):
  value = fields.get(number_)
  return proto_fields(value) if isinstance(value, bytes) else {}


def varint(fields, number_):
  value = fields.get(number_)
  if not isinstance(value, int):
    return None
  return value - (1 << 64) if value >= (1 << 63) else value


def text(fields, number_):
  value = fields.get(number_)
  return value.decode("utf-8", errors="replace").strip() if isinstance(value, bytes) else ""


def quota_window(label, remaining, reset):
  # The percent is what's left; the panel wants what's spent. Proto3 leaves a
  # zero off the wire, so a window with nothing left carries no percent.
  remaining = max(0, min(100, remaining or 0))
  return {"label": label, "percent": (100 - remaining) / 100.0, "resetsAt": iso_from_unix(reset)}


def parse_user_status(payload):
  status = proto_fields(payload)
  plan_status = message(status, 13)
  plan = message(plan_status, 1)
  devin_info = message(plan, 33)
  tier = text(devin_info, 2) or text(plan, 2) or TEAMS_TIER.get(varint(plan, 1)) or TEAMS_TIER.get(varint(status, 10)) or ""

  limits = []
  if plan_status:
    # A credit plan leaves the quota percents at their defaults, so a window
    # only shows when the server dates its reset or the plan bills by quota,
    # and never when the plan hides it.
    quota_plan = varint(plan, 35) == 2
    windows = (("Daily", 36, 14, 17), ("Weekly", 37, 15, 18))
    for label, hidden, remaining, reset in windows:
      if varint(plan, hidden):
        continue
      if (varint(plan_status, reset) or 0) > 0 or quota_plan:
        limits.append(quota_window(label, varint(plan_status, remaining), varint(plan_status, reset)))

    # Monthly credit buckets exist only on credit plans, and last until the
    # plan's period ends; a quota plan reports no grant and is skipped.
    plan_end = iso_from_unix(varint(message(plan_status, 3), 1))
    for label, limit_field, used_field in (("Prompt credits", 12, 6), ("Flow credits", 13, 5), ("Flex credits", 14, 7)):
      limit = varint(plan, limit_field) or 0
      used = max(0, varint(plan_status, used_field) or 0)
      if limit > 0:
        limits.append({"label": label, "percent": min(1.0, used / limit), "resetsAt": plan_end})
  return {"tierLabel": tier, "limits": limits}


def user_status_dir():
  return Path(os.environ.get("DEVIN_CACHE_DIR") or (xdg_cache_home() / "devin" / "cli"))


def sign_in_time():
  # The CLI rewrites credentials.toml on sign-in, so a status fetched before
  # that write describes the account signed in before. The fetch can land a
  # beat before the file is flushed, hence the small allowance.
  try:
    return credentials_path().stat().st_mtime - 30
  except OSError:
    return None


def limit_window_open(entry, now):
  raw = str(entry.get("resetsAt") or "")
  if raw == "":
    return True
  try:
    resets_at = datetime.fromisoformat(raw.replace("Z", "+00:00"))
  except ValueError:
    return True
  if resets_at.tzinfo is None:
    resets_at = resets_at.replace(tzinfo=timezone.utc)
  return resets_at > now


# A window whose reset has passed is untouched, not unknown: it comes back at
# zero with no reset time until the CLI fetches the next one.
def usable_limits(entries):
  now = datetime.now(timezone.utc)
  return [entry if limit_window_open(entry, now) else dict(entry, percent=0.0, resetsAt="") for entry in entries]


def read_quota():
  """The newest user-status cache fetched under the current sign-in, or None.

  The CLI keeps one cache per sign-in and no marker of which is active, so
  the newest fetch wins, and fetches from before the last sign-in are dropped:
  after a switch with no fetch since, nothing qualifies rather than the
  previous account's numbers. Without a credentials file to date the sign-in,
  the newest fetch stands.
  """
  cutoff = sign_in_time()
  best = None
  try:
    paths = sorted(user_status_dir().glob("user_status.*.bin"))
  except OSError:
    paths = []
  for path in paths:
    cache = read_json(path)
    if not isinstance(cache, dict) or not isinstance(cache.get("payload"), str):
      continue
    fetched_at = epoch_seconds(cache.get("fetched_at_secs"))
    if fetched_at is None or (cutoff is not None and fetched_at < cutoff):
      continue
    try:
      quota = parse_user_status(base64.b64decode(cache["payload"], validate=True))
    except ValueError:
      continue
    if not quota["limits"] and not quota["tierLabel"]:
      continue
    if best is None or fetched_at > best[0]:
      best = (fetched_at, quota)
  if best is None:
    return None
  fetched_at, quota = best
  age = time.time() - fetched_at
  return {
    "tierLabel": quota["tierLabel"],
    "limits": usable_limits(quota["limits"]),
    "limitsFetchedAt": round(fetched_at * 1000),
    "limitsStale": not 0 <= age < LIMITS_CURRENT_ENOUGH_SECONDS,
  }


# ------------------------------------------------------------------ record


def build_record(stats):
  quota = read_quota()
  signed_in = credentials_path().is_file()
  in_use = number(stats.get("totalPrompts")) > 0 or bool(stats.get("modelUsage"))

  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "ready": in_use or signed_in or bool(quota and quota["limits"]),
    "hasLocalStats": True,
    "tierLabel": "",
    "usageStatusText": "",
    "authHelpText": "",
    "limits": [],
    "limitsStale": False,
    "limitsFetchedAt": 0,
  }
  if quota:
    record.update(quota)
  elif signed_in:
    record["usageStatusText"] = "Devin limits unavailable"
    record["authHelpText"] = REFRESH_HELP
  elif in_use:
    record["usageStatusText"] = "Waiting for auth"
    record["authHelpText"] = AUTH_HELP
  record.update(stats)
  return record


def main():
  parser = argparse.ArgumentParser(description="Print the Devin usage record as JSON")
  parser.add_argument("--force", action="store_true", help="rescan local sessions, ignoring the scan cache")
  parser.add_argument("--limits-only", action="store_true", help="reuse a recent local scan")
  args = parser.parse_args()

  max_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else SCAN_REUSE_SECONDS)
  print(json.dumps(build_record(cached_local_stats(max_age)), separators=(",", ":"), sort_keys=True))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
