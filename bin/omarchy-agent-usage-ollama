#!/usr/bin/python3
# omarchy:summary=Print the Ollama Cloud usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Ollama Cloud usage into one display-ready JSON record.

Everything the agents panel shows for Ollama Cloud comes from this one
command: local token stats from pi and omp sessions and from opencode's
message database that ran on the `ollama-cloud` provider (or on a cloud model
through the local daemon), and the account's 5-hour session and 7-day weekly
limits from Ollama's usage endpoint. The panel itself only ever reads the
JSON this prints; it never talks to disk formats or endpoints.
"""

from __future__ import annotations

import argparse
import base64
import datetime as dt
import fcntl
import hashlib
import json
import math
import os
import sqlite3
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any

AGENT_ID = "ollama"
AGENT_NAME = "Ollama Cloud"
PROVIDER = "ollama-cloud"
USAGE_ENDPOINT = "https://ollama.com/api/usage"
ME_ENDPOINT = "https://ollama.com/api/me"
AUTH_HELP_NO_KEY = "Set OLLAMA_API_KEY, or sign in to pi with an Ollama Cloud key, to show the account limits."
AUTH_HELP_BAD_KEY = (
  "Ollama Cloud rejected the API key. Update OLLAMA_API_KEY or ~/.config/omarchy/agents/ollama.json,"
  " or sign in to pi again. Local stats are still shown."
)
# A scan this recent is only reused to dedup concurrent collector runs (the
# update command backgrounds one per agent while the panel refreshes on its
# own). --limits-only promises only fresh limits, so it may reuse a scan for
# up to 15 minutes.
SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900
# The panel opens and shuts fire a probe each; a recent probe result is reused
# for this window rather than turning every flick into a request.
PROBE_MIN_INTERVAL_SECONDS = 15
# The usage endpoint reports how much of each window is used but not when it
# resets, so the limits carry no reset time rather than a guessed one.

# Bounds for numbers read from session files. A timestamp outside them, or a
# token count above the cap, is corruption rather than usage.
EARLIEST_SECONDS = 946_684_800  # 2000-01-01
LATEST_SECONDS = 4_102_444_800  # 2100-01-01
MAX_TOKENS = 10_000_000_000


def config_dir() -> Path:
  return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "omarchy" / "agents"


def cache_root() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def read_json(path: Path) -> dict[str, Any]:
  # Read whatever the file's time: a clock that went back must not lose the
  # last good answer. Freshness is judged by the times stored inside.
  try:
    data = json.loads(path.read_text(encoding="utf-8"))
  except Exception:
    return {}
  return data if isinstance(data, dict) else {}


def read_config() -> dict[str, Any]:
  return read_json(config_dir() / "ollama.json")


def pi_agent_dir() -> Path:
  configured = os.environ.get("PI_CODING_AGENT_DIR", "").strip()
  return Path(os.path.expanduser(configured)) if configured else Path.home() / ".pi" / "agent"


def api_key() -> str:
  env = os.environ.get("OLLAMA_API_KEY", "").strip()
  if env:
    return env
  configured = str(read_config().get("apiKey") or "").strip()
  if configured:
    return configured
  # pi and omp store the Ollama Cloud key they signed in with; either one
  # proves the account, and the usage endpoint accepts the same key. Only a
  # literal key is taken: a `$VAR` or `!command` entry is resolved by pi alone.
  for auth_path in (pi_agent_dir() / "auth.json", Path.home() / ".omp" / "agent" / "auth.json"):
    entry = read_json(auth_path).get(PROVIDER)
    key = str(entry.get("key") or "").strip() if isinstance(entry, dict) else ""
    if key and not key.startswith(("!", "$")):
      return key
  return ""


def date_string(value: dt.date) -> str:
  return value.strftime("%Y-%m-%d")


def recent_date_strings() -> list[str]:
  today = dt.datetime.now().date()
  return [date_string(today - dt.timedelta(days=offset)) for offset in range(6, -1, -1)]


def local_date_string() -> str:
  return date_string(dt.datetime.now().date())


def local_date_from_timestamp(value: Any) -> str | None:
  """The local date of an untrusted timestamp, or None when it isn't one."""
  if isinstance(value, bool):
    return None
  if isinstance(value, (int, float)):
    if not math.isfinite(value):
      return None
    # pi/omp message timestamps are milliseconds.
    seconds = value / 1000 if value > 10_000_000_000 else value
    if not EARLIEST_SECONDS <= seconds < LATEST_SECONDS:
      return None
    return date_string(dt.datetime.fromtimestamp(seconds).date())
  if not isinstance(value, str) or not value.strip():
    return None
  try:
    parsed = dt.datetime.fromisoformat(value.strip().replace("Z", "+00:00"))
  except ValueError:
    return None
  if parsed.tzinfo is not None:
    parsed = parsed.astimezone()
  if not 2000 <= parsed.year < 2100:
    return None
  return date_string(parsed.date())


# A pi or opencode row's day, read as every collector reading those sources
# reads it: a row with no time at all is today's, and an untrusted time is
# None, so the caller skips that row alone.
def source_day(value: Any) -> str | None:
  return local_date_string() if value is None else local_date_from_timestamp(value)


# pi, omp, and the harnesses that copy their format spell usage camelCase or
# snake_case; the first spelling present wins.
def usage_tokens(usage: dict[str, Any], *keys: str) -> int:
  for key in keys:
    if key in usage:
      return token_count(usage.get(key))
  return 0


def token_count(value: Any) -> int:
  # Booleans are ints to Python, and a NaN or negative count would poison
  # every sum it reaches, so anything but a plain finite count reads as none.
  if isinstance(value, bool) or not isinstance(value, (int, float)):
    return 0
  if not math.isfinite(value) or value < 0 or value > MAX_TOKENS:
    return 0
  return int(value)


def stamp(value: Any) -> int:
  # An epoch-ms stamp this collector wrote, read back without trusting it.
  if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
    return 0
  return max(0, int(value))


def age_below(stamp_seconds: float, limit_seconds: float) -> bool:
  # A negative age is a stamp from the future: the clock moved back since it
  # was written, so it proves nothing about freshness.
  age = time.time() - stamp_seconds
  return 0 <= age < limit_seconds


def empty_bucket() -> dict[str, int]:
  return {
    "inputTokens": 0,
    "outputTokens": 0,
    "cacheReadInputTokens": 0,
    "cacheCreationInputTokens": 0,
  }


def empty_stats() -> dict[str, Any]:
  return {
    "todayPrompts": 0,
    "todaySessions": 0,
    "todayTotalTokens": 0,
    "todayTokensByModel": {},
    "recentDays": [{"date": day, "messageCount": 0} for day in recent_date_strings()],
    "modelUsage": {},
    "totalPrompts": 0,
    "totalSessions": 0,
    "activeDays": 0,
    "activeDates": [],
  }


def write_json(path: Path, payload: dict[str, Any]) -> None:
  # A temp name unique to this writer, not derived from the target: several
  # collectors can run at once (the update command backgrounds one per agent,
  # the panel refreshes on its own), and a shared temp path means the second
  # replace finds the first one's file already moved away.
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, separators=(",", ":"), sort_keys=True) + "\n")
    # mkstemp opens at 0600; these caches were world-readable before.
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


# ---------------------------------------------------------------- local scan
#
# pi and omp record every assistant message with its provider, model, and
# token usage in JSONL session files, and opencode in its message database,
# under the same provider ids. The `ollama-cloud` provider is the
# Ollama Cloud API, which serves Claude models alongside the open ones. A
# cloud-tagged model ("glm-4.6:cloud", "gpt-oss:120b-cloud") reached through
# the local daemon's `ollama` provider runs on Ollama's servers too, so it
# counts here; the local collector leaves exactly those out.


def is_cloud_model(model: str) -> bool:
  tag = model.lower().rpartition(":")[2] if ":" in model else ""
  return tag == "cloud" or tag.endswith("-cloud")


def billed_by_ollama_cloud(provider: str, model: str) -> bool:
  return provider == PROVIDER or (provider == "ollama" and is_cloud_model(model))


# pi's and omp's session trees, each profile's too: `--profile=<name>` moves
# the whole agent tree under <base>/profiles/<name>/. pi moves its agent tree
# with PI_CODING_AGENT_DIR and its sessions alone with
# PI_CODING_AGENT_SESSION_DIR, both expanding a leading ~; either is read as
# well as the default trees, which keep whatever was written before the move.
def pi_session_roots() -> list[Path]:
  roots: list[Path] = []
  for base in (Path.home() / ".pi", Path.home() / ".omp"):
    roots.append(base / "agent" / "sessions")
    try:
      # Sorted so the scan order does not depend on directory order.
      roots.extend(sorted(child / "agent" / "sessions" for child in (base / "profiles").iterdir() if child.is_dir()))
    except OSError:
      # No profiles directory, or it is unreadable: the default root stands.
      pass
  if os.environ.get("PI_CODING_AGENT_DIR", "").strip():
    roots.append(Path(os.environ["PI_CODING_AGENT_DIR"].strip()).expanduser() / "sessions")
  if os.environ.get("PI_CODING_AGENT_SESSION_DIR", "").strip():
    roots.append(Path(os.environ["PI_CODING_AGENT_SESSION_DIR"].strip()).expanduser())
  # Canonical roots, so an override that aliases a default root through a
  # symlink is scanned under one spelling. A root inside another is already
  # read with it, so it is dropped rather than counted twice.
  canonical = list(dict.fromkeys(root.resolve() for root in roots))
  return [root for root in canonical if not any(other != root and root.is_relative_to(other) for other in canonical)]


def matching_lines(root: Path, pattern: str) -> tuple[list[tuple[str, str]], bool]:
  """(path, line) for each session line matching `pattern`, and whether every file was read."""
  try:
    proc = subprocess.run(
      # --no-ignore: these are data files, not a source tree. When $HOME is
      # itself a git checkout (a common dotfiles setup), its ignore rules
      # would otherwise hide every session file and count zero usage.
      ["rg", "--json", "--no-ignore", "--hidden", "--glob", "*.jsonl", "-e", pattern, str(root)],
      stdout=subprocess.PIPE,
      stderr=subprocess.DEVNULL,
      text=True,
      errors="replace",
      check=False,
    )
  except OSError:
    return [], False
  lines = []
  for raw in proc.stdout.splitlines():
    try:
      event = json.loads(raw)
      if event.get("type") != "match":
        continue
      data = event["data"]
      text = data["lines"].get("text")
      if text is None:
        # rg hands back lines that are not valid UTF-8 as base64.
        text = base64.b64decode(data["lines"]["bytes"]).decode("utf-8", errors="replace")
      lines.append((data["path"].get("text") or "", text))
    except Exception:
      continue
  # 1 is "no match"; 2 means some file could not be read.
  return lines, proc.returncode in (0, 1)


def opencode_db() -> Path:
  # The database opencode itself reads, as the opencode collector finds it:
  # OPENCODE_DB when set (a relative name lives beside the default one), and
  # opencode-v2.db only for the builds that wrote nothing else.
  root = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share") / "opencode"
  configured = os.environ.get("OPENCODE_DB", "").strip()
  if configured:
    path = Path(configured).expanduser()
    return path if path.is_absolute() else root / path
  normal = root / "opencode.db"
  legacy = root / "opencode-v2.db"
  return legacy if not normal.is_file() and legacy.is_file() else normal


def table_columns(conn: sqlite3.Connection, table: str) -> set[str]:
  try:
    return {row[1] for row in conn.execute(f"PRAGMA table_info({table})")}
  except sqlite3.Error:
    return set()


def add_opencode_row(add: Any, message_id: str, session_id: Any, entry: Any, row_type: str, created: Any, seen: set[str]) -> None:
  """Hand `add` what an opencode row billed to Ollama Cloud, if anything."""
  # The original `message` table keeps the provider and model at the top
  # level; V2's `session_message` nests them under `model` and keeps the role
  # in its `type` column, with a compaction's tokens spent like a reply's.
  if not isinstance(entry, dict) or (entry.get("role") or row_type) not in ("assistant", "compaction"):
    return
  nested = entry.get("model") if isinstance(entry.get("model"), dict) else {}
  provider = str(entry.get("providerID") or nested.get("providerID") or "")
  model = str(entry.get("modelID") or nested.get("id") or nested.get("modelID") or "")
  if not billed_by_ollama_cloud(provider, model):
    return
  tokens = entry.get("tokens") if isinstance(entry.get("tokens"), dict) else {}
  cache = tokens.get("cache") if isinstance(tokens.get("cache"), dict) else {}
  input_tokens = token_count(tokens.get("input"))
  # opencode keeps thinking tokens out of output; both are generated.
  output_tokens = token_count(tokens.get("output")) + token_count(tokens.get("reasoning"))
  cache_read = token_count(cache.get("read"))
  cache_write = token_count(cache.get("write"))
  if not (input_tokens or output_tokens or cache_read or cache_write):
    return
  # A message migrated into both stores counts once.
  if message_id in seen:
    return
  seen.add(message_id)
  # The message's own time, else the row's: none at all is today's, and an
  # untrusted one, zero included, skips only this row.
  stamped = entry.get("time")
  stamp = stamped.get("created") if isinstance(stamped, dict) else None
  day = source_day(created if stamp is None else stamp)
  if day is None:
    return
  add("opencode:" + str(session_id), day, model, input_tokens, output_tokens, cache_read, cache_write)


def scan_opencode_db(add: Any) -> bool:
  """Feed `add` the Ollama Cloud rows from both of opencode's message stores,
  deduplicated by message id. Returns whether the scan ran to completion."""
  db = opencode_db()
  if not db.is_file():
    return True
  try:
    # Read-only: opencode may be writing right now.
    conn = sqlite3.connect(db.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
  except sqlite3.Error:
    return False
  # The LIKE gate is pure acceleration, matching both provider ids; the
  # Python filter stays the authority for the rows that reach it.
  gate = "LIKE '%\"providerID\"%:%\"ollama%'"
  try:
    conn.execute("PRAGMA query_only = ON")
    tables = {name for (name,) in conn.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
    seen: set[str] = set()
    # V2 first: a build that migrated keeps reading, and a message in both
    # stores counts once.
    columns = table_columns(conn, "session_message") if "session_message" in tables else set()
    if {"id", "session_id", "type", "data"} <= columns:
      created = "m.time_created" if "time_created" in columns else "NULL"
      source = "session_message m"
      fork_filter = ""
      if "time_created" in columns and "session_v2" in tables and {"id", "fork_session_id", "time_created"} <= table_columns(conn, "session_v2"):
        # A fork copies its source session's messages under new ids; only
        # what came after the fork was spent in it.
        source += " LEFT JOIN session_v2 s ON s.id = m.session_id"
        fork_filter = " AND (s.fork_session_id IS NULL OR m.time_created >= s.time_created)"
      for message_id, session_id, row_type, time_created, raw in conn.execute(
        f"SELECT m.id, m.session_id, m.type, {created}, m.data FROM {source}"
        f" WHERE m.type IN ('assistant', 'compaction') AND m.data {gate}" + fork_filter
      ):
        # One row that still fails must not take the scan down with it.
        try:
          add_opencode_row(add, str(message_id), session_id, json.loads(raw), str(row_type or ""), time_created, seen)
        except Exception:
          continue
    columns = table_columns(conn, "message") if "message" in tables else set()
    if {"session_id", "data"} <= columns:
      row_id = "id" if "id" in columns else "rowid"
      for message_id, session_id, raw in conn.execute(
        f"SELECT {row_id}, session_id, data FROM message"
        f" WHERE data LIKE '%\"role\"%:%\"assistant\"%' AND data {gate}"
      ):
        try:
          add_opencode_row(add, str(message_id), session_id, json.loads(raw), "", None, seen)
        except Exception:
          continue
  except sqlite3.Error:
    # Transient lock, schema migration, corruption: the numbers stop here,
    # incomplete.
    return False
  finally:
    conn.close()
  return True


def scan_sessions(model_prefix: str) -> tuple[dict[str, Any], bool]:
  recent_dates = recent_date_strings()
  recent = {day: {"date": day, "messageCount": 0} for day in recent_dates}
  today = local_date_string()

  sessions: set[str] = set()
  active_days: set[str] = set()
  today_sessions: set[str] = set()
  today_tokens: dict[str, int] = {}
  usage_by_model: dict[str, dict[str, int]] = {}
  # A forked session copies its parent's messages, ids and timestamps alike,
  # so (id, timestamp) counts each once across files. A line with an id but
  # no timestamp dedups within its file only; a line with no id always counts.
  seen: set[tuple[str, ...]] = set()
  prompts = 0
  today_prompt_count = 0
  today_token_total = 0
  complete = True

  def add(session: str, day: str, raw_model: Any, input_tokens: int, output_tokens: int, cache_read: int, cache_write: int) -> None:
    nonlocal prompts, today_prompt_count, today_token_total
    total = input_tokens + output_tokens + cache_read + cache_write
    # Ollama model ids carry a version tag ("deepseek-v4-pro:0813"); merge
    # tags so the chart groups by model, not by release.
    model = str(raw_model or "ollama").split(":", 1)[0]
    if model_prefix and not model.lower().startswith(model_prefix):
      return
    sessions.add(session)
    active_days.add(day)
    prompts += 1
    bucket = usage_by_model.setdefault(model, empty_bucket())
    bucket["inputTokens"] += input_tokens
    bucket["outputTokens"] += output_tokens
    bucket["cacheReadInputTokens"] += cache_read
    bucket["cacheCreationInputTokens"] += cache_write
    if day in recent:
      # recentDays.messageCount is actually a token total, despite the
      # legacy name shared with synced snapshots.
      recent[day]["messageCount"] += total
    if day == today:
      today_prompt_count += 1
      today_sessions.add(session)
      today_token_total += total
      today_tokens[model] = today_tokens.get(model, 0) + total

  for root in pi_session_roots():
    if not root.is_dir():
      continue
    lines, read_all = matching_lines(root, r'"provider"\s*:\s*"ollama(-cloud)?"')
    complete = complete and read_all
    for path, line in lines:
      try:
        entry = json.loads(line)
      except ValueError:
        continue
      if not isinstance(entry, dict) or entry.get("type") != "message":
        continue
      message = entry.get("message")
      if not isinstance(message, dict) or message.get("role") != "assistant":
        continue
      if not billed_by_ollama_cloud(str(message.get("provider") or ""), str(message.get("model") or "")):
        continue
      usage = message.get("usage")
      if not isinstance(usage, dict):
        continue
      input_tokens = usage_tokens(usage, "input", "inputTokens", "input_tokens")
      # pi folds thinking into its own field; both are generated.
      output_tokens = usage_tokens(usage, "output", "outputTokens", "output_tokens") + usage_tokens(usage, "reasoning", "reasoningTokens", "reasoning_tokens")
      cache_read = usage_tokens(usage, "cacheRead", "cacheReadTokens", "cache_read", "cache_read_input_tokens")
      cache_write = usage_tokens(usage, "cacheWrite", "cacheWriteTokens", "cache_write", "cache_creation_input_tokens")
      total = input_tokens + output_tokens + cache_read + cache_write
      if total <= 0:
        # Some writers keep only the total; it was still spent.
        total = usage_tokens(usage, "totalTokens", "total_tokens")
        input_tokens = total
      if total <= 0:
        continue
      # The first time present decides: none at all is today's, and an
      # untrusted one, zero included, skips only this line.
      stamp = entry.get("timestamp")
      day = source_day(message.get("timestamp") if stamp is None else stamp)
      if day is None:
        continue

      message_id = entry.get("id")
      timestamp = entry.get("timestamp")
      if isinstance(message_id, str) and message_id:
        key = ("entry", message_id, str(timestamp)) if timestamp else ("path", path, message_id)
        if key in seen:
          continue
        seen.add(key)

      add(path, day, message.get("model"), input_tokens, output_tokens, cache_read, cache_write)

  complete = scan_opencode_db(add) and complete

  stats = {
    "todayPrompts": today_prompt_count,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": today_token_total,
    "todayTokensByModel": today_tokens,
    "recentDays": [recent[day] for day in recent_dates],
    "modelUsage": usage_by_model,
    "totalPrompts": prompts,
    "totalSessions": len(sessions),
    "activeDays": len(active_days),
    "activeDates": sorted(active_days),
  }
  return stats, complete


def cached_scan(max_age_seconds: float, model_prefix: str) -> dict[str, Any]:
  # The digest covers every data path the scan reads: the pi/omp session
  # roots and the opencode DB.
  roots = "\0".join([str(root) for root in pi_session_roots()] + [str(opencode_db())])
  digest = hashlib.sha1(roots.encode("utf-8")).hexdigest()[:16]
  cache_file = cache_root() / f"ollama-scan-{digest}.json"
  lock_file = cache_root() / f"ollama-scan-{digest}.lock"

  # A scan only answers for the day it ran on (its today* counts would be
  # yesterday's after midnight) and for the model filter it applied.
  def reusable() -> dict[str, Any] | None:
    cached = read_json(cache_file)
    stats = cached.get("stats")
    if (
      cached.get("scanDate") == local_date_string()
      and cached.get("modelPrefix") == model_prefix
      and age_below(stamp(cached.get("scannedAtMs")) / 1000, max_age_seconds)
      and isinstance(stats, dict)
    ):
      return stats
    return None

  stats = reusable()
  if stats is not None:
    return stats
  try:
    with lock_file.open("w") as lock:
      fcntl.flock(lock, fcntl.LOCK_EX)
      stats = reusable()
      if stats is not None:
        return stats
      stats, complete = scan_sessions(model_prefix)
      # A scan that missed a file would stand in for a real one until the
      # next rescan; only a complete one is kept.
      if complete:
        write_json(cache_file, {
          "scanDate": local_date_string(),
          "scannedAtMs": int(time.time() * 1000),
          "modelPrefix": model_prefix,
          "stats": stats,
        })
      return stats
  except OSError as exc:
    # The cache is an optimization; the record is the contract.
    print(f"omarchy-agent-usage-ollama: cache unavailable ({exc}); scanning directly", file=sys.stderr)
    return scan_sessions(model_prefix)[0]


# ------------------------------------------------------------------- limits


def clamp_fraction(value: Any) -> float:
  if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value < 0:
    return -1.0
  return min(1.0, float(value))


def probe_limits(access_key: str) -> dict[str, Any]:
  request = urllib.request.Request(
    USAGE_ENDPOINT,
    headers={"Authorization": "Bearer " + access_key, "Accept": "application/json"},
  )
  try:
    with urllib.request.urlopen(request, timeout=10) as response:
      payload = json.loads(response.read().decode("utf-8", errors="replace"))
  except urllib.error.HTTPError as error:
    if error.code in (401, 403):
      return {"ok": False, "auth": True, "helpText": AUTH_HELP_BAD_KEY}
    return {"ok": False, "helpText": f"Ollama's usage endpoint returned status {error.code}. Local stats are still shown."}
  except OSError:
    # A transport failure reached no server at all — no route, no DNS. Any
    # real answer, including an error status, is a server we should stop
    # pestering; this is not.
    return {
      "ok": False,
      "transport": True,
      "helpText": "Couldn't reach Ollama's usage endpoint. Retrying shortly. Local stats are still shown.",
    }
  except ValueError:
    return {"ok": False, "helpText": "Ollama's usage endpoint returned an invalid answer. Local stats are still shown."}

  limits = payload.get("limits") if isinstance(payload, dict) else None
  if not isinstance(limits, dict):
    return {"ok": False, "helpText": "Ollama's usage endpoint returned no limits. Local stats are still shown."}

  out = []
  session = limits.get("session")
  weekly = limits.get("weekly")
  if isinstance(session, dict):
    percent = clamp_fraction(session.get("usage"))
    if percent >= 0:
      out.append({"label": "Session (5-hour)", "percent": percent, "resetsAt": ""})
  if isinstance(weekly, dict):
    percent = clamp_fraction(weekly.get("usage"))
    if percent >= 0:
      out.append({"label": "Weekly (7-day)", "percent": percent, "resetsAt": ""})
  if not out:
    return {"ok": False, "helpText": "Ollama's usage endpoint returned no limits. Local stats are still shown."}
  return {"ok": True, "limits": out}


def probe_plan(access_key: str) -> str | None:
  """The plan Ollama names for the key, "" when it names none, None when it couldn't be asked."""
  request = urllib.request.Request(
    ME_ENDPOINT,
    headers={"Authorization": "Bearer " + access_key, "Accept": "application/json"},
    method="POST",
  )
  try:
    with urllib.request.urlopen(request, timeout=10) as response:
      payload = json.loads(response.read().decode("utf-8", errors="replace"))
  except Exception:
    return None
  plan = str(payload.get("Plan") or "").strip()[:64] if isinstance(payload, dict) else ""
  return plan[0].upper() + plan[1:] if plan else ""


def limits_cache_path(access_key: str) -> Path:
  # Keyed by the credential: another key never shows this one's allowance or
  # plan.
  digest = hashlib.sha256(access_key.encode("utf-8")).hexdigest()[:16]
  return cache_root() / f"ollama-limits-{digest}.json"


def collect_limits(access_key: str, force: bool) -> dict[str, Any]:
  # `live` says whether the limits are this check's (or a probe recent enough
  # to stand in for one), `fetchedAtMs` when they were measured, so the panel
  # can tell kept limits from fresh ones.
  result = {"limits": [], "tierLabel": "", "usageStatusText": "", "authHelpText": "", "live": False, "fetchedAtMs": 0}

  if access_key == "":
    result["usageStatusText"] = "Waiting for auth"
    result["authHelpText"] = AUTH_HELP_NO_KEY
    return result

  # A panel that is opened and shut repeatedly must not turn into a request
  # per flick, so recent probe results are reused for a short window — and
  # kept as the answer of record when a later probe fails. The endpoint names
  # no reset times, so a kept window stays as it was measured.
  probe_cache = limits_cache_path(access_key)
  cached = read_json(probe_cache)
  fallback = [entry for entry in cached.get("limits") or [] if isinstance(entry, dict)] if isinstance(cached.get("limits"), list) else []
  cached_plan = str(cached.get("plan") or "")
  fetched_ms = stamp(cached.get("fetchedAtMs"))

  # --force is a person asking for fresh numbers, so it skips the reuse window
  # entirely; the interval is there to absorb repeated panel opens, not to
  # overrule someone who pressed refresh.
  if fallback and not force and age_below(fetched_ms / 1000, PROBE_MIN_INTERVAL_SECONDS):
    result.update(limits=fallback, tierLabel=cached_plan, live=True, fetchedAtMs=fetched_ms)
    return result

  probe = probe_limits(access_key)
  if probe["ok"]:
    plan = probe_plan(access_key)
    # A plan lookup that failed keeps the plan last named, rather than
    # blanking a label the account still has.
    plan = cached_plan if plan is None else plan
    result.update(limits=probe["limits"], tierLabel=plan, live=True, fetchedAtMs=int(time.time() * 1000))
    write_json(probe_cache, {"fetchedAtMs": result["fetchedAtMs"], "limits": probe["limits"], "plan": plan})
    return result

  # The first probe after login often fires before DHCP has handed out a
  # route. Ask the shell to try again sooner than its regular interval.
  if probe.get("transport"):
    result["retryAdvised"] = True
  result["authHelpText"] = probe["helpText"]
  if fallback:
    result.update(limits=fallback, tierLabel=cached_plan, fetchedAtMs=fetched_ms)
  if probe.get("auth"):
    result["usageStatusText"] = "Sign-in expired"
  elif not fallback:
    result["usageStatusText"] = "Ollama limits unavailable"
  return result


# -------------------------------------------------------------------- record


def main() -> int:
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true", help="rescan sessions and re-probe limits, ignoring caches")
  parser.add_argument("--limits-only", action="store_true", help="reuse any recent session scan; only the limits probe must be fresh")
  args = parser.parse_args()

  config = read_config()
  model_prefix = str(config.get("modelPrefix") or "").strip().lower()
  scan_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else SCAN_REUSE_SECONDS)
  stats = cached_scan(scan_age, model_prefix)
  has_stats = bool(stats.get("modelUsage"))

  key = api_key()
  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
    "ready": False,
    "hasLocalStats": has_stats,
    "hasPromptStats": True,
    "tierLabel": "",
    "usageStatusText": "",
    "authHelpText": "",
    "limits": [],
    "limitsStale": False,
    "limitsFetchedAt": 0,
  }
  record.update(empty_stats())
  record.update(stats)

  # A machine with neither a key nor any Ollama Cloud sessions doesn't use it,
  # and the panel skips the record; that is no trouble to report.
  if key or has_stats:
    limits = collect_limits(key, args.force)
    record.update(
      ready=True,
      tierLabel=limits["tierLabel"],
      usageStatusText=limits["usageStatusText"],
      authHelpText=limits["authHelpText"],
      limits=limits["limits"],
      limitsStale=bool(limits["limits"]) and not limits["live"],
      limitsFetchedAt=limits["fetchedAtMs"],
    )
    if limits.get("retryAdvised"):
      record["retryAdvised"] = True
  print(json.dumps(record, separators=(",", ":"), sort_keys=True))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
