#!/usr/bin/python3
# omarchy:summary=Print the OpenRouter usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect OpenRouter usage into one display-ready JSON record.

Tier 1 (any API key): balance and key usage come from GET /api/v1/credits
and GET /api/v1/key; token stats come from the local opencode SQLite DB
(providerID == "openrouter", role == "assistant") and from pi/omp session
files whose assistant messages ran on the openrouter provider, read-only.
Each key keeps its own last good meter and balance, shown stale when a
check fails. The key is OPENROUTER_API_KEY, opencode's or pi/omp's saved
OpenRouter login, or the config file's. Without any, the local stats still
show and the record waits for auth.

Tier 2 (management key): when OPENROUTER_MANAGEMENT_KEY (or the management
key in the config file) is set, the last-30-days token history comes from
GET /api/v1/activity instead of the local DB -- account-global numbers that
cover every machine and client, grouped by day and model. The /key response
carries is_management_key, so a key that cannot do this fails visibly as
403 and the collector falls back to tier 1 automatically.

Refs: omacom/omarchy#8270 (pi on OpenRouter invisible in panel),
omacom/omarchy#10330 (dedicated pi collector proposal).
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import math
import os
import sqlite3
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any

AGENT_ID = "openrouter"
AGENT_NAME = "OpenRouter"
AUTH_HELP = "Set OPENROUTER_API_KEY, or sign in to OpenRouter in opencode, pi or omp. For the 30-day history, add a management key as OPENROUTER_MANAGEMENT_KEY (openrouter.ai/settings/management-keys)."
API_BASE = "https://openrouter.ai/api/v1"

# A scan this recent is only reused to dedup concurrent collector runs;
# every periodic refresh lands a real rescan. --limits-only promises only
# fresh balance/limits, so it may reuse the local scan for up to 15 minutes.
SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900

# Opening and shutting the panel must not turn into three API calls per flick,
# so a probe this recent is reused; --force, a person pressing refresh, skips
# it.
PROBE_MIN_INTERVAL_SECONDS = 15

# Token counts beyond this are a corrupt row, not usage.
MAX_TOKENS = 10**12


class OpenRouterError(Exception):
  pass


# Counts from disk and from the API are untrusted: a boolean, a negative, a
# non-finite or an absurdly large value counts as nothing rather than taking
# the record down or inflating it.
def number(value: Any) -> int:
  if isinstance(value, bool):
    return 0
  try:
    parsed = float(value or 0)
  except (TypeError, ValueError, OverflowError):
    return 0
  if not math.isfinite(parsed) or parsed <= 0 or parsed > MAX_TOKENS:
    return 0
  return int(parsed)


# The local day a timestamp names, or "" when it names none: a row with a
# broken timestamp is skipped rather than filed under today or 1970.
def local_day(value) -> str:
  if isinstance(value, bool) or value is None:
    return ""
  try:
    if isinstance(value, (int, float)):
      if not math.isfinite(value) or value <= 0:
        return ""
      seconds = value / 1000 if value > 10_000_000_000 else value
      if seconds > 32_503_680_000:
        return ""
      return datetime.fromtimestamp(seconds).astimezone().strftime("%Y-%m-%d")
    parsed = datetime.fromisoformat(str(value).strip().replace("Z", "+00:00"))
    if parsed.tzinfo is not None:
      parsed = parsed.astimezone()
    return parsed.strftime("%Y-%m-%d")
  except (ValueError, OverflowError, OSError):
    return ""


# A pi or opencode row's day, read as every collector reading those sources
# reads it: a row with no time at all is today's, and an untrusted time is
# "", so the caller skips that row alone.
def source_day(value) -> str:
  return datetime.now().strftime("%Y-%m-%d") if value is None else local_day(value)


# pi, omp, and the harnesses that copy their format spell usage camelCase or
# snake_case; the first spelling present wins.
def usage_tokens(usage: dict, *keys: str) -> int:
  for key in keys:
    if key in usage:
      return number(usage.get(key))
  return 0


def model_name(raw: Any) -> str:
  value = str(raw or "openrouter").rstrip("/").split("/")[-1]
  return value or "openrouter"


def empty_bucket() -> dict[str, int]:
  return {
    "inputTokens": 0,
    "outputTokens": 0,
    "cacheReadInputTokens": 0,
    "cacheCreationInputTokens": 0,
  }


def empty_stats() -> dict[str, Any]:
  # The week is always there, zeroed, so the panel's chart has its seven days
  # even on a machine with nothing spent.
  today = datetime.now()
  return {
    "todayPrompts": 0,
    "todaySessions": 0,
    "todayTotalTokens": 0,
    "todayTokensByModel": {},
    "recentDays": [{"date": (today - timedelta(days=offset)).strftime("%Y-%m-%d"), "messageCount": 0} for offset in range(6, -1, -1)],
    "totalPrompts": 0,
    "totalSessions": 0,
    "activeDays": 0,
    "activeDates": [],
    "modelUsage": {},
  }


# ---------------------------------------------------------------- auth

def config_path() -> Path:
  config_home = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
  return config_home / "omarchy" / "agents" / "openrouter.json"


def read_config() -> dict[str, Any]:
  try:
    parsed = json.loads(config_path().read_text())
    return parsed if isinstance(parsed, dict) else {}
  except (OSError, json.JSONDecodeError):
    return {}

def opencode_auth_path() -> Path:
  data_home = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share"))
  return data_home / "opencode" / "auth.json"


def read_opencode_key(path: Path) -> str:
  try:
    parsed = json.loads(path.read_text())
  except (OSError, json.JSONDecodeError):
    return ""
  entry = parsed.get("openrouter") if isinstance(parsed, dict) else None
  if not isinstance(entry, dict):
    return ""
  return str(entry.get("key") or "").strip()


def pi_agent_dir() -> Path:
  # PI_CODING_AGENT_DIR moves pi's agent dir, as pi itself reads it.
  configured = os.environ.get("PI_CODING_AGENT_DIR", "").strip()
  return Path(os.path.expanduser(configured)) if configured else Path.home() / ".pi" / "agent"


def read_pi_key(path: Path) -> str:
  # pi/omp keep a key they were given with /login in auth.json. Only a literal
  # key is taken: a `$VAR` or `!command` entry is resolved by pi alone.
  key = read_opencode_key(path)
  return "" if key.startswith(("!", "$")) else key


def api_key(config: dict[str, Any]) -> str:
  # Explicit key or an opencode, pi or omp login wins; the config file is
  # the last resort for headless/refresh-timer runs without any.
  return (
    str(os.environ.get("OPENROUTER_API_KEY", "")).strip()
    or read_opencode_key(opencode_auth_path())
    or read_pi_key(pi_agent_dir() / "auth.json")
    or read_pi_key(Path.home() / ".omp" / "agent" / "auth.json")
    or str(config.get("apiKey") or "").strip()
  )


def management_key(config: dict[str, Any]) -> str:
  # A management key unlocks /activity (30-day account history). A normal
  # inference key answers /key + /credits only and fails /activity with
  # 403 -- never send it there speculatively, just skip tier 2.
  return (
    str(os.environ.get("OPENROUTER_MANAGEMENT_KEY", "")).strip()
    or str(config.get("managementKey") or "").strip()
  )


# ---------------------------------------------------------------- API

# No server answered at all (DNS, connection, timeout): the one failure worth
# a sooner retry.
class OpenRouterTransportError(OpenRouterError):
  pass


# The key was refused. 403 from /activity with an inference key is the
# expected tier-1 signal ("Only management keys can perform this operation"),
# not a broken setup -- callers decide what a refusal means.
class OpenRouterAuthError(OpenRouterError):
  def __init__(self, code: int):
    super().__init__(f"OpenRouter refused the key (status {code})")
    self.code = code


def api_get(path: str, key: str) -> dict:
  req = urllib.request.Request(
    API_BASE + path, headers={"Authorization": "Bearer " + key, "Accept": "application/json"}
  )
  try:
    with urllib.request.urlopen(req, timeout=15) as resp:
      payload = json.load(resp)
      return payload if isinstance(payload, dict) else {}
  except urllib.error.HTTPError as error:
    if error.code in (401, 403):
      raise OpenRouterAuthError(error.code)
    raise OpenRouterError(f"OpenRouter's API returned status {error.code}.")
  except urllib.error.URLError as error:
    raise OpenRouterTransportError("Couldn't reach the OpenRouter API. Retrying shortly.") from error
  # A server that stalls on its headers or body times out the read itself,
  # outside URLError; that is a network failure like any other.
  except (TimeoutError, ConnectionError) as error:
    raise OpenRouterTransportError("Couldn't reach the OpenRouter API. Retrying shortly.") from error
  except (json.JSONDecodeError, ValueError) as error:
    raise OpenRouterError("OpenRouter returned an invalid response.") from error


# /activity names its day as a date, sometimes with a time after it. Anything
# that isn't one files under no day rather than a made-up one.
def activity_day(value: Any) -> str:
  text = str(value or "").strip()[:10]
  try:
    return datetime.strptime(text, "%Y-%m-%d").strftime("%Y-%m-%d")
  except ValueError:
    return ""


def summarize_activity(items: list[Any], today: datetime) -> dict[str, Any]:
  """Fold /activity rows into the panel's stats dict.

  One row per (date, endpoint): prompt + reasoning tokens count as input
  (they are generated), completion as output. The billing API reports
  tokens, never prompt or session counts, so hasPromptStats stays False
  and the panel keeps those numbers out of today's tooltip.
  """
  today_date = today.strftime("%Y-%m-%d")
  recent_dates = [(today - timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]
  recent = {day: 0 for day in recent_dates}
  today_by_model: dict[str, int] = {}
  model_usage: dict[str, dict[str, int]] = {}
  active_dates: set[str] = set()

  for raw in items:
    if not isinstance(raw, dict):
      continue
    day = activity_day(raw.get("date"))
    model = model_name(str(raw.get("model_permaslug") or raw.get("model") or ""))
    prompt = number(raw.get("prompt_tokens"))
    reasoning = number(raw.get("reasoning_tokens"))
    output = number(raw.get("completion_tokens"))
    total = prompt + reasoning + output
    if total <= 0:
      continue
    bucket = model_usage.setdefault(model, empty_bucket())
    bucket["inputTokens"] += prompt
    bucket["outputTokens"] += output + reasoning
    if day:
      active_dates.add(day)
    if day in recent:
      recent[day] += total
    if day == today_date:
      today_by_model[model] = today_by_model.get(model, 0) + total

  return {
    "todayTokensByModel": today_by_model,
    "todayTotalTokens": sum(today_by_model.values()),
    "recentDays": [{"date": day, "messageCount": recent[day]} for day in recent_dates],
    "activeDays": len(active_dates),
    "activeDates": sorted(active_dates),
    "modelUsage": model_usage,
  }


def credential_digest(secret: str) -> str:
  return hashlib.sha256(secret.encode("utf-8")).hexdigest()[:16]


def activity_stats(key: str, today: datetime, max_age: float) -> tuple[dict[str, Any] | None, bool]:
  """Tier 2: 30-day account history via management key, or None.

  Returns (stats, transport_failed). Stats are None when there is no
  management key (plain tier-1 run) or the key is refused -- the caller then
  falls back to the local DB scan. The answer is a stats source like the
  local scan, so it is reused on the same schedule; when /activity can't be
  reached, today's last answer stands in for it.
  """
  if not key:
    return None, False
  scan_date = today.strftime("%Y-%m-%d")
  try:
    cache = cache_root() / f"openrouter-activity-{credential_digest(key)}.json"
    cached = read_json(cache) or {}
  except OSError:
    cache, cached = None, {}
  kept = cached.get("stats") if cached.get("scanDate") == scan_date and isinstance(cached.get("stats"), dict) else None
  age = time.time() - epoch_ms(cached.get("fetchedAtMs")) / 1000
  if kept is not None and 0 <= age < max_age:
    return kept, False

  try:
    payload = api_get("/activity", key)
  except OpenRouterAuthError:
    return None, False
  except OpenRouterError as error:
    print(f"omarchy-agent-usage-openrouter: activity lookup failed ({error})", file=sys.stderr)
    return kept, isinstance(error, OpenRouterTransportError)
  items = payload.get("data")
  if not isinstance(items, list):
    return kept, False
  stats = empty_stats()
  stats.update(summarize_activity(items, today))
  if cache is not None:
    try:
      write_json(cache, {"schemaVersion": 1, "scanDate": scan_date, "fetchedAtMs": int(time.time() * 1000), "stats": stats})
    except OSError as exc:
      print(f"omarchy-agent-usage-openrouter: could not write activity cache ({exc})", file=sys.stderr)
  return stats, False


# ---------------------------------------------------------------- local stats (opencode DB)

class LocalScan:
  """Aggregated opencode usage. Module-level in the original prototype;
  an instance keeps the scanner testable without global state."""

  def __init__(self, today: datetime):
    self.today = today.strftime("%Y-%m-%d")
    self.recent_dates = [(today - timedelta(days=o)).strftime("%Y-%m-%d") for o in range(6, -1, -1)]
    self.recent = {day: {"date": day, "messageCount": 0} for day in self.recent_dates}
    self.today_tokens_by_model: dict[str, int] = {}
    self.model_usage: dict[str, dict[str, int]] = {}
    self.today_sessions: set[str] = set()
    self.active_days: set[str] = set()
    self.today_prompts = 0
    self.today_total_tokens = 0
    self.total_prompts = 0
    self.total_sessions: set[str] = set()

  def add_usage(self, day, session_key, model, in_tok, out_tok, cache_read, cache_write):
    total = in_tok + out_tok + cache_read + cache_write
    self.total_prompts += 1
    self.total_sessions.add(session_key)
    self.active_days.add(day)
    bucket = self.model_usage.setdefault(model, empty_bucket())
    bucket["inputTokens"] += in_tok
    bucket["outputTokens"] += out_tok
    bucket["cacheReadInputTokens"] += cache_read
    bucket["cacheCreationInputTokens"] += cache_write
    if day in self.recent:
      self.recent[day]["messageCount"] += total
    if day == self.today:
      self.today_prompts += 1
      self.today_sessions.add(session_key)
      self.today_total_tokens += total
      self.today_tokens_by_model[model] = self.today_tokens_by_model.get(model, 0) + total

  def snapshot(self) -> dict:
    return {
      "todayPrompts": self.today_prompts,
      "todaySessions": len(self.today_sessions),
      "todayTotalTokens": self.today_total_tokens,
      "todayTokensByModel": self.today_tokens_by_model,
      "recentDays": [self.recent[d] for d in self.recent_dates],
      "totalPrompts": self.total_prompts,
      "totalSessions": len(self.total_sessions),
      "activeDays": len(self.active_days),
      "activeDates": sorted(self.active_days),
      "modelUsage": self.model_usage,
    }


def opencode_db_path() -> Path:
  # OPENCODE_DB points opencode at another database, as the CLI itself reads
  # it; a relative name lives beside the default one. Only a build whose
  # channel was literally "v2" wrote opencode-v2.db, so it is a fallback for
  # those installs alone.
  root = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share")) / "opencode"
  configured = os.environ.get("OPENCODE_DB", "").strip()
  if configured:
    path = Path(configured).expanduser()
    return path if path.is_absolute() else root / path
  normal = root / "opencode.db"
  legacy = root / "opencode-v2.db"
  return legacy if not normal.is_file() and legacy.is_file() else normal


def opencode_columns(conn: sqlite3.Connection, table: str) -> set[str]:
  try:
    return {row[1] for row in conn.execute(f"PRAGMA table_info({table})")}
  except sqlite3.Error:
    return set()


def opencode_row(scan: LocalScan, message_id: str, session_id: Any, entry: Any, row_type: str, created: Any, seen: set[str]) -> None:
  # Shared by both message stores. The original `message` table keeps the
  # provider and model at the top level; the V2 `session_message` table nests
  # them under `model` and keeps the role in its `type` column, with a
  # compaction's tokens spent like any reply's.
  if not isinstance(entry, dict):
    return
  if (entry.get("role") or row_type) not in ("assistant", "compaction"):
    return
  model = entry.get("model")
  provider = entry.get("providerID") or (model.get("providerID") if isinstance(model, dict) else "")
  if str(provider or "") != "openrouter":
    return
  tokens = entry.get("tokens") if isinstance(entry.get("tokens"), dict) else {}
  cache = tokens.get("cache") if isinstance(tokens.get("cache"), dict) else {}
  in_tok = number(tokens.get("input"))
  # opencode keeps thinking tokens out of output; both are generated.
  out_tok = number(tokens.get("output")) + number(tokens.get("reasoning"))
  cache_read = number(cache.get("read"))
  cache_write = number(cache.get("write"))
  if not (in_tok or out_tok or cache_read or cache_write):
    return
  # A migrated message can sit in both stores under the same id.
  if message_id in seen:
    return
  seen.add(message_id)
  # The message's own time, else the row's: none at all is today's, and an
  # untrusted one, zero included, skips only this row.
  timing = entry.get("time") if isinstance(entry.get("time"), dict) else {}
  stamp = timing.get("created")
  day = source_day(created if stamp is None else stamp)
  if not day:
    return
  raw_model = entry.get("modelID") or ((model.get("modelID") or model.get("id")) if isinstance(model, dict) else model)
  scan.add_usage(day, "opencode:" + str(session_id), model_name(str(raw_model or "")), in_tok, out_tok, cache_read, cache_write)


def scan_opencode_session_messages(scan: LocalScan, conn: sqlite3.Connection, tables: set[str], seen: set[str]) -> None:
  # The V2 store. The LIKE gate skips rows whose JSON cannot name the
  # provider before any parse.
  columns = opencode_columns(conn, "session_message")
  if not {"id", "session_id", "type", "data"} <= columns:
    return
  created = "m.time_created" if "time_created" in columns else "NULL"
  source = "session_message m"
  fork_filter = ""
  if "time_created" in columns and "session_v2" in tables and {"id", "fork_session_id", "time_created"} <= opencode_columns(conn, "session_v2"):
    # A fork copies its source session's messages under new ids; only what
    # came after the fork was spent in it.
    source += " LEFT JOIN session_v2 s ON s.id = m.session_id"
    fork_filter = " AND (s.fork_session_id IS NULL OR m.time_created >= s.time_created)"
  for message_id, session_id, row_type, time_created, raw in conn.execute(
    f"SELECT m.id, m.session_id, m.type, {created}, m.data FROM {source}"
    " WHERE m.type IN ('assistant', 'compaction')"
    " AND m.data LIKE '%\"providerID\"%:%\"openrouter\"%'" + fork_filter
  ):
    # One row that still fails must not take the scan down with it.
    try:
      opencode_row(scan, str(message_id), session_id, json.loads(raw), str(row_type or ""), time_created, seen)
    except Exception:
      continue


def scan_opencode_messages(scan: LocalScan, conn: sqlite3.Connection, seen: set[str]) -> None:
  # The original store, one row per chat message. The LIKE gates skip rows
  # whose JSON cannot contain the two key/value pairs, avoiding the JSON
  # parse of huge message blobs; json_extract is the authority for the rows
  # that reach Python.
  columns = opencode_columns(conn, "message")
  if not {"session_id", "data"} <= columns:
    return
  message_id = "id" if "id" in columns else "rowid"
  for row_id, session_id, raw in conn.execute(
    f"SELECT {message_id}, session_id, data FROM message"
    " WHERE data LIKE '%\"role\"%:%\"assistant\"%'"
    " AND data LIKE '%\"providerID\"%:%\"openrouter\"%'"
    " AND CASE WHEN json_valid(data) THEN json_extract(data, '$.role') END = 'assistant'"
    " AND CASE WHEN json_valid(data) THEN json_extract(data, '$.providerID') END = 'openrouter'"
  ):
    try:
      opencode_row(scan, str(row_id), session_id, json.loads(raw), "", None, seen)
    except Exception:
      continue


def scan_opencode(scan: LocalScan, db: Path | None = None) -> bool:
  # Returns whether the scan ran to completion: a scan cut short by a
  # database error still contributes what it read, but must not be cached
  # as if it were the whole story.
  db = db or opencode_db_path()
  if not db.is_file():
    return True
  try:
    conn = sqlite3.connect(db.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
  except sqlite3.Error:
    return False
  try:
    conn.execute("PRAGMA query_only = ON")
    tables = {name for (name,) in conn.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
    # Both stores, V2 first, deduplicated by message id: a build that
    # migrated keeps reading, and a message in both counts once.
    seen: set[str] = set()
    if "session_message" in tables:
      scan_opencode_session_messages(scan, conn, tables, seen)
    if "message" in tables:
      scan_opencode_messages(scan, conn, seen)
  except sqlite3.Error:
    return False
  finally:
    conn.close()
  return True


def cache_root() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


# pi's and omp's session trees, each profile's too: `--profile=<name>` moves
# the whole agent tree under <base>/profiles/<name>/. pi moves its agent tree
# with PI_CODING_AGENT_DIR and its sessions alone with
# PI_CODING_AGENT_SESSION_DIR, both expanding a leading ~; either is read as
# well as the default trees, which keep whatever was written before the move.
def pi_session_roots() -> list[Path]:
  roots: list[Path] = []
  for base in (Path.home() / ".pi", Path.home() / ".omp"):
    roots.append(base / "agent" / "sessions")
    try:
      # Sorted so the scan order does not depend on directory order.
      roots.extend(sorted(child / "agent" / "sessions" for child in (base / "profiles").iterdir() if child.is_dir()))
    except OSError:
      # No profiles directory, or it is unreadable: the default root stands.
      pass
  if os.environ.get("PI_CODING_AGENT_DIR", "").strip():
    roots.append(Path(os.environ["PI_CODING_AGENT_DIR"].strip()).expanduser() / "sessions")
  if os.environ.get("PI_CODING_AGENT_SESSION_DIR", "").strip():
    roots.append(Path(os.environ["PI_CODING_AGENT_SESSION_DIR"].strip()).expanduser())
  # Canonical roots, so an override that aliases a default root through a
  # symlink is scanned under one spelling. A root inside another is already
  # read with it, so it is dropped rather than counted twice.
  canonical = list(dict.fromkeys(root.resolve() for root in roots))
  return [root for root in canonical if not any(other != root and root.is_relative_to(other) for other in canonical)]


def scan_pi(scan: LocalScan, roots: list[Path] | None = None) -> bool:
  # Returns whether every session file could be read, like scan_opencode.
  roots = [root for root in (roots if roots is not None else pi_session_roots()) if root.is_dir()]
  if not roots:
    return True
  # --no-ignore: a $HOME that is a git checkout would otherwise hide the
  # session dirs behind its .gitignore. Sorted, so which copy of a forked
  # message counts, and so its session, doesn't change from run to run.
  try:
    proc = subprocess.run(
      ["rg", "--json", "--no-ignore", "--hidden", "--sort", "path", "--glob", "*.jsonl", "-e", r'"provider"\s*:\s*"openrouter"', *map(str, roots)],
      capture_output=True, text=True, errors="replace", timeout=60,
    )
  except (OSError, subprocess.SubprocessError):
    return False

  seen: set[tuple[str, str]] = set()
  for raw in proc.stdout.splitlines():
    try:
      event = json.loads(raw)
      if event.get("type") != "match":
        continue
      data = event.get("data") or {}
      path = str((data.get("path") or {}).get("text") or "")
      entry = json.loads((data.get("lines") or {}).get("text") or "")
      if not isinstance(entry, dict) or entry.get("type") != "message":
        continue
      message = entry.get("message")
      if not isinstance(message, dict) or message.get("role") != "assistant":
        continue
      if str(message.get("provider") or "") != "openrouter":
        continue
      # A forked session repeats its parent's messages with their ids and
      # timestamps, so the pair names a message across files; an id alone
      # only within its file. A line without an id always counts.
      entry_id, stamp = entry.get("id"), entry.get("timestamp")
      if entry_id:
        identity = (str(entry_id), str(stamp)) if stamp else (path, str(entry_id))
        if identity in seen:
          continue
        seen.add(identity)
      usage = message.get("usage") if isinstance(message.get("usage"), dict) else {}
      in_tok = usage_tokens(usage, "input", "inputTokens", "input_tokens")
      # pi folds thinking into its own field; both are generated.
      out_tok = usage_tokens(usage, "output", "outputTokens", "output_tokens") + usage_tokens(usage, "reasoning", "reasoningTokens", "reasoning_tokens")
      cache_read = usage_tokens(usage, "cacheRead", "cacheReadTokens", "cache_read", "cache_read_input_tokens")
      cache_write = usage_tokens(usage, "cacheWrite", "cacheWriteTokens", "cache_write", "cache_creation_input_tokens")
      if not (in_tok or out_tok or cache_read or cache_write):
        # Some writers keep only the total; it was still spent.
        in_tok = usage_tokens(usage, "totalTokens", "total_tokens")
      if not (in_tok or out_tok or cache_read or cache_write):
        continue
      # The first time present decides: none at all is today's, and an
      # untrusted one, zero included, skips only this line.
      day = source_day(stamp if stamp is not None else message.get("timestamp"))
      if not day:
        continue
      model = model_name(str(message.get("model") or ""))
    except Exception:
      continue
    scan.add_usage(day, "pi:" + path, model, in_tok, out_tok, cache_read, cache_write)
  # rg exits 1 for no matches and 2 when something couldn't be read.
  return proc.returncode in (0, 1)


def scan_local(scan: LocalScan) -> bool:
  # Both sources always run, so one failing still leaves the other's numbers.
  opencode_complete = scan_opencode(scan)
  pi_complete = scan_pi(scan)
  return opencode_complete and pi_complete


def scan_cache_paths() -> tuple[Path, Path]:
  sources = [opencode_db_path(), *pi_session_roots()]
  digest = hashlib.sha1("\n".join(map(str, sources)).encode("utf-8")).hexdigest()[:16]
  root = cache_root()
  return root / f"openrouter-scan-{digest}.json", root / f"openrouter-scan-{digest}.lock"


def read_json(path: Path) -> dict | None:
  try:
    parsed = json.loads(path.read_text(encoding="utf-8"))
  except Exception:
    return None
  return parsed if isinstance(parsed, dict) else None


def read_fresh_json(path: Path, max_age_seconds: float) -> dict | None:
  if max_age_seconds <= 0 or not path.exists():
    return None
  try:
    # A negative age means the mtime is in the future: the clock moved
    # backwards since the write, so the cache's freshness cannot be trusted.
    age = time.time() - path.stat().st_mtime
    if 0 <= age < max_age_seconds:
      return read_json(path)
  except Exception:
    return None
  return None


def write_json(path: Path, payload: dict) -> None:
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, separators=(",", ":")) + "\n")
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


def cached_local_stats(today: datetime, max_age: float) -> tuple[dict, bool]:
  """Local stats with the cache as a pure optimization.

  Any cache-layer failure degrades to a direct scan and a warning on
  stderr. The JSON record is the contract; the cache is not.
  """
  scan = LocalScan(today)

  def usable(cached: dict | None) -> dict | None:
    if (
      isinstance(cached, dict)
      and cached.get("schemaVersion") == 1
      and cached.get("scanDate") == scan.today
      and isinstance(cached.get("stats"), dict)
    ):
      return cached["stats"]
    return None

  try:
    cache_file, lock_file = scan_cache_paths()
    stats = usable(read_fresh_json(cache_file, max_age))
    if stats is not None:
      return stats, True
    # Concurrent runs (the update command and the panel's own refresh) wait
    # for one scan instead of each reading the whole database.
    with lock_file.open("w") as lock:
      fcntl.flock(lock, fcntl.LOCK_EX)
      stats = usable(read_fresh_json(cache_file, max_age))
      if stats is not None:
        return stats, True
      complete = scan_local(scan)
      stats = scan.snapshot()
      if complete:
        try:
          write_json(cache_file, {"schemaVersion": 1, "scanDate": scan.today, "stats": stats})
        except Exception as exc:
          print(f"omarchy-agent-usage-openrouter: could not write usage cache ({exc})", file=sys.stderr)
      return stats, complete
  except Exception as exc:
    print(f"omarchy-agent-usage-openrouter: cache unavailable ({exc}); scanning directly", file=sys.stderr)
    complete = scan_local(scan)
    return scan.snapshot(), complete


# ---------------------------------------------------------------- record

def base_record(**overrides: Any) -> dict:
  record: dict[str, Any] = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "ready": False,
    "hasLocalStats": False,
    "hasPromptStats": True,
    "tierLabel": "",
    "usageStatusText": "",
    "authHelpText": "",
    "limits": [],
    "limitsStale": False,
    "limitsFetchedAt": 0,
  }
  record.update(empty_stats())
  record.update(overrides)
  return record


# A key with a credit limit drains toward empty. limit_reset names how often
# the limit starts over (daily, weekly, monthly), not when, so it labels the
# meter rather than giving it a reset time.
KEY_LIMIT_PERIODS = {"daily": "Daily", "weekly": "Weekly", "monthly": "Monthly"}


def key_limit_meter(key_info: dict) -> list[dict]:
  try:
    limit = key_info.get("limit")
    remaining = key_info.get("limit_remaining")
    if limit is None or remaining is None or isinstance(limit, bool) or isinstance(remaining, bool):
      return []
    lim = float(limit)
    rem = max(0.0, float(remaining))
  except (TypeError, ValueError):
    return []
  if not (math.isfinite(lim) and math.isfinite(rem)) or lim <= 0:
    return []
  period = KEY_LIMIT_PERIODS.get(str(key_info.get("limit_reset") or "").strip().lower())
  label = f"{period} key limit" if period else "Key limit"
  return [{"label": label, "title": label, "percent": min(1.0, (lim - min(rem, lim)) / lim), "resetsAt": ""}]


def dollars(value: Any) -> float | None:
  if isinstance(value, bool):
    return None
  try:
    parsed = float(value or 0)
  except (TypeError, ValueError):
    return None
  return parsed if math.isfinite(parsed) else None


# Balance: total purchased minus total used, or None for an account that never
# bought credits. An answer missing either total says nothing about the
# balance, so it is a failed check that keeps the last good one, not an empty
# balance that would replace it.
def credits_balance(credits: dict) -> dict | None:
  total_credits = dollars(credits.get("total_credits")) if credits.get("total_credits") is not None else None
  total_usage = dollars(credits.get("total_usage")) if credits.get("total_usage") is not None else None
  if total_credits is None or total_usage is None:
    raise OpenRouterError("OpenRouter answered /credits without a balance.")
  if total_credits <= 0:
    return None
  return {
    "remaining": round(max(0.0, total_credits - total_usage), 6),
    "funded": round(total_credits, 6),
    "spent": round(max(0.0, total_usage), 6),
    "currency": "USD",
    "estimated": False,
  }


def epoch_ms(value: Any) -> int:
  if isinstance(value, bool):
    return 0
  try:
    parsed = float(value or 0)
  except (TypeError, ValueError):
    return 0
  return int(parsed) if math.isfinite(parsed) and parsed > 0 else 0


# A kept window whose reset has passed is an untouched allowance, not an
# unknown one. The key meter only ever names a period, so this is a guard for
# a cache written by a meter that carries a reset time.
def limit_window_open(entry: dict, now: datetime) -> bool:
  raw = str(entry.get("resetsAt") or "")
  if raw == "":
    return True
  try:
    resets_at = datetime.fromisoformat(raw.replace("Z", "+00:00"))
  except ValueError:
    return True
  if resets_at.tzinfo is None:
    resets_at = resets_at.replace(tzinfo=timezone.utc)
  return resets_at > now


def usable_cached_limits(cached: dict) -> list[dict]:
  entries = cached.get("limits")
  if not isinstance(entries, list):
    return []
  now = datetime.now(timezone.utc)
  return [
    entry if limit_window_open(entry, now) else dict(entry, percent=0.0, resetsAt="")
    for entry in entries if isinstance(entry, dict)
  ]


# Each credential keeps its own last good answer, so another key never shows
# this one's numbers. Refreshes can overlap (the panel's own and a sooner
# retry), so an answer only replaces one fetched before it.
def probe_cache(kind: str, secret: str) -> Path:
  return cache_root() / f"openrouter-{kind}-{credential_digest(secret)}.json"


def remember(path: Path, part: dict) -> None:
  current = read_json(path) or {}
  if epoch_ms(current.get("fetchedAtMs")) <= part["fetchedAtMs"]:
    write_json(path, part)


def probe(endpoint: str, key: str, cache: Path, parse, force: bool) -> tuple[dict | None, OpenRouterError | None]:
  """One endpoint's answer as (part, error).

  A probe this recent is reused, a fresh answer replaces the cached one, and
  a failed one falls back on it. part is None when nothing was ever fetched.
  """
  cached = read_json(cache) or {}
  fetched_at = epoch_ms(cached.get("fetchedAtMs"))
  kept = dict(cached, fetchedAtMs=fetched_at) if fetched_at else None
  age = time.time() - fetched_at / 1000
  if kept is not None and not force and 0 <= age < PROBE_MIN_INTERVAL_SECONDS:
    return kept, None
  try:
    payload = api_get(endpoint, key)
    data = payload.get("data")
    # Floored, never rounded: a stamp half a millisecond ahead reads as a
    # clock that went back and fails the 0 <= age guard on the very next run.
    part = dict(parse(data if isinstance(data, dict) else {}), fetchedAtMs=int(time.time() * 1000))
  except OpenRouterError as error:
    return kept, error
  try:
    remember(cache, part)
  except OSError as exc:
    print(f"omarchy-agent-usage-openrouter: could not write {cache.name} ({exc})", file=sys.stderr)
  return part, None


def collect_billing(key: str, manager: str, force: bool) -> dict[str, Any]:
  """The key-limit meter and the balance, each kept past a failed check.

  The meter describes an inference key's own credit limit, so with only a
  management key there is none to show; the balance is the account's and
  either key can read it.
  """
  result: dict[str, Any] = {
    "limits": [], "limitsStale": False, "limitsFetchedAt": 0,
    "usageStatusText": "", "authHelpText": "", "balance": None, "retryAdvised": False,
  }
  parts: dict[str, dict | None] = {}
  errors: dict[str, OpenRouterError] = {}
  if key:
    parts["key"], error = probe("/key", key, probe_cache("limits", key), lambda data: {"limits": key_limit_meter(data)}, force)
    if error:
      errors["key"] = error
  credits_key = key or manager
  parts["credits"], error = probe("/credits", credits_key, probe_cache("credits", credits_key), lambda data: {"balance": credits_balance(data)}, force)
  if error:
    errors["credits"] = error

  meter = parts.get("key")
  if meter is not None:
    result["limits"] = usable_cached_limits(meter)
  credits = parts.get("credits")
  if credits is not None and isinstance(credits.get("balance"), dict):
    result["balance"] = credits["balance"]
  kept = [part for part in parts.values() if part is not None]
  if kept:
    result["limitsFetchedAt"] = min(part["fetchedAtMs"] for part in kept)
  # Anything that didn't come back fresh marks the record stale, kept or not;
  # the panel shows the kept numbers' age on hover.
  result["limitsStale"] = bool(errors)
  result["retryAdvised"] = any(isinstance(error, OpenRouterTransportError) for error in errors.values())

  refused = [error for error in errors.values() if isinstance(error, OpenRouterAuthError)]
  if refused:
    result["usageStatusText"] = "Sign-in expired"
    result["authHelpText"] = "OpenRouter refused the API key. " + AUTH_HELP
  elif "key" in errors and meter is None:
    result["usageStatusText"] = "OpenRouter limits unavailable"
    result["authHelpText"] = str(errors["key"])
  elif "credits" in errors and credits is None:
    result["usageStatusText"] = "Balance unavailable"
    result["authHelpText"] = str(errors["credits"])
  elif errors:
    result["authHelpText"] = str(next(iter(errors.values())))
  return result


def scan(args: Any) -> dict[str, Any]:
  config = read_config()
  key = api_key(config)
  manager = management_key(config)
  today = datetime.now().astimezone()
  max_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else SCAN_REUSE_SECONDS)

  if not key and not manager:
    # No key anywhere: there is no balance or meter to read, but what pi,
    # omp and opencode spent through OpenRouter here is still OpenRouter's
    # usage, and no other collector counts it. With none, OpenRouter isn't
    # used here and the panel skips it.
    stats, complete = cached_local_stats(today, max_age)
    if number(stats.get("totalPrompts")) <= 0 and not stats.get("modelUsage"):
      return base_record()
    record = base_record(ready=True, hasLocalStats=complete, usageStatusText="Waiting for auth", authHelpText=AUTH_HELP)
    record.update(stats)
    return record

  # Tier 2 first: with a management key the 30-day account history covers
  # every machine and client. Without one (or a refused one) fall back to
  # the local opencode and pi scan below.
  managed, activity_unreachable = activity_stats(manager, today, max_age)
  if managed is not None:
    stats = dict(managed)
    complete = True
    has_prompt_stats = False
    # Tier-2 numbers are account-global (billing API), like Fireworks: every
    # synced device reports the same truth, so aggregation must merge them by
    # widest value, not sum them. Tier 1 is machine-local instead.
    stats["scope"] = "account"
  else:
    stats, complete = cached_local_stats(today, max_age)
    has_prompt_stats = True
  has_data = number(stats.get("totalPrompts")) > 0 or bool(stats.get("modelUsage"))

  billing = collect_billing(key, manager, args.force)

  record = base_record(
    ready=True,
    tierLabel="Prepaid",
    hasLocalStats=complete,
    hasPromptStats=has_prompt_stats,
    limits=billing["limits"],
    limitsStale=billing["limitsStale"],
    limitsFetchedAt=billing["limitsFetchedAt"],
    usageStatusText=billing["usageStatusText"],
    authHelpText=billing["authHelpText"],
  )
  # Usually the seconds after login before the network is up; the panel
  # tries once more soon instead of waiting out its refresh interval.
  if billing["retryAdvised"] or activity_unreachable:
    record["retryAdvised"] = True
  record.update(stats)
  if billing["balance"]:
    record["balance"] = billing["balance"]
  # A key nothing has been spent through, with no credits bought and no limit
  # set, has nothing to show: the machine doesn't use OpenRouter yet.
  if not has_data and not billing["balance"] and not record["limits"] and not record["usageStatusText"] and not record["limitsStale"]:
    record["ready"] = False
    record["tierLabel"] = ""
  return record


def main() -> int:
  ap = argparse.ArgumentParser(description="Print the OpenRouter usage record as JSON")
  # --force rescans and re-probes everything; --limits-only reuses a recent
  # local scan or activity history for up to 15 minutes, while the key meter
  # and balance are probed like a normal run.
  ap.add_argument("--force", action="store_true", help="rescan sessions and re-probe the API, ignoring caches")
  ap.add_argument("--limits-only", action="store_true", help="reuse any recent session scan; only the limits probe must be fresh")
  args = ap.parse_args()
  try:
    record = scan(args)
  except Exception as error:
    record = base_record(usageStatusText="OpenRouter unavailable", authHelpText="OpenRouter usage scan failed")
    print(f"omarchy-agent-usage-openrouter: {type(error).__name__}", file=sys.stderr)
  print(json.dumps(record, separators=(",", ":")))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
