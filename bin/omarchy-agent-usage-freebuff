#!/usr/bin/python3
# omarchy:summary=Print the Freebuff usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Freebuff usage into one display-ready JSON record.

Freebuff keeps chats under ~/.config/manicode/projects/<project>/chats/<UTC
timestamp>/ (FREEBUFF_CONFIG_DIR moves the whole directory), each with a
chat-messages.json array of user prompts and AI replies. Prompts, sessions,
and active days are exact counts, dated from the epoch milliseconds embedded
in every message id (user-1790830285538). The files record no token usage,
which Freebuff meters on its servers, so the record's token fields stay at
zero rather than guessing from message text. Freebuff exposes no limits to
read. The agents panel only ever reads the JSON this prints.
"""

import argparse
import fcntl
import hashlib
import json
import os
import re
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

AGENT_ID = "freebuff"
AGENT_NAME = "Freebuff"

# A scan this recent is only reused to dedup concurrent collector runs (the
# update command backgrounds one per agent while the panel refreshes on its
# own); every periodic widget refresh lands a real rescan, however low
# refreshIntervalSec is set. --limits-only promises only fresh limits, so it
# may reuse a scan for up to 15 minutes. Freebuff exposes no limits endpoint,
# so both windows exist purely to keep the rescan cost down.
SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900

# Version 2 entries hold prompt counts per day; version 1 held the character
# counts the token estimate came from.
CACHE_SCHEMA_VERSION = 2

# Message ids look like user-1790830285538 / ai-1790830285726-8f3c26a13464e:
# the number after the variant is the creation time in epoch milliseconds
# (10-digit values would be seconds; accept both).
MESSAGE_ID_TS = re.compile(r"^user-(\d{10,13})(?:\D|$)")
MIN_EPOCH_SECONDS = 946_684_800  # 2000-01-01

now = datetime.now()
today = now.strftime("%Y-%m-%d")
recent_dates = [(now - timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]


def manicode_dir():
  # Freebuff's own override, which it requires to be absolute.
  configured = os.environ.get("FREEBUFF_CONFIG_DIR")
  if configured:
    path = Path(configured).expanduser()
    if path.is_absolute():
      return path
    print("omarchy-agent-usage-freebuff: ignoring relative config directory", file=sys.stderr)
  return Path.home() / ".config" / "manicode"


def local_day_from_epoch(value):
  """The local day for an epoch in seconds or milliseconds, or None for a
  time that can't be a real moment of use."""
  seconds = value / 1000.0 if value > 10_000_000_000 else float(value)
  # A day of slack past now covers a clock a little behind the writer's.
  if seconds < MIN_EPOCH_SECONDS or seconds > time.time() + 86_400:
    return None
  return datetime.fromtimestamp(seconds).strftime("%Y-%m-%d")


def message_day(message):
  match = MESSAGE_ID_TS.match(str(message.get("id") or ""))
  return local_day_from_epoch(int(match.group(1))) if match else None


def is_prompt(message):
  """A user message that says something; Freebuff stores prompts as plain
  strings."""
  if message.get("variant") != "user":
    return False
  content = message.get("content")
  return isinstance(content, str) and bool(content.strip())


def chat_fallback_day(path):
  """Day for prompts whose id carries no usable time: the file's last write."""
  try:
    return local_day_from_epoch(path.stat().st_mtime) or today
  except OSError:
    return today


def scan_chat_file(path):
  """Return ({day: prompts}, complete) for one chat.

  A malformed, unreadable, or concurrently modified file is omitted from this
  run and marks the scan incomplete, so a partial snapshot never enters cache.
  """
  try:
    before = path.stat()
    raw = path.read_text(encoding="utf-8")
    after = path.stat()
  except (OSError, UnicodeError):
    return {}, False

  if before.st_size != after.st_size or before.st_mtime_ns != after.st_mtime_ns:
    return {}, False

  try:
    data = json.loads(raw)
  except (json.JSONDecodeError, UnicodeError):
    return {}, False
  if not isinstance(data, list):
    return {}, False

  fallback_day = chat_fallback_day(path)
  per_day = {}
  for message in data:
    if not isinstance(message, dict) or not is_prompt(message):
      continue
    day = message_day(message) or fallback_day
    per_day[day] = per_day.get(day, 0) + 1
  return per_day, True


def chat_roots():
  root = manicode_dir() / "projects"
  if not root.is_dir():
    return []
  try:
    return sorted(root.glob("*/chats/*/chat-messages.json"))
  except OSError:
    return []


def cache_root():
  root = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def cache_paths():
  digest = hashlib.sha1((str(Path.home()) + "\n" + str(manicode_dir())).encode("utf-8")).hexdigest()[:16]
  root = cache_root()
  return root / f"freebuff-scan-{digest}.json", root / f"freebuff-scan-{digest}.lock"


def read_cache(path):
  try:
    cached = json.loads(path.read_text(encoding="utf-8"))
  except Exception:
    return None
  if isinstance(cached, dict) and cached.get("schemaVersion") == CACHE_SCHEMA_VERSION and isinstance(cached.get("files"), dict):
    return cached
  return None


def read_fresh_cache(path, max_age_seconds):
  if max_age_seconds <= 0:
    return None
  try:
    # A negative age means the mtime is in the future: the clock moved
    # backwards since the write, so the cache's freshness cannot be trusted.
    age = time.time() - path.stat().st_mtime
  except OSError:
    return None
  if not 0 <= age < max_age_seconds:
    return None
  cached = read_cache(path)
  # today* fields only mean "today" on the day they were scanned.
  if cached is None or cached.get("scanDate") != today:
    return None
  return cached["files"]


def write_cache(path, entries):
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      payload = {
        "schemaVersion": CACHE_SCHEMA_VERSION,
        "scanDate": today,
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "files": entries,
      }
      handle.write(json.dumps(payload, separators=(",", ":")) + "\n")
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


def collect_entries(max_age):
  """Per-chat usage entries, reusing unchanged files across scans.

  Each entry is {"mtime": float, "size": int, "perDay": {day: prompts}}
  keyed by the chat-messages.json path. A file whose stat still matches its
  entry is reused as-is; only new or rewritten chats are re-read, so the
  mid-session chat that Freebuff rewrites on every message is the only
  recurring parse cost.
  """
  cache_file, lock_file = cache_paths()

  with lock_file.open("w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    fresh = read_fresh_cache(cache_file, max_age)
    if fresh is not None:
      return fresh

    old_entries = (read_cache(cache_file) or {}).get("files") or {}

    entries = {}
    complete = True
    for path in chat_roots():
      key = str(path)
      try:
        stat = path.stat()
      except OSError:
        complete = False
        continue
      old = old_entries.get(key)
      if isinstance(old, dict) and old.get("size") == stat.st_size and old.get("mtime") == stat.st_mtime:
        entries[key] = old
        continue
      per_day, file_complete = scan_chat_file(path)
      complete = complete and file_complete
      if per_day:
        entries[key] = {"mtime": stat.st_mtime, "size": stat.st_size, "perDay": per_day}

    if complete:
      try:
        write_cache(cache_file, entries)
      except Exception as exc:
        print(f"omarchy-agent-usage-freebuff: could not write usage cache ({exc})", file=sys.stderr)
    else:
      # The old snapshot predates this incomplete observation and can be
      # reused by --limits-only; discard it so the next request must rescan.
      try:
        cache_file.unlink(missing_ok=True)
      except OSError as exc:
        print(f"omarchy-agent-usage-freebuff: could not invalidate usage cache ({exc})", file=sys.stderr)
      print("omarchy-agent-usage-freebuff: incomplete scan; not caching partial usage", file=sys.stderr)
    return entries


def signed_in():
  """Whether Freebuff holds a sign-in here: a token in credentials.json, or
  the profile Freebuff leaves there after moving the token to the keychain."""
  try:
    data = json.loads((manicode_dir() / "credentials.json").read_text(encoding="utf-8"))
  except (OSError, UnicodeError, ValueError):
    return False
  profile = data.get("default") if isinstance(data, dict) else None
  if not isinstance(profile, dict):
    return False
  token = profile.get("authToken")
  return (isinstance(token, str) and bool(token.strip())) or profile.get("tokenStore") == "keychain"


def build_record(entries):
  total_prompts = 0
  total_sessions = set()
  active_days = set()
  today_prompts = 0
  today_sessions = set()

  for key, entry in entries.items():
    per_day = entry.get("perDay") if isinstance(entry, dict) else None
    if not isinstance(per_day, dict):
      continue
    for day, prompts in per_day.items():
      if isinstance(prompts, bool) or not isinstance(prompts, int) or prompts <= 0:
        continue
      total_prompts += prompts
      total_sessions.add(key)
      active_days.add(day)
      if day == today:
        today_prompts += prompts
        today_sessions.add(key)

  # Freebuff has no limits, so a missing sign-in is nothing to fix here: the
  # status stays empty, and a machine with neither chats nor a sign-in prints
  # a record the panel skips. Freebuff has a paid tier too, and nothing on
  # disk says which one this is, so the plan stays unnamed.
  return {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "ready": total_prompts > 0 or signed_in(),
    "hasLocalStats": True,
    "hasPromptStats": True,
    "tierLabel": "",
    "usageStatusText": "",
    "authHelpText": "",
    "limits": [],
    "limitsStale": False,
    "limitsFetchedAt": 0,
    "todayPrompts": today_prompts,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": 0,
    "todayTokensByModel": {},
    "recentDays": [{"date": day, "messageCount": 0} for day in recent_dates],
    "totalPrompts": total_prompts,
    "totalSessions": len(total_sessions),
    # The dates travel too: merging snapshots from several machines needs
    # their union, which a count alone cannot give.
    "activeDays": len(active_days),
    "activeDates": sorted(active_days),
    "modelUsage": {},
  }


def main():
  parser = argparse.ArgumentParser(description="Print the Freebuff usage record as JSON")
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  args = parser.parse_args()

  max_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else SCAN_REUSE_SECONDS)
  try:
    entries = collect_entries(max_age)
  except Exception as exc:
    print(f"omarchy-agent-usage-freebuff: scan unavailable ({exc})", file=sys.stderr)
    entries = {}
  print(json.dumps(build_record(entries), separators=(",", ":")))


if __name__ == "__main__":
  main()
